#!/bin/sh
# Claude Code puts this folder on the Bash tool's PATH while the plugin is enabled,
# and the plugin's hooks call this file by its full path.
#
# The package lives at the repository's root, in src/asdlc, outside this plugin's
# folder. There are two ways to reach it:
#
# - In a checkout of the repository the root is three folders up, so the working
#   tree's code runs.
# - An installed plugin is a copy of this folder alone, so uv fetches the command
#   from the repository at `ref` and keeps it in its own cache.
#
# `ref` is a branch, so from an installed copy uv asks the network on every call.
# That is acceptable only while version 2 is unreleased. A full commit in its
# place runs from uv's cache with no network.
ref="main"

root="$(cd "$(dirname "$0")/../../.." 2>/dev/null && pwd)"
if [ -f "$root/pyproject.toml" ] && [ -d "$root/src/asdlc" ]; then
    exec uv run --quiet --project "$root" asdlc "$@"
fi
exec uv tool run --quiet --from "git+https://github.com/bruk-io/asdlc@$ref" asdlc "$@"
