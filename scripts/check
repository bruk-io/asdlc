#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.15"
# ///
"""The single check command: every artefact check, the tests, then the eval cases' reference and null runs.

Exits non-zero when anything fails, so it works the same by hand, in a hook and in CI.
"""

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def _run(label: str, command: list[str]) -> bool:
    print(f"== {label}", flush=True)
    passed = subprocess.run(command, cwd=ROOT).returncode == 0
    print(f"== {label}: {'passed' if passed else 'FAILED'}\n", flush=True)
    return passed


def _gate_reminder() -> None:
    """One line when the eval gate has no passing evidence for the steering paths on disk. Never changes the exit code:
    a real run spends tokens, so a person decides when to pay for one."""
    verifier = ROOT / "scripts" / "gate_evidence.py"
    if not verifier.is_file():
        return
    done = subprocess.run([sys.executable, str(verifier), "verify"], cwd=ROOT, capture_output=True, text=True)
    if done.returncode == 1:
        print(f"== reminder: {done.stdout.strip()}. Run `scripts/eval gate` before this change merges; it spends tokens, so it is not part of this check.\n", flush=True)


def main() -> int:
    results = [
        _run("artefacts", [sys.executable, str(ROOT / "scripts" / "artefacts.py")]),
        _run("conformance", [sys.executable, str(ROOT / "scripts" / "conformance.py"), str(ROOT)]),
        _run("tests", [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-t", "."]),
        _run("evals", [sys.executable, str(ROOT / "scripts" / "eval"), "validate"]),
    ]
    _gate_reminder()
    return 0 if all(results) else 1


if __name__ == "__main__":
    raise SystemExit(main())
