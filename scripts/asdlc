#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.15"
# ///
"""A shared Backlog.md board for a team of agents: claims, worktrees and routing.

The board lives in its own repository, a clone of it sits on each machine, and every
change goes straight to the board's `main` with every git hook off. A claim is a commit
that sets a task In Progress with one assignee; git accepts only one of two racing
pushes, so the loser learns from `origin/main` that someone else won and backs out.
Each claimed task gets its own worktree in the code repository registered for the task's
project on this machine.

Usage:
  asdlc [--board <path>] init-board <dir>
  asdlc [--board <path>] board <backlog arguments...>
  asdlc [--board <path>] whoami [--json]
  asdlc [--board <path>] register [--board <path>]          (in a clone of a code repository)
  asdlc repos [--json]
  asdlc [--board <path>] claim <id> --as <worker> [--json]
  asdlc [--board <path>] next --as <worker> [--json]
  asdlc [--board <path>] release <id> --as <worker>
  asdlc [--board <path>] route <id>
  asdlc [--board <path>] accept <intent-id> [--json]         (a person's command)
  asdlc [--board <path>] approve <id>...                     (a person's command)
  asdlc [--board <path>] mine --as <engineer> [--json]
  asdlc [--board <path>] record-check <id> --as <worker> -- <command...>   (in the task's worktree)
  asdlc [--board <path>] finish <id> --as <worker> [--branch <b>] [--pr <url>] --notes <text> [--json]
  asdlc [--board <path>] review-next --as <reviewer> [--fallback] [--json]
  asdlc [--board <path>] review-done <id> --as <reviewer> --verdict clean|changes --findings important=<n>,nit=<n>
        [--policy <name>]... --plan-matched yes|no --notes <text> [--json]
  asdlc [--board <path>] intent-started <draft-id> [--at <time>]
  asdlc [--board <path>] doctor [--json]
  asdlc [--board <path>] permissions [--write] [--json]      (--write is a person's command)
  asdlc [--board <path>] stats [--since <date>] [--stage <stage>] [--json]

The board is `--board`, else $ASDLC_BOARD, else `git config asdlc.board`, else the board
clone the current directory is in. The engineer is `git config asdlc.engineer`; a worker
is the engineer's name, a dot and a label, such as kyle.w1; a reviewer's label is r and a
number, such as kyle.r1. The backlog CLI is
$ASDLC_BACKLOG, else `backlog` on PATH; `stats` asks $ASDLC_GH, else `gh` on PATH, for merge times
(an empty ASDLC_GH asks nothing). `claim`, `next` and `review-next` append
each attempt to ${XDG_STATE_HOME:-~/.local/state}/asdlc/events.jsonl, which `stats` reads.
"""

import argparse
import fcntl
import hashlib
import json
import math
import os
import random
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import tomllib
from collections import Counter
from collections.abc import Callable, Iterable, Iterator, Mapping, Sequence
from contextlib import contextmanager
from dataclasses import asdict, dataclass, fields as dataclass_fields, replace
from datetime import UTC, datetime, timedelta
from enum import StrEnum
from pathlib import Path
from typing import assert_never

from repo_slug import github_repo, origin_url, slug_of

MIN_BACKLOG = (1, 55, 1)  # 1.54 drops frontmatter keys it doesn't know on every edit
BOARD_BRANCH = "main"
TO_DO, IN_PROGRESS, IN_REVIEW, DONE = "To Do", "In Progress", "In Review", "Done"
STATUSES = (TO_DO, IN_PROGRESS, IN_REVIEW, DONE)
TYPES = ("intent", "task", "bug", "spike")
SIZE_LABELS = ("size-1", "size-2", "size-3", "size-4", "size-5", "size-8")
CHANGES_REQUESTED = "changes-requested"
REVIEW_PASSED = "review-passed"
BOARD_SETTINGS = frozendict({
    "statuses": list(STATUSES),
    "default_status": TO_DO,
    "types": list(TYPES),
    "labels": [*SIZE_LABELS, CHANGES_REQUESTED, REVIEW_PASSED],
    "auto_commit": True,
    "bypass_git_hooks": True,
    "remote_operations": True,
    "check_active_branches": False,
})
PUSH_ATTEMPTS = 5
LOCK_WAIT_SECONDS = 45
MARKER = ".asdlc-task"
PRIORITY_ORDER = frozendict({"high": 0, "medium": 1, "low": 2})
_WORKER = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
_ENGINEER = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*$")
REVIEWER_KEY = "asdlc_reviewer"  # the reviewer holding a review claim; cleared when it finishes
REVIEW_KIND_KEY = "asdlc_review_kind"  # cross-machine or same-machine, kept after the review for the person who merges
BRANCH_KEY = "asdlc_branch"  # the task's branch, written by its first claim; every later claim resumes it
APPROVED_KEY = "asdlc_plan_approved_by"  # the person who approved the plan, written only by asdlc approve
APPROVED_HASH_KEY = "asdlc_plan_approved_hash"  # the digest of the plan text approved
APPROVED_SIZE_KEY = "asdlc_plan_approved_size"  # the size label the task had when its plan was approved
RESERVED_KEY = "asdlc_reserved_for_author"  # the engineer a released, sent-back task stays reserved for
ACCEPTED_FROM_KEY = "asdlc_accepted_from"  # the draft id an accepted item had, written by asdlc accept
TRAILER = "Asdlc-Transaction"  # on every board commit asdlc makes, so an unpushed one is known as its own
WORKER_TRAILER = "Asdlc-Worker"  # on every code commit a worker agent makes, so stats can tell a fix made by workers alone
INTENT_STARTED_KEY = "asdlc_intent_started"  # when the conversation that became an intent draft began, from asdlc intent-started
FINDINGS_KEY = "asdlc_review_findings"  # the last verdict's counts, important=N,nit=M, from asdlc review-done
POLICIES_KEY = "asdlc_review_policies"  # the policies or rules the last verdict's findings cite
PLAN_MATCHED_KEY = "asdlc_plan_matched"  # yes or no: whether the last reviewed diff still matched the plan
PENDING = "asdlc-transaction.json"  # in the board clone's git folder while a change is being made
_REVIEWER_LABEL = re.compile(r"^r\d+$")
DRAFTS = "backlog/drafts/"
DEFAULT_WORKERS = 3
DEFAULT_REVIEW_FALLBACK_AFTER = timedelta(0)  # the one orchestrator reviews its own engineer's work at once, with a reviewer it launches
CHECK_TAIL_LINES = 40


# --- the logic: data in, data out ------------------------------------------------------


class AsdlcError(Exception):
    """A refusal or failure the person can act on; its message says what to do."""


@dataclass(frozen=True)
class Route:
    model: str
    effort: str
    reason: str


@dataclass(frozen=True)
class Refusal:
    reason: str


# The routing table: the one place that says which model and effort a task gets.
PLANNING_TYPES = frozendict({
    "intent": "an intent: it is planned and split before anything is built",
    "spike": "a spike: it answers an open question, which takes judgement",
})
PLANNING = Route("opus", "high", "")
SIZE_ROUTES: frozendict[str, Route | Refusal] = frozendict({
    "size-1": Route("haiku", "default", "size-1: a small, mechanical change; its plan needs numbered steps, because haiku follows steps, not intent"),
    "size-2": Route("sonnet", "medium", "size-2: an ordinary change"),
    "size-3": Route("sonnet", "medium", "size-3: an ordinary change"),
    "size-4": Route("sonnet", "medium", "size-4: an ordinary change"),
    "size-5": Route("sonnet", "medium", "size-5: an ordinary change"),
    "size-8": Refusal("size-8 is too big for one change: split it before it starts"),
})
# A review is judgement over one finished task's diff, whatever the task's size.
REVIEW = Route("sonnet", "medium", "a review: judgement over one task's diff against its plan, its acceptance criteria and the team's review policy")


@dataclass(frozen=True)
class Task:
    id: str
    title: str
    status: str
    assignees: tuple[str, ...]
    labels: tuple[str, ...]
    priority: str
    type: str
    parent: str
    ordinal: float | None
    dependencies: tuple[str, ...]
    path: str
    project: str = ""
    reviewer: str = ""  # the reviewer holding the review claim, from REVIEWER_KEY
    review_kind: str = ""
    references: tuple[str, ...] = ()
    branch: str = ""  # from BRANCH_KEY
    plan_approved_by: str = ""  # from APPROVED_KEY
    accepted_from: str = ""  # from ACCEPTED_FROM_KEY
    plan_hash: str = ""  # the digest of the plan section's text now, "" when there is no plan
    approved_hash: str = ""  # from APPROVED_HASH_KEY
    approved_size: str = ""  # from APPROVED_SIZE_KEY
    reserved_for_author: str = ""  # from RESERVED_KEY
    documentation: tuple[str, ...] = ()  # the documents linked on it, such as an intent's spec
    intent_started: str = ""  # from INTENT_STARTED_KEY
    review_findings: str = ""  # from FINDINGS_KEY
    review_policies: tuple[str, ...] = ()  # from POLICIES_KEY
    plan_matched: str = ""  # from PLAN_MATCHED_KEY


def is_draft(task: Task) -> bool:
    return task.path.startswith(DRAFTS)


def _scalar(raw: str) -> str:
    raw = raw.strip()
    if len(raw) >= 2 and raw[0] == raw[-1] == "'":
        return raw[1:-1].replace("''", "'")
    if len(raw) >= 2 and raw[0] == raw[-1] == '"':
        try:
            return str(json.loads(raw))
        except ValueError:
            return raw[1:-1]
    return "" if raw in ("~", "null") else raw


def _flow_list(raw: str) -> tuple[str, ...]:
    items, current, quote = [], "", ""
    for char in raw.strip()[1:-1]:
        if quote:
            quote = "" if char == quote else quote
        elif char in "'\"":
            quote = char
        elif char == ",":
            items.append(current)
            current = ""
            continue
        current += char
    items.append(current)
    return tuple(value for item in items if (value := _scalar(item)))


def _value(raw: str, block: Sequence[str]) -> str | tuple[str, ...]:
    lines = [line.strip() for line in block]
    if raw[:1] in (">", "|"):
        if raw[0] == "|":
            return "\n".join(lines).strip()
        return " ".join(line if line else "\n" for line in lines).replace(" \n ", "\n").strip()
    if raw.startswith("["):
        return _flow_list(" ".join([raw, *lines]))
    if not raw and any(line.startswith("-") for line in lines):
        return tuple(_scalar(line[1:]) for line in lines if line.startswith("-"))
    return _scalar(" ".join(part for part in [raw, *lines] if part))


def frontmatter(text: str) -> frozendict[str, str | tuple[str, ...]]:
    """The subset of YAML that Backlog.md writes: scalars, lists and folded scalars."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return frozendict()
    try:
        end = next(n for n, line in enumerate(lines[1:], start=1) if line.rstrip() == "---")
    except StopIteration:
        return frozendict()
    body, fields, index = lines[1:end], {}, 0
    while index < len(body):
        key, separator, raw = body[index].partition(":")
        index += 1
        if not separator or not key.strip() or key[0].isspace() or key.startswith(("#", "-")):
            continue
        block = []
        while index < len(body) and (body[index][:1] in (" ", "\t", "-") or not body[index].strip()):
            block.append(body[index])
            index += 1
        fields[key.strip()] = _value(raw.strip(), block)
    return frozendict(fields)


def _as_tuple(value: str | tuple[str, ...] | None) -> tuple[str, ...]:
    match value:
        case tuple():
            return value
        case str() if value:
            return (value,)
        case _:
            return ()


_PLAN = re.compile(r"<!-- SECTION:PLAN:BEGIN -->(.*?)<!-- SECTION:PLAN:END -->", re.S)


def plan_of(text: str) -> str:
    """The task's plan section as Backlog writes it, or empty."""
    found = _PLAN.search(text)
    return found[1].strip() if found else ""


def plan_digest(plan: str) -> str:
    """A short digest of a plan's text, recorded with its approval so a changed plan is noticed."""
    return hashlib.sha256(plan.strip().encode()).hexdigest()[:12]


def size_of(task: Task) -> str:
    return next((label for label in task.labels if label.startswith("size-")), "")


def task_from(path: str, text: str) -> Task | None:
    fields = frontmatter(text)
    task_id = fields.get("id")
    if not isinstance(task_id, str) or not task_id:
        return None
    ordinal = fields.get("ordinal")
    try:
        number = float(ordinal) if isinstance(ordinal, str) and ordinal else None
    except ValueError:
        number = None

    def text_field(name: str) -> str:
        value = fields.get(name, "")
        return value if isinstance(value, str) else " ".join(value)

    return Task(
        id=task_id.upper(),
        title=text_field("title"),
        status=text_field("status"),
        assignees=_as_tuple(fields.get("assignee")),
        labels=_as_tuple(fields.get("labels")),
        priority=text_field("priority").lower(),
        type=text_field("type").lower(),
        parent=text_field("parent_task_id").upper(),
        ordinal=number,
        dependencies=tuple(d.upper() for d in _as_tuple(fields.get("dependencies"))),
        path=path,
        project=text_field("project").lower(),
        reviewer=text_field(REVIEWER_KEY).removeprefix("@"),
        review_kind=text_field(REVIEW_KIND_KEY),
        references=_as_tuple(fields.get("references")),
        branch=text_field(BRANCH_KEY),
        plan_approved_by=text_field(APPROVED_KEY).removeprefix("@"),
        accepted_from=text_field(ACCEPTED_FROM_KEY).upper(),
        plan_hash=plan_digest(plan) if (plan := plan_of(text)) else "",
        approved_hash=text_field(APPROVED_HASH_KEY),
        approved_size=text_field(APPROVED_SIZE_KEY),
        reserved_for_author=text_field(RESERVED_KEY).removeprefix("@"),
        documentation=tuple(d.lower() for d in _as_tuple(fields.get("documentation"))),
        intent_started=text_field(INTENT_STARTED_KEY),
        review_findings=text_field(FINDINGS_KEY),
        review_policies=_as_tuple(fields.get(POLICIES_KEY)),
        plan_matched=text_field(PLAN_MATCHED_KEY).lower(),
    )


def yaml_quoted(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"


def with_key(text: str, key: str, value: str | None) -> str:
    """The file's text with a top-level frontmatter key set to `value` (already YAML), or removed.

    Raises:
        AsdlcError: the text has no frontmatter.
    """
    lines = text.split("\n")
    try:
        end = next(n for n, line in enumerate(lines[1:], start=1) if line.rstrip() == "---") if lines[0].strip() == "---" else 0
    except StopIteration:
        end = 0
    if not end:
        raise AsdlcError("the file has no frontmatter to write to")
    head, at = [], None
    index = 1
    while index < end:
        line = lines[index]
        if line.partition(":")[0] == key and line[:1] not in (" ", "\t", "-"):
            at = len(head)
            index += 1
            while index < end and (lines[index][:1] in (" ", "\t", "-") or not lines[index].strip()):
                index += 1
            continue
        head.append(line)
        index += 1
    if value is not None:
        head.insert(len(head) if at is None else at, f"{key}: {value}")
    return "\n".join([lines[0], *head, *lines[end:]])


def normalise_id(raw: str, prefix: str) -> str:
    """`3` and `task-3` both mean `TASK-3`."""
    raw = raw.strip()
    if re.fullmatch(r"\d+(\.\d+)*", raw):
        return f"{prefix.upper()}-{raw}"
    return raw.upper()


def id_key(task_id: str) -> tuple[str, tuple[int, ...]]:
    prefix, _, number = task_id.rpartition("-")
    parts = tuple(int(part) for part in number.split(".") if part.isdigit())
    return (prefix, parts)


def worker_name(raw: str) -> str:
    name = raw.removeprefix("@")
    if not _WORKER.match(name):
        raise AsdlcError(f"'{raw}' is not a worker name: use letters, digits, '.', '_' and '-', such as agent-1")
    return name


def engineer_name(raw: str) -> str:
    """Raises: AsdlcError: not a person's name (letters, digits, '_' and '-', no dots)."""
    name = raw.strip().removeprefix("@")
    if not _ENGINEER.match(name):
        raise AsdlcError(f"'{raw}' is not an engineer's name: use letters, digits, '_' and '-', with no dots, such as kyle")
    return name


def worker_for(raw: str, engineer: str) -> str:
    """A worker name that belongs to the engineer: `<engineer>.<label>`.

    Raises:
        AsdlcError: the name is malformed or belongs to someone else.
    """
    name = worker_name(raw)
    owner, dot, label = name.partition(".")
    if owner != engineer or not dot or not label:
        raise AsdlcError(
            f"'{raw}' is not one of {engineer}'s workers: a worker is named for its engineer, a dot and a label, "
            f"such as {engineer}.w1 (the engineer is git config asdlc.engineer)"
        )
    return name


def reviewer_for(raw: str, engineer: str) -> str:
    """A reviewer name that belongs to the engineer: `<engineer>.r<n>`.

    Raises:
        AsdlcError: the name is malformed, belongs to someone else, or isn't a reviewer's.
    """
    name = worker_for(raw, engineer)
    if not _REVIEWER_LABEL.match(name.partition(".")[2]):
        raise AsdlcError(f"'{raw}' is not a reviewer's name: a reviewer is named for its engineer, a dot, r and a number, such as {engineer}.r1")
    return name


def owner_of(worker: str) -> str:
    return worker.removeprefix("@").partition(".")[0]


def people(assignees: Iterable[str]) -> tuple[str, ...]:
    """The person assignees (`@kyle`); workers (`@kyle.w1`) have a dot."""
    return tuple(a for a in assignees if "." not in a)


def workers(assignees: Iterable[str]) -> tuple[str, ...]:
    return tuple(a for a in assignees if "." in a)


def reserved_for(task: Task, engineer: str) -> bool:
    return f"@{engineer}" in people(task.assignees)


def is_status(task: Task, status: str) -> bool:
    return task.status.casefold() == status.casefold()


def children_of(task_id: str, tasks: Iterable[Task]) -> tuple[Task, ...]:
    return tuple(task for task in tasks if task.parent == task_id)


def route(task: Task, tasks: Iterable[Task]) -> Route | Refusal:
    """Which model and effort a task gets, from the table above, or why it can't start."""
    if task.type in PLANNING_TYPES:
        return Route(PLANNING.model, PLANNING.effort, f"{task.id} is {PLANNING_TYPES[task.type]}")
    if children := children_of(task.id, tasks):
        return Route(PLANNING.model, PLANNING.effort, f"{task.id} has {len(children)} child tasks to plan and coordinate")
    sizes = [label for label in task.labels if label.startswith("size-")]
    if len(sizes) != 1:
        found = "no size label" if not sizes else f"{len(sizes)} size labels ({', '.join(sizes)})"
        return Refusal(f"{task.id} has {found}; exactly one size label is needed: one of {', '.join(SIZE_LABELS)}")
    match SIZE_ROUTES.get(sizes[0]):
        case Route() as chosen:
            return Route(chosen.model, chosen.effort, f"{task.id} is {chosen.reason}")
        case Refusal(reason=reason):
            return Refusal(f"{task.id}: {reason}")
        case _:
            return Refusal(f"{task.id} is labelled {sizes[0]}, which isn't a size this board routes: use one of {', '.join(SIZE_LABELS)}")


def route_json(task_id: str, chosen: Route) -> str:
    return json.dumps({"task": task_id, "model": chosen.model, "effort": chosen.effort, "reason": chosen.reason})


def claim_refusal(task: Task | None, task_id: str, tasks: Iterable[Task], worker: str) -> str | None:
    """Why the worker can't claim a task now, or None when it can.

    A To Do task assigned only to people is reserved for them: only their workers may claim it.
    """
    if task is None:
        return f"{task_id} is not a task on the board (drafts are accepted before they are claimed)"
    if not is_status(task, TO_DO) and task.assignees:
        return f"{task_id} is {task.status} and assigned to {', '.join(task.assignees)}. Run asdlc next for another task."
    if not is_status(task, TO_DO):
        return f"{task_id} is {task.status}, not {TO_DO}, so it can't be claimed"
    if workers(task.assignees):
        return f"{task_id} is assigned to {', '.join(task.assignees)}. Run asdlc next for another task."
    if (reserved := people(task.assignees)) and not reserved_for(task, owner_of(worker)):
        return f"{task_id} is reserved for {', '.join(reserved)}: only their workers may claim it. Run asdlc next for another task."
    if isinstance(chosen := route(task, tasks), Refusal):
        return chosen.reason
    return None


def holder_refusal(task: Task | None, task_id: str, worker: str, doing: str) -> str | None:
    """Why the worker can't change the task's work now, or None when it can: it must hold the
    task In Progress. A claim that was released may be someone else's now."""
    if task is None:
        return f"{task_id} is not a task on the board"
    if f"@{worker}" not in task.assignees:
        held = ", ".join(workers(task.assignees)) or "nobody"
        return (f"{task_id} is held by {held}, not @{worker}, so @{worker} can't {doing}: its claim was released (by asdlc "
                f"release) and the task may be someone else's now. Stop and tell your orchestrator; asdlc mine --as {owner_of(worker)} "
                "shows what your workers hold")
    if not is_status(task, IN_PROGRESS):
        return f"{task_id} is {task.status}, not {IN_PROGRESS}, so @{worker} can't {doing}"
    return None


def approval_refusal(task: Task) -> str | None:
    """Why a task can't be built or finished yet, or None. A plan approved with asdlc approve holds
    only while the plan's text and the task's size are what was approved; anything but size-1
    waits for a person's approval."""
    size = size_of(task)
    if task.plan_approved_by:
        if task.approved_hash and task.approved_hash != task.plan_hash:
            return (f"{task.id}'s plan changed since @{task.plan_approved_by} approved it, so it must be approved again: your engineer runs "
                    f"asdlc approve {task.id} in their own terminal. Write a departure in the notes instead of the plan when the plan still holds")
        if task.approved_size and task.approved_size != size:
            return (f"{task.id} was {task.approved_size} when its plan was approved and is {size or 'unsized'} now, so the plan must be "
                    f"approved again: your engineer runs asdlc approve {task.id} in their own terminal")
        return None
    if size == "size-1":
        return None
    return (f"{task.id}'s plan isn't approved yet: {size or 'a task without a size-1 label'} work is built only after a person approves its plan. "
            f"Write the plan on the task and stop; your engineer runs asdlc approve {task.id} in their own terminal")


def finish_edit(task: Task, branch: str, pull: str | None, notes: str) -> list[str]:
    """The backlog edit that hands a held task to review: In Review, its branch and pull request
    among its references (once), the changes-requested label gone, the worker's notes appended."""
    refs = [r for r in dict.fromkeys((branch, pull or "")) if r and r not in task.references]
    edit = ["task", "edit", task.id, "-s", IN_REVIEW, *[word for ref in refs for word in ("--add-ref", ref)], "--append-notes", notes.strip()]
    return edit + (["--remove-label", CHANGES_REQUESTED] if CHANGES_REQUESTED in task.labels else [])


class Race(StrEnum):
    WON = "won"
    LOST = "lost"
    OPEN = "open"


def race_result(on_origin: Task | None, worker: str) -> Race:
    """After a rejected push: did someone else claim the task, or is it still open?"""
    if on_origin is None:
        return Race.LOST
    if f"@{worker}" in on_origin.assignees and is_status(on_origin, IN_PROGRESS):
        return Race.WON
    if workers(on_origin.assignees) or not is_status(on_origin, TO_DO):
        return Race.LOST
    if people(on_origin.assignees) and not reserved_for(on_origin, owner_of(worker)):
        return Race.LOST
    return Race.OPEN


@dataclass(frozen=True)
class Claimed:
    task: Task


@dataclass(frozen=True)
class Taken:
    """Another agent holds the task; `next` moves on to the next one. `lost`: it won a race for it just now."""

    reason: str
    lost: bool = False


@dataclass(frozen=True)
class Picker:
    """Who is picking work, and what this machine and their preferences allow."""

    engineer: str
    worker: str
    registered: frozenset[str]
    prefer: tuple[str, ...] = ()
    avoid: tuple[str, ...] = ()


def candidates(tasks: Sequence[Task], picker: Picker) -> tuple[tuple[Task, ...], tuple[tuple[Task, str], ...]]:
    """To Do leaf tasks the picker may claim and that can start, in the order to try them, and the skipped.

    Eligible: open, or reserved for the picker's engineer; its project is registered on this
    machine and, unless it is reserved for them, not one they avoid; its dependencies are Done;
    the routing table accepts it.
    """
    by_id = {task.id: task for task in tasks}
    parents = {task.parent for task in tasks if task.parent}
    ready: list[Task] = []
    skipped: list[tuple[Task, str]] = []
    for task in tasks:
        if not is_status(task, TO_DO) or task.id in parents or workers(task.assignees):
            continue
        if people(task.assignees) and not reserved_for(task, picker.engineer):
            continue
        waiting = [d for d in task.dependencies if d in by_id and not is_status(by_id[d], DONE)]
        if not task.project:
            skipped.append((task, f"{task.id} has no project, so it names no repository: set one with asdlc board task edit {task.id} --project <repo-slug>"))
        elif task.project not in picker.registered:
            skipped.append((task, f"{task.id} is in {task.project}, which is not registered on this machine: run asdlc register in a clone of it"))
        elif task.project in picker.avoid and not reserved_for(task, picker.engineer):
            skipped.append((task, f"{task.id} is in {task.project}, which devs/{picker.engineer}.yaml avoids"))
        elif waiting:
            skipped.append((task, f"{task.id} waits on {', '.join(waiting)}"))
        elif isinstance(chosen := route(task, tasks), Refusal):
            skipped.append((task, chosen.reason))
        else:
            ready.append(task)
    return rank(ready, picker), tuple(skipped)


def _tier(task: Task, picker: Picker) -> tuple[int, int, int]:
    """Reserved for me first, then my preferred repositories in order, then the rest (an avoided one is only here when reserved); then priority."""
    if task.project in picker.prefer:
        place = picker.prefer.index(task.project)
    elif task.project in picker.avoid:
        place = len(picker.prefer) + 1
    else:
        place = len(picker.prefer)
    return (0 if reserved_for(task, picker.engineer) else 1, place, PRIORITY_ORDER.get(task.priority, len(PRIORITY_ORDER)))


def spread(worker: str) -> int:
    """Where a worker starts in the best tier: `kyle.w3` starts third, any other name at a stable hash."""
    if found := re.search(r"(\d+)$", worker.rpartition(".")[2]):
        return max(int(found[1]) - 1, 0)
    return int.from_bytes(hashlib.sha256(worker.encode()).digest()[:4])


def rank(ready: Iterable[Task], picker: Picker) -> tuple[Task, ...]:
    """The order to try tasks in: by tier, ordinal and id, with the best tier rotated by the worker's
    spread, so an engineer's workers start on different tasks instead of racing for one."""
    ordered = sorted(ready, key=lambda t: (_tier(t, picker), t.ordinal if t.ordinal is not None else math.inf, id_key(t.id)))
    if not ordered:
        return ()
    best = _tier(ordered[0], picker)
    top = [task for task in ordered if _tier(task, picker) == best]
    shift = spread(picker.worker) % len(top)
    return (*top[shift:], *top[:shift], *ordered[len(top):])


def active_workers(tasks: Iterable[Task], engineer: str) -> tuple[Task, ...]:
    """The engineer's workers' In Progress tasks."""
    return tuple(t for t in tasks if is_status(t, IN_PROGRESS) and any(owner_of(w) == engineer for w in workers(t.assignees)))


def review_claims(tasks: Iterable[Task], engineer: str) -> tuple[Task, ...]:
    """The tasks the engineer's reviewers hold review claims on."""
    return tuple(t for t in tasks if t.reviewer and owner_of(t.reviewer) == engineer)


def busy(tasks: Sequence[Task], engineer: str) -> int:
    """What counts against the `workers` cap: workers building and reviewers reviewing."""
    return len(active_workers(tasks, engineer)) + len(review_claims(tasks, engineer))


def build_refusal(cap: int, held: int, reviews_held: int, waiting: Sequence[str], engineer: str) -> str | None:
    """Why `next` may not start another build now, or None. An engineer who reviews keeps one
    slot for a review waiting for them while none of their reviewers holds one, so building
    never takes every slot and reviews never starve."""
    if held >= cap:
        return f"{engineer}'s workers and reviewers hold {held} task(s), the cap in devs/{engineer}.yaml ({cap})"
    if waiting and not reviews_held and held + 1 >= cap:
        return (f"{engineer}'s next build leaves one slot for the review of {', '.join(waiting)} waiting for them "
                f"(devs/{engineer}.yaml has review: true): run asdlc review-next first")
    return None


# --- review: claims, the fallback and verdicts -------------------------------------------


class ReviewKind(StrEnum):
    CROSS_MACHINE = "cross-machine"
    SAME_MACHINE = "same-machine"


class ReviewVerdict(StrEnum):
    CLEAN = "clean"
    CHANGES = "changes"


@dataclass(frozen=True)
class Reviewing:
    """Who is looking for a review, what this machine has, and the clock."""

    engineer: str
    reviewer: str
    registered: frozenset[str]
    now: datetime
    fallback_after: timedelta = DEFAULT_REVIEW_FALLBACK_AFTER
    fallback: bool = False


def authors(task: Task) -> frozenset[str]:
    """The engineers whose work a task is: the owners of its worker assignees, else its people."""
    if held := workers(task.assignees):
        return frozenset(owner_of(w) for w in held)
    return frozenset(p.removeprefix("@") for p in people(task.assignees))


def review_kind(task: Task, engineer: str) -> ReviewKind:
    return ReviewKind.SAME_MACHINE if engineer in authors(task) else ReviewKind.CROSS_MACHINE


def _waited(entered: datetime | None, now: datetime) -> timedelta:
    return max(now - entered, timedelta()) if entered else timedelta()


def review_refusal(task: Task, reviewing: Reviewing, entered: datetime | None) -> str | None:
    """Why this reviewer can't claim the task's review now, or None when it can.

    `entered` is when the task last entered In Review. The author's own engineer may review
    it only with `fallback`, and only once it has waited longer than `fallback_after`.
    """
    if not is_status(task, IN_REVIEW) or is_draft(task):
        return f"{task.id} is {task.status or 'a draft'}, not {IN_REVIEW}"
    if task.reviewer:
        return f"{task.id} is being reviewed by @{task.reviewer}"
    if REVIEW_PASSED in task.labels:
        return f"{task.id} has passed review and waits for a person to merge it"
    if not task.project:
        return f"{task.id} has no project, so it names no repository to review in"
    if task.project not in reviewing.registered:
        return f"{task.id} is in {task.project}, which is not registered on this machine: run asdlc register in a clone of it"
    if reviewing.engineer in authors(task):
        mine = f"{task.id} is {reviewing.engineer}'s own work: another engineer reviews it"
        waited = _waited(entered, reviewing.now)
        if not reviewing.fallback:
            return f"{mine}, or a fresh reviewer here with --fallback once it has waited longer than review_fallback_after ({human(reviewing.fallback_after)})"
        if waited <= reviewing.fallback_after:
            return f"{mine}; it has waited {human(waited)} for one, not yet longer than review_fallback_after ({human(reviewing.fallback_after)})"
    return None


def review_candidates(tasks: Iterable[Task], reviewing: Reviewing, entered: Mapping[str, datetime]) -> tuple[tuple[Task, ...], tuple[tuple[Task, str], ...]]:
    """In Review tasks the reviewer may claim, in the order to try them, and the In Review tasks skipped.

    Other engineers' work comes first and the reviewer's own (with --fallback, after the
    timeout) last; within each, the task waiting longest first.
    """
    ready: list[Task] = []
    skipped: list[tuple[Task, str]] = []
    for task in tasks:
        if not is_status(task, IN_REVIEW) or is_draft(task):
            continue
        if reason := review_refusal(task, reviewing, entered.get(task.path)):
            skipped.append((task, reason))
        else:
            ready.append(task)

    def order(task: Task) -> tuple[bool, timedelta, tuple[str, tuple[int, ...]]]:
        return (reviewing.engineer in authors(task), -_waited(entered.get(task.path), reviewing.now), id_key(task.id))

    return tuple(sorted(ready, key=order)), tuple(skipped)


def review_refs(references: Iterable[str]) -> tuple[str | None, str | None]:
    """The task's branch and pull request among its references: the branch is the first one
    that isn't a URL, the pull request the first URL (one with /pull/ preferred)."""
    urls = [r for r in references if "://" in r]
    branch = next((r for r in references if "://" not in r), None)
    pull = next((u for u in urls if re.search(r"/pull/\d+|/merge_requests/\d+", u)), urls[0] if urls else None)
    return branch, pull


def review_done_refusal(task: Task | None, task_id: str, reviewer: str) -> str | None:
    """Why the reviewer can't record a verdict on the task, or None when it can."""
    if task is None:
        return f"{task_id} is not a task on the board"
    if task.reviewer != reviewer:
        held = f"@{task.reviewer} holds its review" if task.reviewer else "nobody holds its review"
        return f"{task_id}: {held}, so @{reviewer} can't finish it. Only the reviewer who claimed it with asdlc review-next records the verdict; a released claim is claimed again first"
    if not is_status(task, IN_REVIEW):
        return f"{task_id} is {task.status}, not {IN_REVIEW}: someone moved it while it was being reviewed, so the verdict was not recorded"
    return None


@dataclass(frozen=True)
class ReviewRecord:
    """What a review records beside its notes, for asdlc stats: its findings by severity, the policies or rules
    they cite, and whether the diff still matched the plan."""

    important: int
    nit: int
    policies: tuple[str, ...]
    plan_matched: bool


def parse_findings(raw: str) -> tuple[int, int]:
    """`important=N,nit=M` (either may be left out, for 0) as (important, nit).

    Raises:
        AsdlcError: anything else.
    """
    counts = {"important": 0, "nit": 0}
    for part in (p.strip() for p in raw.split(",") if p.strip()):
        key, separator, value = part.partition("=")
        if not separator or key.strip().lower() not in counts or not value.strip().isdigit():
            raise AsdlcError(f"--findings is important=<n>,nit=<n>, such as important=1,nit=2, not '{raw}'")
        counts[key.strip().lower()] = int(value.strip())
    return counts["important"], counts["nit"]


def review_record_refusal(verdict: ReviewVerdict, record: ReviewRecord) -> str | None:
    """Why the counts don't fit the verdict, or None: changes needs an Important finding, clean has none."""
    if verdict is ReviewVerdict.CHANGES and record.important < 1:
        return "a changes verdict needs at least one Important finding: count it in --findings important=<n>, or record clean if there is none"
    if verdict is ReviewVerdict.CLEAN and record.important:
        return f"--findings has {record.important} Important finding(s), so the verdict is changes, not clean"
    return None


def review_comment(reviewer: str, kind: str, verdict: ReviewVerdict, notes: str, record: ReviewRecord | None = None) -> str:
    what = "changes requested" if verdict is ReviewVerdict.CHANGES else "clean"
    then = (" Back to In Progress for the author's worker." if verdict is ReviewVerdict.CHANGES
            else " It stays In Review for a person to merge.")
    counted = ""
    if record is not None:
        cites = f" Cites: {', '.join(record.policies)}." if record.policies else ""
        counted = (f"\n\nFindings: {record.important} Important, {record.nit} nit.{cites} "
                   f"The diff {'matches' if record.plan_matched else 'does not match'} the plan.")
    return f"Review by @{reviewer} ({kind or ReviewKind.CROSS_MACHINE}): {what}.{then}{counted}\n\n{notes.strip()}"


# --- preferences, settings and the machine's registry: text in, data out ---------------


@dataclass(frozen=True)
class Prefs:
    """`devs/<name>.yaml` on the board: an engineer's preferences, the same on every machine."""

    name: str
    prefer: tuple[str, ...] = ()
    avoid: tuple[str, ...] = ()
    workers: int = DEFAULT_WORKERS
    review: bool = True


_PREF_KINDS = frozendict({"name": "text", "prefer": "list", "avoid": "list", "workers": "count", "review": "flag"})


def _without_comment(line: str) -> str:
    quote = ""
    for index, char in enumerate(line):
        if quote:
            quote = "" if char == quote else quote
        elif char in "'\"":
            quote = char
        elif char == "#" and (index == 0 or line[index - 1] in " \t"):
            return line[:index].rstrip()
    return line.rstrip()


def parse_prefs(text: str, name: str) -> Prefs:
    """A devs file in a strict, flat YAML subset: one `key: value` or `key: [a, b]` per line, and
    `#` comments (the format in the board's devs/README.md). Anything else is refused, so a typo
    can't pass silently.

    Raises:
        AsdlcError: the file is outside the subset, names an unknown key, or a value is wrong.
    """
    where = f"devs/{name}.yaml"
    fields: dict[str, object] = {}
    lines = text.splitlines()
    index = 0
    while index < len(lines):
        number, line = index + 1, _without_comment(lines[index])
        index += 1
        if not line.strip():
            continue
        key, separator, raw = line.partition(":")
        if line[0] in " \t-" or not separator:
            raise AsdlcError(f"{where} line {number}: '{line.strip()}' is not 'key: value'. The file is flat: {', '.join(_PREF_KINDS)}, each on its own line")
        key, raw = key.strip(), raw.strip()
        if key not in _PREF_KINDS:
            raise AsdlcError(f"{where} line {number}: unknown key '{key}'; the keys are {', '.join(_PREF_KINDS)}")
        if key in fields:
            raise AsdlcError(f"{where} line {number}: '{key}' is given twice")
        if _PREF_KINDS[key] == "list":
            if not (raw.startswith("[") and raw.endswith("]")) or re.search(r"[\[\]{}]", raw[1:-1]):
                raise AsdlcError(f"{where} line {number}: '{key}' is a list of repository slugs in brackets, on one line: {key}: [acme-web, acme-api]")
            fields[key] = tuple(item.lower() for item in _flow_list(raw))
            continue
        if not raw or raw[0] in "[{|>&*!":
            raise AsdlcError(f"{where} line {number}: '{key}' needs a plain value on the same line")
        value = _scalar(raw)
        match _PREF_KINDS[key]:
            case "count":
                if not value.isdigit() or int(value) < 1:
                    raise AsdlcError(f"{where} line {number}: workers is how many workers may run at once, a whole number of at least 1, not '{value}'")
                fields[key] = int(value)
            case "flag":
                if value not in ("true", "false"):
                    raise AsdlcError(f"{where} line {number}: review is true or false, not '{value}'")
                fields[key] = value == "true"
            case _:
                if value != name:
                    raise AsdlcError(f"{where} line {number}: name is '{value}', but the file is for '{name}'; they must match")
                fields[key] = value
    if "name" not in fields:
        raise AsdlcError(f"{where}: it has no 'name: {name}' line; name is required and matches the file name")
    if overlap := set(fields.get("prefer", ())) & set(fields.get("avoid", ())):
        raise AsdlcError(f"{where}: {', '.join(sorted(overlap))} is both preferred and avoided")
    return Prefs(name=name, **{k: v for k, v in fields.items() if k != "name"})


def parse_duration(raw: str) -> timedelta:
    """`2h`, `90m`, `1h30m`, `45s` or `1d`.

    Raises:
        AsdlcError: not a duration in that form.
    """
    found = re.fullmatch(r"(?:(\d+)d)?(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", raw.strip())
    if not raw.strip() or not found:
        raise AsdlcError(f"'{raw}' is not a duration: write it like 2h, 90m, 1h30m or 1d")
    days, hours, minutes, seconds = (int(part or 0) for part in found.groups())
    return timedelta(days=days, hours=hours, minutes=minutes, seconds=seconds)


def human(span: timedelta) -> str:
    minutes = int(span.total_seconds() // 60)
    hours, minutes = divmod(minutes, 60)
    return f"{hours}h {minutes}m" if hours else f"{minutes}m"


@dataclass(frozen=True)
class Settings:
    """The board's `asdlc.toml`: settings shared by everyone on the board."""

    review_fallback_after: timedelta = DEFAULT_REVIEW_FALLBACK_AFTER


def parse_settings(text: str) -> Settings:
    """Raises: AsdlcError: the file isn't TOML, or a duration is malformed."""
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        raise AsdlcError(f"asdlc.toml on the board is not valid TOML: {error}") from None
    durations = {}
    for key in ("review_fallback_after",):
        if key in data:
            if not isinstance(data[key], str):
                raise AsdlcError(f"asdlc.toml: {key} is a duration in quotes, such as \"2h\"")
            durations[key] = parse_duration(data[key])
    return Settings(**durations)


@dataclass(frozen=True)
class Registered:
    """A code repository cloned on this machine, registered for a board."""

    slug: str
    path: Path
    board: Path


def parse_registry(text: str) -> frozendict[str, Registered]:
    """Raises: AsdlcError: the machine's repos.toml is not what asdlc register writes."""
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        raise AsdlcError(f"the registry of code repositories on this machine is not valid TOML: {error}") from None
    repos = data.get("repos", {})
    found = {}
    for slug, entry in repos.items() if isinstance(repos, dict) else ():
        if isinstance(entry, dict) and isinstance(entry.get("path"), str):
            found[slug] = Registered(slug, Path(entry["path"]), Path(str(entry.get("board", ""))))
    return frozendict(found)


def registry_text(entries: Iterable[Registered]) -> str:
    lines = ["# Code repositories cloned on this machine, written by asdlc register. Machine facts only: never on the board.", ""]
    for entry in sorted(entries, key=lambda e: e.slug):
        lines += [f"[repos.{json.dumps(entry.slug)}]", f"path = {json.dumps(str(entry.path))}", f"board = {json.dumps(str(entry.board))}", ""]
    return "\n".join(lines)


def with_project(config: str, project: str) -> str | None:
    """Backlog's config with the project added to its `projects` list, or None when it is there."""
    current = _as_tuple(frontmatter(f"---\n{config}\n---\n").get("projects"))
    if project in current:
        return None
    line = f"projects: {json.dumps([*current, project])}"
    lines: list[str] = []
    skipping = written = False
    for existing in config.splitlines():
        if existing[:1] not in (" ", "\t", "-") and existing.strip():
            skipping = existing.partition(":")[0].strip() == "projects"
            if skipping and not written:
                lines.append(line)
                written = True
        if not skipping:
            lines.append(existing)
    return "\n".join([*lines, *([] if written else [line])]) + "\n"


# --- reports ---------------------------------------------------------


def holds(task: Task, worker: str) -> bool:
    """Whether the worker holds the task's claim or the task's review."""
    return f"@{worker}" in task.assignees or task.reviewer == worker


def accepted_as(items: Iterable[Task], draft_id: str, worker: str | None = None) -> tuple[Task, ...]:
    """The items asdlc accept promoted from a draft with this id (held by `worker`, when given).
    Backlog reuses a draft's id once it is promoted, so an old draft id can name a new draft."""
    return tuple(t for t in items if t.accepted_from == draft_id and (worker is None or holds(t, worker)))


def held_item(items: Sequence[Task], task_id: str, worker: str) -> tuple[Task | None, str]:
    """The item the worker means by `task_id`, and a note when it was found by an old draft id: the
    item with that id when the worker holds it, else the item accepted from that draft id that the
    worker holds, else the item with that id (for the caller to refuse)."""
    task = _find(items, task_id)
    if task is not None and holds(task, worker):
        return task, ""
    if len(found := accepted_as(items, task_id, worker)) == 1:
        return found[0], f"{task_id} was accepted as {found[0].id}: use {found[0].id} from now on"
    return task, ""


def reserved_author(task: Task) -> str:
    """The engineer a released, sent-back task is kept for, when releasing it adds one; else ""."""
    if CHANGES_REQUESTED not in task.labels:
        return ""
    added = sorted({owner_of(w) for w in workers(task.assignees)} - {p.removeprefix("@") for p in people(task.assignees)})
    return added[0] if added else ""


def kept_on_release(task: Task) -> tuple[str, ...]:
    """The assignees a released claim leaves: the people it was reserved for and, when a review
    asked for changes, the engineer whose worker built it, so it goes back to them first."""
    kept = people(task.assignees)
    if CHANGES_REQUESTED not in task.labels:
        return kept
    return (*kept, *(f"@{o}" for o in sorted({owner_of(w) for w in workers(task.assignees)}) if f"@{o}" not in kept))


def mine_report(items: Sequence[Task], engineer: str, prefs: Prefs, waiting: Sequence[str] = ()) -> dict[str, object]:
    """The engineer's workers' tasks and reservations, and the reviews waiting for them, for the orchestrator."""
    def row(task: Task, **extra: object) -> dict[str, object]:
        return {"id": task.id, "title": task.title, "status": task.status, "project": task.project, "parent": task.parent, **extra}

    held = [
        row(t, workers=[w.removeprefix("@") for w in workers(t.assignees) if owner_of(w) == engineer],
            changes_requested=CHANGES_REQUESTED in t.labels and is_status(t, IN_PROGRESS), branch=t.branch or None,
            size=size_of(t) or None, plan_hash=t.plan_hash or None, plan_approved_by=t.plan_approved_by or None,
            approval_holds=approval_refusal(t) is None)
        for t in items if any(owner_of(w) == engineer for w in workers(t.assignees)) and not is_status(t, DONE)
    ]
    reviews = review_claims(items, engineer)
    return {
        "engineer": engineer,
        "workers_cap": prefs.workers,
        "active": len(active_workers(items, engineer)),
        "reviewing": len(reviews),
        "review": prefs.review,
        "tasks": sorted(held, key=lambda r: id_key(str(r["id"]))),
        "changes_requested": [r for r in sorted(held, key=lambda r: id_key(str(r["id"]))) if r["changes_requested"]],
        "reviews": [row(t, reviewer=t.reviewer, kind=t.review_kind) for t in sorted(reviews, key=lambda t: id_key(t.id))],
        "reserved": [row(t) for t in items if is_status(t, TO_DO) and reserved_for(t, engineer) and not workers(t.assignees)],
        "reviews_waiting": list(waiting) if prefs.review else [],
        "slot_left_for_review": bool(prefs.review and waiting and not reviews),
    }


@dataclass(frozen=True)
class Where:
    """Where a check ran: the task's worktree, its branch and commit, and whether it had uncommitted changes."""

    worktree: str
    branch: str
    commit: str
    dirty: bool


def check_note(command: Sequence[str], code: int, output: str, now: datetime, tail: int = CHECK_TAIL_LINES, where: Where | None = None,
               since_review: tuple[int, int] | None = None) -> str:
    """A task note recording one check: the command, its exit code, where it ran, the end of its output and, on a task a
    review sent back, how many of the branch's commits since the review carry the worker trailer (`since_review`)."""
    lines = output.rstrip("\n").splitlines()
    shown = lines[-tail:] if tail else []
    cut = f", last {len(shown)} of {len(lines)} lines" if len(lines) > len(shown) else ""
    fence = "```"
    while fence in output:
        fence += "`"
    stamp = now.astimezone(UTC).isoformat(timespec="seconds")
    verdict = "passed" if code == 0 else "FAILED"
    place = (f" in {where.worktree} on {where.branch} at {where.commit[:12]}{' with uncommitted changes' if where.dirty else ''}"
             if where else "")
    after = f"\n\n{since_review_line(*since_review)}" if since_review is not None else ""
    return f"Check {verdict}: `{shlex.join(command)}` exited {code} at {stamp}{place}{cut}:\n\n{fence}text\n" + "\n".join(shown) + f"\n{fence}{after}"


def draft_parent(arguments: Sequence[str]) -> tuple[tuple[str, ...], str] | None:
    """For a draft created under a draft intent: the arguments without the parent, and the parent.

    Backlog only lets an accepted task be a parent, but an intent's children are drafted before
    the intent is accepted, so asdlc records the draft parent itself.
    """
    creating = tuple(arguments[:2]) == ("draft", "create") or (tuple(arguments[:2]) == ("task", "create") and "--draft" in arguments)
    if not creating:
        return None
    kept: list[str] = []
    parent = None
    index = 0
    while index < len(arguments):
        word = arguments[index]
        if word in ("-p", "--parent") and index + 1 < len(arguments):
            value, used = arguments[index + 1], arguments[index:index + 2]
        elif word.startswith("--parent="):
            value, used = word.partition("=")[2], [word]
        else:
            kept.append(word)
            index += 1
            continue
        index += len(used)
        if re.fullmatch(r"(?i)draft-\d+", value.strip()):
            parent = value.strip().upper()
        else:
            kept += used
    return (tuple(kept), parent) if parent else None


def duplicate_ids(tasks: Iterable[Task]) -> frozenset[str]:
    counts = Counter(task.id for task in tasks)
    return frozenset(task_id for task_id, count in counts.items() if count > 1)


class Push(StrEnum):
    PUSHED = "pushed"
    RETRY = "retry"
    FAILED = "failed"


_CONTENTION = ("[rejected]", "non-fast-forward", "fetch first", "cannot lock ref", "failed to update ref", "stale info", "incorrect old value")


def push_outcome(returncode: int, stderr: str) -> Push:
    """A rejected push means someone else pushed first, so it is retried; anything else fails."""
    if returncode == 0:
        return Push.PUSHED
    return Push.RETRY if any(marker in stderr for marker in _CONTENTION) else Push.FAILED


def backoff(attempt: int, rng: random.Random) -> float:
    return rng.uniform(0.05, 0.25) * attempt


def hooks_off(env: Mapping[str, str]) -> dict[str, str]:
    """The environment with every git hook disabled, appended to any config already passed."""
    try:
        count = int(env.get("GIT_CONFIG_COUNT", "0") or "0")
    except ValueError:
        count = 0
    return {
        **env,
        "GIT_CONFIG_COUNT": str(count + 1),
        f"GIT_CONFIG_KEY_{count}": "core.hooksPath",
        f"GIT_CONFIG_VALUE_{count}": "/dev/null",
    }


def backlog_version(text: str) -> tuple[int, ...] | None:
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    return tuple(int(part) for part in match.groups()) if match else None


def board_config(existing: str, project: str) -> str:
    """Backlog's config with this board's settings, keeping every other key as it was."""
    wanted = {"project_name": project, **BOARD_SETTINGS}
    lines: list[str] = []
    written: set[str] = set()
    skipping = False
    for line in existing.splitlines():
        if line[:1] not in (" ", "\t", "-") and line.strip():
            key = line.partition(":")[0].strip()
            skipping = key in wanted
            if skipping and key not in written:
                lines.append(f"{key}: {json.dumps(wanted[key])}")
                written.add(key)
        if not skipping:
            lines.append(line)
    lines += [f"{key}: {json.dumps(value)}" for key, value in wanted.items() if key not in written]
    return "\n".join(lines) + "\n"


def slug(title: str, limit: int = 40) -> str:
    words = re.sub(r"[^a-z0-9]+", " ", title.lower()).split()
    out = ""
    for word in words:
        if len(out) + len(word) + 1 > limit:
            break
        out = f"{out}-{word}" if out else word
    return out or (words[0][:limit] if words else "task")


def branch_name(task: Task) -> str:
    return f"{task.id.lower()}-{slug(task.title)}"


def worktree_path(repo_root: Path, task_id: str) -> Path:
    return repo_root.parent / f"{repo_root.name}.worktrees" / task_id.lower()


def with_exclude(existing: str, entry: str) -> str | None:
    """`info/exclude` with the entry added, or None when it is already there."""
    if entry in (line.strip() for line in existing.splitlines()):
        return None
    return existing + ("" if not existing or existing.endswith("\n") else "\n") + entry + "\n"


# --- the shell: git, files and the backlog CLI ----------------------------------------


def _run(command: Sequence[str], cwd: Path, env: Mapping[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(list(command), cwd=cwd, env=dict(env) if env else None, capture_output=True, text=True)


def _say(message: str) -> None:
    print(f"asdlc: {message}", file=sys.stderr, flush=True)


def _git(directory: Path, *args: str) -> subprocess.CompletedProcess[str]:
    """Git in a code repository, where the repository's own hooks still run."""
    return _run(["git", *args], directory)


def _backlog_binary() -> str:
    return os.environ.get("ASDLC_BACKLOG") or "backlog"


def _check_backlog() -> None:
    """Refuse a backlog CLI that is missing or older than MIN_BACKLOG.

    Raises:
        AsdlcError: backlog is not installed, or is too old.
    """
    binary = _backlog_binary()
    try:
        done = _run([binary, "--version"], Path.cwd())
    except FileNotFoundError:
        raise AsdlcError(f"the backlog CLI ({binary}) is not installed: npm i -g backlog.md@1.55.2") from None
    version = backlog_version(done.stdout)
    if version is None or version < MIN_BACKLOG:
        found = ".".join(map(str, version)) if version else done.stdout.strip() or "unknown"
        raise AsdlcError(
            f"backlog {found} is too old: asdlc needs {'.'.join(map(str, MIN_BACKLOG))} or later, because older "
            "versions drop frontmatter keys they don't know when a task is edited. Upgrade: npm i -g backlog.md@1.55.2"
        )


@dataclass(frozen=True)
class Board:
    """One clone of the board repository. Every git and backlog call in it runs with hooks off."""

    path: Path
    env: frozendict[str, str]
    shared: bool = True  # False: a local board, kept in a repository whose branch it shares and never pushed by asdlc


def board_mode(settings: str | None) -> bool:
    """Whether a board is shared, from the text of its `asdlc.toml` (None when it has none).

    `mode = "shared"` or `mode = "local"` says so. Without it, a board with an `asdlc.toml` is
    shared, as every board was before there were two modes, and one without is local.

    Raises: AsdlcError: the file isn't TOML, or `mode` is neither word.
    """
    if settings is None:
        return False
    try:
        mode = tomllib.loads(settings).get("mode", "shared")
    except tomllib.TOMLDecodeError as error:
        raise AsdlcError(f"asdlc.toml on the board is not valid TOML: {error}") from None
    if mode not in ("shared", "local"):
        raise AsdlcError(f'asdlc.toml: mode is "shared" (a board in its own repository, pushed to origin) or "local" (a board in the repository where the work is done), not {mode!r}')
    return mode == "shared"


def open_board(path: Path) -> Board:
    config = path / "asdlc.toml"
    try:
        shared = board_mode(config.read_text() if config.exists() else None)
    except AsdlcError:
        shared = True  # `asdlc doctor` reports the file; until it is fixed the board is shared, as every board with an asdlc.toml was
    return Board(path, frozendict(hooks_off(os.environ)), shared)


def _board_git(board: Board, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    """Raises: AsdlcError: the command failed and `check` is set."""
    done = _run(["git", *args], board.path, board.env)
    if check and done.returncode != 0:
        raise AsdlcError(f"git {' '.join(args)} failed in the board at {board.path}: {done.stderr.strip()}")
    return done


def _board_backlog(board: Board, args: Sequence[str]) -> subprocess.CompletedProcess[str]:
    return _run([_backlog_binary(), *args], board.path, board.env)


@contextmanager
def _locked(board: Board) -> Iterator[None]:
    """One asdlc change at a time in this clone, since several agents may share it.

    Raises:
        AsdlcError: another asdlc command held the clone for LOCK_WAIT_SECONDS.
    """
    git_dir = Path(_board_git(board, "rev-parse", "--absolute-git-dir").stdout.strip())
    with (git_dir / "asdlc.lock").open("a") as handle:
        deadline = time.monotonic() + LOCK_WAIT_SECONDS
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise AsdlcError(f"another asdlc command holds the lock on the board at {board.path} (it holds it while it changes and pushes "
                                     f"the board) and still had it after {LOCK_WAIT_SECONDS}s; try again in a moment") from None
                time.sleep(0.05)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def _prefix(board: Board) -> str:
    config = board.path / "backlog" / "config.yml"
    value = frontmatter(f"---\n{config.read_text()}\n---\n").get("task_prefix", "task")
    return value if isinstance(value, str) and value else "task"


def _fetch(board: Board) -> None:
    if board.shared:
        _board_git(board, "fetch", "--quiet", "origin", BOARD_BRANCH)


def _base(board: Board) -> str:
    """What a change is made on and measured from: origin/main for a shared board; for a local one,
    the commit the change started at (HEAD when none is in flight)."""
    if board.shared:
        return f"origin/{BOARD_BRANCH}"
    return (_pending(board) or {}).get("base", "HEAD")


def _ahead(board: Board) -> int:
    return int(_board_git(board, "rev-list", "--count", f"{_base(board)}..HEAD").stdout.strip() or "0")


def _batch_bodies(output: bytes) -> list[str]:
    """Split `git cat-file --batch` output into the objects' contents, in order."""
    bodies, position = [], 0
    while position < len(output):
        end = output.index(b"\n", position)
        parts = output[position:end].split()
        if len(parts) < 3:
            break
        start = end + 1
        size = int(parts[2])
        bodies.append(output[start:start + size].decode())
        position = start + size + 1
    return bodies


def _items(board: Board, ref: str | None = None) -> tuple[Task, ...]:
    """Every task and every draft."""
    return _tasks(board, ref, ("tasks", "drafts"))


def _tasks(board: Board, ref: str | None = None, folders: Sequence[str] = ("tasks",)) -> tuple[Task, ...]:
    """Every task in `backlog/tasks` (or the folders named), from the working tree or from a ref such as origin/main."""
    if ref is None:
        files = {
            p.relative_to(board.path).as_posix(): p.read_text()
            for folder in folders for p in sorted((board.path / "backlog" / folder).glob("*.md"))
        }
    else:
        listed = _board_git(board, "-c", "core.quotePath=false", "ls-tree", "-r", "--name-only", ref, "--", *(f"backlog/{f}" for f in folders)).stdout.splitlines()
        names = [name for name in listed if name.endswith(".md")]
        batch = subprocess.run(
            ["git", "cat-file", "--batch"], cwd=board.path, env=dict(board.env), capture_output=True,
            input="".join(f"{ref}:{name}\n" for name in names).encode(),
        ) if names else None
        files = dict(zip(names, _batch_bodies(batch.stdout))) if batch else {}
    return tuple(task for path, text in files.items() if (task := task_from(path, text)))


def _find(tasks: Iterable[Task], task_id: str) -> Task | None:
    return next((task for task in tasks if task.id == task_id), None)


def _git_dir(board: Board) -> Path:
    return Path(_board_git(board, "rev-parse", "--absolute-git-dir").stdout.strip())


def _pending(board: Board) -> dict[str, str] | None:
    """The marker an asdlc change leaves in the clone's git folder while it runs: its id and the
    commit it started from. One still there means that change was interrupted."""
    path = _git_dir(board) / PENDING
    try:
        found = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    return found if isinstance(found, dict) else {}


def _begin(board: Board) -> str:
    """Write the marker for a change starting now, level with origin/main; its id goes in the commit's trailer."""
    found = {"id": f"{os.getpid()}-{time.time_ns()}", "base": _board_git(board, "rev-parse", "HEAD").stdout.strip()}
    (_git_dir(board) / PENDING).write_text(json.dumps(found) + "\n")
    return found["id"]


def _end(board: Board) -> None:
    """Remove the marker, unless the change's own commits are still unpushed (then the next command drops them)."""
    if not board.shared or _ahead(board) == 0:
        (_git_dir(board) / PENDING).unlink(missing_ok=True)


def _require_ready(board: Board) -> None:
    """Raises: AsdlcError: the clone is off main, or has uncommitted changes to tracked files."""
    if _pending(board) is not None and _board_git(board, "status", "--porcelain", "--", "backlog").stdout.strip():
        _say("an earlier asdlc command was interrupted; undoing its unfinished change to backlog/, and nothing else")
        _board_git(board, "checkout", "--quiet", "HEAD", "--", "backlog", check=False)
        _board_git(board, "clean", "-fdq", "--", "backlog")
    if not board.shared:
        staged = _board_git(board, "diff", "--cached", "--name-only").stdout.strip()
        if staged:
            raise AsdlcError(f"the board at {board.path} is a local board and has staged changes, which a board commit would sweep in:\n{staged}\n"
                             "Commit or unstage them first (git restore --staged .).")
        return
    branch = _board_git(board, "branch", "--show-current").stdout.strip()
    if branch != BOARD_BRANCH:
        raise AsdlcError(f"the board at {board.path} is on '{branch or 'a detached HEAD'}'; asdlc works on {BOARD_BRANCH} only")
    dirty = _board_git(board, "status", "--porcelain", "--untracked-files=no").stdout.strip()
    if dirty:
        raise AsdlcError(f"the board at {board.path} has uncommitted changes asdlc won't overwrite:\n{dirty}\nCommit or remove them first.")


def _rebase(board: Board) -> str | None:
    """Rebase onto origin/main; on a conflict, abort it and return the conflicting files."""
    if _board_git(board, "rebase", f"origin/{BOARD_BRANCH}", check=False).returncode == 0:
        return None
    files = _board_git(board, "diff", "--name-only", "--diff-filter=U", check=False).stdout.splitlines()
    _board_git(board, "rebase", "--abort", check=False)
    return ", ".join(files) or "the board"


def _drop_own(board: Board, clean: bool = False) -> None:
    """Drop this command's unpushed commits. Every asdlc change starts level with origin/main,
    so they are the only commits not on it; nobody else's change is lost. `clean` also removes
    files a failed or interrupted backlog command left in backlog/."""
    if not board.shared:
        # Only backlog/ goes back; the rest of the working tree is a person's code and stays as it is.
        base = _base(board)
        _board_git(board, "reset", "--quiet", "--soft", base)
        _board_git(board, "reset", "--quiet", base, "--", "backlog")
        _board_git(board, "checkout", "--quiet", "--", "backlog")
        _board_git(board, "clean", "-fdq", "--", "backlog")
        return
    _board_git(board, "reset", "--quiet", "--hard", f"origin/{BOARD_BRANCH}")
    if clean:
        _board_git(board, "clean", "-fdq", "--", "backlog")


def _push(board: Board) -> tuple[Push, str]:
    if not board.shared:
        return Push.PUSHED, ""
    done = _board_git(board, "push", "--no-verify", "--quiet", "origin", f"HEAD:{BOARD_BRANCH}", check=False)
    return push_outcome(done.returncode, done.stderr), done.stderr.strip()


class Published(StrEnum):
    DONE = "done"
    REPLAY = "replay"


def _publish(board: Board) -> Published:
    """Push this command's commit to origin/main, rebasing and retrying when someone else pushed first.

    A rebase that conflicts drops the change and fails; one that leaves two tasks sharing an id
    (two clones creating a task at once) drops it and asks for the command to run again.

    Raises:
        AsdlcError: the push failed, a rebase conflicted, or other agents kept pushing first;
            the change was dropped each time.
    """
    rng = random.Random()
    for attempt in range(1, PUSH_ATTEMPTS + 1):
        if not _ahead(board):
            return Published.DONE
        outcome, error = _push(board)
        match outcome:
            case Push.PUSHED:
                return Published.DONE
            case Push.FAILED:
                _drop_own(board)
                raise AsdlcError(f"the push to origin/{BOARD_BRANCH} failed, so the change was undone; nothing was changed:\n{error}")
            case Push.RETRY:
                time.sleep(backoff(attempt, rng))
                _fetch(board)
                if conflict := _rebase(board):
                    _drop_own(board)
                    raise AsdlcError(f"your change to {conflict} conflicts with a change another agent pushed first, so it was not applied. The board is now at origin/{BOARD_BRANCH}: check the task and run the command again.")
                if duplicate_ids(_items(board)) - duplicate_ids(_items(board, f"origin/{BOARD_BRANCH}")):
                    _drop_own(board)
                    return Published.REPLAY
    _drop_own(board)
    raise AsdlcError(f"gave up after {PUSH_ATTEMPTS} attempts because other agents kept pushing first; nothing was changed, try again")


@dataclass(frozen=True)
class Unpushed:
    sha: str
    subject: str
    own: bool  # asdlc made it: its trailer says so, or the interrupted change's marker covers it


def unpushed_commits(log: str, interrupted: frozenset[str], files: Mapping[str, Sequence[str]]) -> tuple[Unpushed, ...]:
    """`git log --format=%H%x00%B%x01` over origin/main..HEAD, each commit marked as asdlc's own or not.
    A commit is asdlc's own when its trailer says so, or an interrupted change's marker covers it,
    and it touches nothing outside backlog/: a person's commit is never taken for one."""
    found = []
    for entry in log.split("\x01"):
        sha, _, body = entry.strip("\n").partition("\x00")
        sha = sha.strip()
        if sha:
            marked = bool(re.search(rf"(?m)^{TRAILER}: ", body)) or sha in interrupted
            only_board = all(path.startswith("backlog/") for path in files.get(sha, ()))
            found.append(Unpushed(sha, body.strip().splitlines()[0] if body.strip() else "", marked and only_board))
    return tuple(found)


def foreign_refusal(board: Path, foreign: Sequence[Unpushed], own: Sequence[Unpushed] = ()) -> str:
    listed = "; ".join(f"{c.sha[:12]} {c.subject}" for c in foreign)
    head = (f"the board clone at {board} has {len(foreign)} commit(s) on {BOARD_BRANCH} that aren't on origin and that asdlc didn't make "
            f"({listed}). asdlc never pushes or drops them")
    if own:
        return (f"{head}, and under them are {len(own)} unpushed change(s) an interrupted asdlc command left ({'; '.join(c.subject for c in own)}), "
                "which must never be pushed. Keep yours and drop those: "
                f"git -C {board} reset --hard origin/{BOARD_BRANCH} && git -C {board} cherry-pick {' '.join(c.sha[:12] for c in reversed(foreign))}, "
                "then run the command again.")
    return (f"{head}: push them yourself (git -C {board} pull --rebase origin {BOARD_BRANCH} && git -C {board} push origin {BOARD_BRANCH}) or remove them "
            f"(git -C {board} reset --hard origin/{BOARD_BRANCH}), then run the command again.")


def _catch_up(board: Board) -> None:
    """Fetch and bring local main level with origin/main. Unpushed commits an interrupted asdlc
    command left are dropped, never pushed later: by now the board may have moved on, and a
    claim pushed late would be a claim nobody is working on.

    Raises:
        AsdlcError: the fetch failed, or local main has unpushed commits asdlc didn't make.
    """
    if not board.shared:
        (_git_dir(board) / PENDING).unlink(missing_ok=True)
        return
    _fetch(board)
    marker = _pending(board)
    base = (marker or {}).get("base", "")
    interrupted = frozenset()
    if base and _board_git(board, "cat-file", "-e", f"{base}^{{commit}}", check=False).returncode == 0:
        interrupted = frozenset(_board_git(board, "rev-list", f"{base}..HEAD").stdout.split())
    log = _board_git(board, "log", "--format=%H%x00%B%x01", f"origin/{BOARD_BRANCH}..HEAD").stdout
    shas = [entry.strip("\n").partition("\x00")[0].strip() for entry in log.split("\x01") if entry.strip()]
    files = {sha: _board_git(board, "-c", "core.quotePath=false", "diff-tree", "--no-commit-id", "--name-only", "-r", "--root", sha).stdout.splitlines()
             for sha in shas}
    commits = unpushed_commits(log, interrupted, files)
    if foreign := [c for c in commits if not c.own]:
        raise AsdlcError(foreign_refusal(board.path, foreign, [c for c in commits if c.own]))
    if commits:
        _say(f"dropping {len(commits)} unpushed board change(s) an interrupted asdlc command left ({'; '.join(c.subject for c in commits)}); "
             "they were never pushed, so nobody saw them")
    _board_git(board, "reset", "--quiet", "--hard", f"origin/{BOARD_BRANCH}")
    (_git_dir(board) / PENDING).unlink(missing_ok=True)


def _backlog_committed(board: Board, args: Sequence[str]) -> subprocess.CompletedProcess[str]:
    """Run one backlog command. Raises: AsdlcError: it changed the board without committing it."""
    done = _board_backlog(board, args)
    loose = _board_git(board, "status", "--porcelain", "--", "backlog").stdout.strip()
    if done.returncode == 0 and loose:
        raise AsdlcError(f"backlog changed the board without committing it (is auto_commit on, and git's user set?):\n{loose}")
    return done


def _mark(board: Board, transaction: str) -> None:
    """Make this command's commits one commit with its trailer, keeping backlog's messages."""
    if not _ahead(board):
        return
    messages = _board_git(board, "log", "--reverse", "--format=%B", f"{_base(board)}..HEAD").stdout.strip()
    _board_git(board, "reset", "--quiet", "--soft", _base(board))
    _board_git(board, "commit", "--quiet", "--no-verify", "-m", f"{messages}\n\n{TRAILER}: {transaction}")


@contextmanager
def _change(board: Board) -> Iterator[str]:
    """One asdlc change to the board: locked, level with origin/main, its marker written; on any
    exception (a refusal, a failed push, SIGINT or SIGTERM) its unpushed commits are dropped.
    A change killed outright leaves the marker, and the next command drops what it left."""
    with _locked(board):
        _require_ready(board)
        _catch_up(board)
        transaction = _begin(board)
        try:
            yield transaction
        except BaseException:
            _drop_own(board, clean=True)
            raise
        finally:
            _end(board)


def board_command(board: Board, args: Sequence[str]) -> subprocess.CompletedProcess[str]:
    """Run a backlog command on the board and push what it commits.

    Raises:
        AsdlcError: the board isn't ready, or the change can't be pushed.
    """
    under = draft_parent(args)
    with _change(board) as transaction:
        if under is not None and not any(is_draft(t) and t.id == under[1] for t in _items(board)):
            raise AsdlcError(f"{under[1]} is not a draft on the board, so it can't be a draft's parent")
        for _ in range(PUSH_ATTEMPTS):
            done = _backlog_committed(board, under[0] if under else args)
            if done.returncode != 0:
                _drop_own(board, clean=True)
                return done
            if under is not None:
                _set_draft_parent(board, under[1])
            _mark(board, transaction)
            if _publish(board) is Published.DONE:
                return done
            _say("another agent created a task with the same id first; running the command again")
        raise AsdlcError(f"gave up after {PUSH_ATTEMPTS} attempts because other agents kept creating tasks with the same id; nothing was changed")


def _set_draft_parent(board: Board, parent: str) -> None:
    """Record `parent` on the draft the last commit created, in that same commit.

    Raises:
        AsdlcError: the last commit didn't create exactly one draft.
    """
    added = _board_git(board, "-c", "core.quotePath=false", "diff", "--name-only", "--diff-filter=A", "HEAD~1", "HEAD", "--", DRAFTS).stdout.splitlines()
    if len(added) != 1:
        _drop_own(board)
        raise AsdlcError(f"expected backlog to create one draft, but it created {len(added)}; nothing was changed")
    path = board.path / added[0]
    path.write_text(with_key(path.read_text(), "parent_task_id", parent))
    _board_git(board, "add", "--", added[0])
    _board_git(board, "commit", "--quiet", "--no-verify", "--amend", "--no-edit")


def _squash(board: Board, message: str, transaction: str, paths: Sequence[str] = ("backlog",)) -> bool:
    """Everything this command changed in `paths` as one commit on origin/main, with its trailer; False when nothing changed."""
    _board_git(board, "add", "-A", "--", *paths)
    _board_git(board, "reset", "--quiet", "--soft", _base(board))
    if _board_git(board, "diff", "--cached", "--quiet", check=False).returncode == 0:
        return False
    _board_git(board, "commit", "--quiet", "--no-verify", "-m", f"{message}\n\n{TRAILER}: {transaction}")
    return True


type Step[R] = Callable[[int], tuple[str | None, R]]


def _transact[R](board: Board, step: Step[R], paths: Sequence[str] = ("backlog",)) -> R:
    """One board change, decided on the current origin/main and pushed as one commit.

    `step(attempt)` reads the clone, which is level with origin/main, makes its change in the
    working tree or through backlog, and returns the commit message (None for no change) and
    its result. When someone else pushes first, the change is dropped and `step` runs again on
    the new state, so it decides afresh: a compare-and-swap, the same one a claim makes.

    Raises:
        AsdlcError: `step` refused, the push failed, or other agents kept pushing first.
            Nothing is left unpushed either way.
    """
    rng = random.Random()
    with _change(board) as transaction:
        for attempt in range(1, PUSH_ATTEMPTS + 1):
            message, result = step(attempt)
            if message is None or not _squash(board, message, transaction, paths):
                _drop_own(board)
                return result
            outcome, error = _push(board)
            match outcome:
                case Push.PUSHED:
                    return result
                case Push.FAILED:
                    _drop_own(board)
                    raise AsdlcError(f"the board change could not be pushed, so it was undone:\n{error}")
                case Push.RETRY:
                    _fetch(board)
                    _drop_own(board)
                    time.sleep(backoff(attempt, rng))
        _drop_own(board)
        raise AsdlcError(f"gave up after {PUSH_ATTEMPTS} attempts because other agents kept pushing first; nothing was changed, try again")


CONFIGURED = "git config asdlc.board"


def board_setting(explicit: str | None, environ: Mapping[str, str], configured: str) -> tuple[str, str] | None:
    """The board as given, and where it came from: `--board`, then $ASDLC_BOARD, then `git
    config asdlc.board` (explicit, then the environment, then configuration). `asdlc`,
    `asdlc-plugin` and the rule loader all look it up in this order; None when none is set."""
    for raw, source in ((explicit or "", "--board"), (environ.get("ASDLC_BOARD", ""), "ASDLC_BOARD"), (configured, CONFIGURED)):
        if raw.strip():
            return raw.strip(), source
    return None


def resolve_board(explicit: str | None, cwd: Path) -> Path:
    """The board clone: --board, else $ASDLC_BOARD, else `git config asdlc.board`, else the
    board clone the current directory is in (where an orchestrator session runs).

    Raises:
        AsdlcError: no board is configured, or the path is not a board.
    """
    root = _git(cwd, "rev-parse", "--show-toplevel")
    top = Path(root.stdout.strip()) if root.returncode == 0 else None
    configured = _git(cwd, "config", "--get", "asdlc.board")
    found = board_setting(explicit, os.environ, configured.stdout if configured.returncode == 0 else "")
    if found is not None:
        raw, source = found
        path = Path(raw).expanduser()
        path = path if path.is_absolute() else ((top or cwd) if source == CONFIGURED else cwd) / path
    elif top is not None and (top / "backlog" / "config.yml").exists():
        source, path = "the current directory", top
    else:
        raise AsdlcError("no board: pass --board <path>, set ASDLC_BOARD, run `git config asdlc.board <path>` in this code repository, or work from the board clone")
    path = path.resolve()
    if not (path / "backlog" / "config.yml").exists():
        raise AsdlcError(f"{path} (from {source}) is not a board: it has no backlog/config.yml. Create one with asdlc init-board.")
    return path


def code_repo(cwd: Path, board: Path, shared: bool = True) -> Path | str:
    """The root of the code repository the current directory is in, or why there is none.
    A local board lives in the code repository, so there the board's own folder is the answer."""
    common = _git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common.returncode != 0:
        return "the current directory is not in a git repository"
    git_dir = Path(common.stdout.strip())
    root = git_dir.parent if git_dir.name == ".git" else git_dir
    if root.resolve() == board.resolve():
        return "the current directory is the board itself" if shared else root
    if _git(cwd, "config", "--get", "asdlc.board").returncode != 0:
        return f"{root} has no asdlc.board configured"
    return root


def default_branch(repo: Path) -> str:
    head = _git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    return head.stdout.strip().removeprefix("origin/") if head.returncode == 0 and head.stdout.strip() else "main"


def _has_ref(repo: Path, ref: str) -> bool:
    return _git(repo, "rev-parse", "--verify", "--quiet", ref).returncode == 0


def _ancestor(repo: Path, older: str, newer: str) -> bool:
    return _git(repo, "merge-base", "--is-ancestor", older, newer).returncode == 0


def make_worktree(repo: Path, task: Task, worker: str, board: Path) -> tuple[Path, str | None]:
    """The task's worktree, with its marker, on the task's recorded branch, and where it resumed from.

    A branch someone already pushed (an earlier round, or a worker whose claim was released) is
    resumed from `origin/<branch>`, and a local copy behind it is brought up to it; only a branch
    nobody pushed starts from origin's default branch. A pushed branch is never started again from
    the default branch, so nothing has to be force-pushed over it.

    Raises:
        AsdlcError: the path holds another task, or git could not add the worktree.
    """
    path = worktree_path(repo, task.id)
    marker = path / MARKER
    branch = task.branch or branch_name(task)
    resumed = None
    if marker.exists():
        recorded = json.loads(marker.read_text()).get("task")
        if recorded != task.id:
            raise AsdlcError(f"{path} already holds {recorded}; move it before claiming {task.id}")
    else:
        base = default_branch(repo)
        if _git(repo, "fetch", "--quiet", "origin", base).returncode != 0:
            _say(f"could not fetch origin/{base}; branching from the last fetched copy")
        pushed = _git(repo, "fetch", "--quiet", "origin", f"+refs/heads/{branch}:refs/remotes/origin/{branch}").returncode == 0
        remote = f"refs/remotes/origin/{branch}"
        if _has_ref(repo, f"refs/heads/{branch}"):
            added = _git(repo, "worktree", "add", str(path), branch)
            if pushed and path.is_dir():
                resumed = f"origin/{branch}"
                if _ancestor(repo, branch, remote):
                    _git(path, "merge", "--quiet", "--ff-only", remote)
                elif not _ancestor(repo, remote, branch):
                    _say(f"{branch} here and origin/{branch} have diverged: rebase your commits onto origin/{branch} in {path} before pushing")
        elif pushed:
            added = _git(repo, "worktree", "add", "--no-track", "-b", branch, str(path), remote)
            resumed = f"origin/{branch}"
        elif _has_ref(repo, f"refs/remotes/origin/{base}"):
            added = _git(repo, "worktree", "add", "--no-track", "-b", branch, str(path), f"origin/{base}")
        else:
            raise AsdlcError(f"claimed {task.id}, but {repo} has no origin/{base} to branch from, so no worktree was made")
        if not path.is_dir():
            raise AsdlcError(f"claimed {task.id}, but git could not add its worktree: {added.stderr.strip()}")
    marker.write_text(json.dumps({"task": task.id, "worker": worker, "board": str(board), "type": task.type}, indent=2) + "\n")
    exclude = Path(_git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()) / "info" / "exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    if (updated := with_exclude(exclude.read_text() if exclude.exists() else "", MARKER)) is not None:
        exclude.write_text(updated)
    return path, resumed


# --- who and where: the engineer, preferences, settings and this machine's repositories --


def _engineer(cwd: Path) -> str:
    """The engineer on this machine: `git config asdlc.engineer`.

    Raises:
        AsdlcError: it isn't set, or isn't a name.
    """
    found = _git(cwd, "config", "--get", "asdlc.engineer")
    if found.returncode != 0 or not found.stdout.strip():
        raise AsdlcError(
            "asdlc doesn't know who you are: set your name once with `git config --global asdlc.engineer <name>`, "
            "the same name as your devs/<name>.yaml on the board, such as kyle"
        )
    return engineer_name(found.stdout.strip())


def _prefs(board: Board, engineer: str) -> Prefs:
    """Raises: AsdlcError: the engineer's devs file is malformed."""
    path = board.path / "devs" / f"{engineer}.yaml"
    return parse_prefs(path.read_text(), engineer) if path.is_file() else Prefs(engineer)


def _settings(board: Board) -> Settings:
    """Raises: AsdlcError: the board's asdlc.toml is malformed."""
    path = board.path / "asdlc.toml"
    return parse_settings(path.read_text()) if path.is_file() else Settings()


def _registry_file() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base).expanduser() / "asdlc" / "repos.toml"


def _registry() -> frozendict[str, Registered]:
    """Raises: AsdlcError: the registry file is malformed."""
    path = _registry_file()
    return parse_registry(path.read_text()) if path.is_file() else frozendict()


def _refresh(board: Board) -> str:
    """Bring the clone level with origin/main; the ref to read the board from."""
    with _locked(board):
        _require_ready(board)
        _catch_up(board)
    return _base(board) if board.shared else "HEAD"


def _write_key(board: Board, task: Task, key: str, value: str | None) -> None:
    path = board.path / task.path
    path.write_text(with_key(path.read_text(), key, value))


def _comment(board: Board, task: Task, text: str, author: str) -> None:
    """Raises: AsdlcError: backlog could not add the comment."""
    done = _board_backlog(board, ["draft" if is_draft(task) else "task", "edit", task.id, "--comment", text, "--comment-author", author])
    if done.returncode != 0:
        raise AsdlcError(f"backlog could not comment on {task.id}: {(done.stderr or done.stdout).strip()}")


def _emit(report: Mapping[str, object], as_json: bool, lines: Iterable[str]) -> None:
    if as_json:
        print(json.dumps(report))
    else:
        for line in lines:
            print(line)


# --- accepting work: a person's command ---------------------------------------------------


def _promote(board: Board, draft_id: str) -> str:
    """Promote one draft; its new task id.

    Raises:
        AsdlcError: backlog failed or made no single new task.
    """
    before = {t.id for t in _tasks(board)}
    done = _board_backlog(board, ["draft", "promote", draft_id])
    added = {t.id for t in _tasks(board)} - before
    if done.returncode != 0 or len(added) != 1:
        raise AsdlcError(f"backlog could not promote {draft_id}: {(done.stderr or done.stdout).strip()}")
    return added.pop()


def _beneath(items: Sequence[Task], task: Task, root: str) -> bool:
    """Whether `root` is among the task's parents, at any depth."""
    seen: set[str] = set()
    current = task
    while current.parent and current.parent not in seen:
        if current.parent == root:
            return True
        seen.add(current.parent)
        parent = _find(items, current.parent)
        if parent is None:
            return False
        current = parent
    return False


def accept_comment(accepted: Mapping[str, str], engineer: str) -> str:
    """The comment on an accepted intent mapping each draft id to its task id, since Backlog reuses draft ids."""
    pairs = "\n".join(f"- {old} -> {new}" for old, new in accepted.items())
    return (f"Accepted by @{engineer}. Draft ids are reused once promoted, so refer to these by their new ids "
            f"(asdlc_accepted_from on each keeps the old one):\n\n{pairs}")


def accept(board: Board, raw_id: str, engineer: str) -> dict[str, object]:
    """Promote an intent draft and every draft under it, at any depth, in one board commit:
    each level re-parented under its newly accepted parent, dependencies on each other remapped,
    each promoted item marked with the draft id it had, and the mapping commented on the intent.

    Raises:
        AsdlcError: no such intent, backlog failed, or the change could not be pushed.
    """
    intent_id = normalise_id(raw_id, _prefix(board))

    def step(attempt: int) -> tuple[str | None, dict[str, object]]:
        intent = _find(_items(board), intent_id)
        if intent is None:
            raise AsdlcError(f"{intent_id} is not a draft or a task on the board")
        if intent.type != "intent":
            raise AsdlcError(f"{intent_id} is a {intent.type or 'task'}, not an intent: asdlc accept takes an intent and accepts its draft children with it")
        items = _items(board)
        if not is_draft(intent) and not any(is_draft(t) and _beneath(items, t, intent.id) for t in items):
            return None, {"intent": intent.id, "accepted": {}, "note": f"{intent.id} is already accepted and has no draft children: nothing to accept"}
        accepted: dict[str, str] = {}
        root = _promote(board, intent.id) if is_draft(intent) else intent.id
        if root != intent.id:
            accepted[intent.id] = root
        level = [(intent.id, root)]
        while level:
            below = []
            for old, new in level:
                below += [(t.id, t.id) for t in _items(board) if not is_draft(t) and t.parent == new and t.id not in accepted.values()]
                for child in sorted((t for t in _items(board) if is_draft(t) and t.parent == old), key=lambda t: id_key(t.id)):
                    if child.parent != new:
                        _write_key(board, child, "parent_task_id", new)
                        _board_git(board, "commit", "--quiet", "--no-verify", "-am", f"Put {child.id} under {new}")
                    accepted[child.id] = _promote(board, child.id)
                    below.append((child.id, accepted[child.id]))
            level = below
        for new_id in accepted.values():
            task = _find(_tasks(board), new_id)
            if task is not None and any(d in accepted for d in task.dependencies):
                done = _board_backlog(board, ["task", "edit", new_id, "--dep", ",".join(accepted.get(d, d) for d in task.dependencies)])
                if done.returncode != 0:
                    raise AsdlcError(f"backlog could not carry {new_id}'s dependencies over: {(done.stderr or done.stdout).strip()}")
        top = _find(_tasks(board), root)
        if top is not None:
            _comment(board, top, accept_comment(accepted, engineer), f"@{engineer}")
        for old, new_id in accepted.items():
            if (task := _find(_tasks(board), new_id)) is not None:
                _write_key(board, task, ACCEPTED_FROM_KEY, old)
        children = len(accepted) - (1 if intent.id in accepted else 0)
        note = f"accepted {root} ({intent.title}) and {children} task(s) under it"
        return f"Accept {root}: {intent.title}, with {children} task(s) under it", {"intent": root, "accepted": accepted, "note": note}

    return _transact(board, step)


def approve(board: Board, raw_id: str, engineer: str, shown: str | None = None) -> str:
    """Record a person's approval of a task's plan, with the plan's digest and the task's size, in one
    board commit with a comment; the result shows the plan approved. `shown` is the digest of the
    plan the person was shown: a plan changed since is refused.

    Raises:
        AsdlcError: no such task, it is a draft or Done, no worker holds it, it has no plan, the plan
            changed since it was shown, or the change could not be pushed.
    """
    task_id = normalise_id(raw_id, _prefix(board))

    def step(attempt: int) -> tuple[str | None, str]:
        task = _find(_items(board), task_id)
        if task is None or is_draft(task):
            raise AsdlcError(f"{task_id} is {'a draft: accept it first' if task else 'not a task on the board'}")
        if is_status(task, DONE):
            raise AsdlcError(f"{task_id} is Done; there is nothing left to approve")
        if not (is_status(task, IN_PROGRESS) and workers(task.assignees)):
            raise AsdlcError(f"{task_id} is {task.status} and no longer held by a worker (its claim was released), so there is no "
                             "plan waiting to be built: the next worker to claim it plans it again, and you approve that plan")
        plan = plan_of((board.path / task.path).read_text())
        if not plan:
            raise AsdlcError(f"{task_id} has no plan yet: its worker writes one in phase 1 (asdlc board task edit {task_id} --plan ...) before it is approved")
        digest = plan_digest(plan)
        if shown and shown != digest:
            raise AsdlcError(f"{task_id}'s plan changed since it was shown to you (shown {shown}, now {digest}): read it again and approve that")
        shown_plan = f"{task_id}'s plan ({digest}, {size_of(task) or 'no size'}):\n{plan}\n"
        if task.plan_approved_by == engineer and task.approved_hash == digest and task.approved_size == size_of(task):
            return None, f"{shown_plan}@{engineer} already approved this plan of {task_id}"
        _write_key(board, task, APPROVED_KEY, engineer)
        _write_key(board, task, APPROVED_HASH_KEY, yaml_quoted(digest))
        _write_key(board, task, APPROVED_SIZE_KEY, size_of(task) or None)
        _comment(board, task, f"Plan approved by @{engineer} ({digest}, {size_of(task) or 'no size'}): its worker may build it.", f"@{engineer}")
        return f"Approve the plan of {task_id}: @{engineer}", f"{shown_plan}@{engineer} approved the plan of {task_id}"

    return _transact(board, step)


def intent_started(board: Board, raw_id: str, at: datetime, now: datetime) -> str:
    """Record on an intent draft when the conversation that wrote it began, so stats can time conversation
    to committed intent. An agent runs it right after creating the draft; it never overwrites a start.

    Raises:
        AsdlcError: not a draft intent, a time in the future, another start already recorded, or the change could not be pushed.
    """
    draft_id = normalise_id(raw_id, "draft")
    stamp = at.astimezone(UTC).isoformat(timespec="seconds")
    if at > now + timedelta(minutes=5):
        raise AsdlcError(f"{stamp} is in the future: give the time the conversation began, such as the output of date -u +%Y-%m-%dT%H:%M:%SZ then")

    def step(attempt: int) -> tuple[str | None, str]:
        draft = next((t for t in _items(board) if t.id == draft_id and is_draft(t)), None)
        if draft is None:
            raise AsdlcError(f"{draft_id} is not a draft on the board: record the start on the intent's draft right after creating it, before it is accepted")
        if draft.type != "intent":
            raise AsdlcError(f"{draft_id} is a {draft.type or 'task'}, not an intent: only an intent's conversation is timed")
        if draft.intent_started == stamp:
            return None, f"{draft_id}: the conversation's start was already recorded at {stamp}"
        if draft.intent_started:
            raise AsdlcError(f"{draft_id} already records that its conversation began at {draft.intent_started}; asdlc doesn't change it")
        _write_key(board, draft, INTENT_STARTED_KEY, yaml_quoted(stamp))
        return f"Record when the conversation on {draft_id} began", f"{draft_id}: the conversation began at {stamp}"

    return _transact(board, step)


# --- registering this machine's code repositories ----------------------------------------


def register(explicit_board: str | None, cwd: Path, as_json: bool) -> int:
    """Register the code repository the current directory is in: its board, its slug on this
    machine, and its slug in the board's projects.

    Raises:
        AsdlcError: not in a code repository, no origin remote, no board, or the board change failed.
    """
    common = _git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common.returncode != 0:
        raise AsdlcError("run asdlc register inside a clone of the code repository")
    git_dir = Path(common.stdout.strip())
    root = (git_dir.parent if git_dir.name == ".git" else git_dir).resolve()
    if (root / "backlog" / "config.yml").exists():
        raise AsdlcError(f"{root} is a board; asdlc register is for the code repositories its tasks change")
    board_path = resolve_board(explicit_board, root)
    origin = _git(root, "remote", "get-url", "origin")
    if origin.returncode != 0:
        raise AsdlcError(f"{root} has no origin remote, and its name on the board comes from it: git remote add origin <url>")
    found = slug_of(root)
    if found is None:
        raise AsdlcError(f"can't tell the repository's owner and name from {root}'s origin remote ({origin.stdout.strip()}); asdlc names it owner-repo from there")
    _git(root, "config", "asdlc.board", str(board_path))
    entries = dict(_registry())
    entries[found] = Registered(found, root, board_path)
    path = _registry_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(registry_text(entries.values()))
    board = open_board(board_path)

    def step(attempt: int) -> tuple[str | None, bool]:
        config = board.path / "backlog" / "config.yml"
        if (updated := with_project(config.read_text(), found)) is None:
            return None, False
        config.write_text(updated)
        return f"Register project {found}", True

    added = _transact(board, step)
    report = {"slug": found, "path": str(root), "board": str(board_path), "registry": str(path), "added_to_board": added}
    _emit(report, as_json, [
        f"registered {found} at {root} on this machine ({path})",
        f"{found} {'added to' if added else 'was already in'} the board's projects; tasks in it use --project {found}",
    ])
    return 0


def repos(as_json: bool) -> int:
    entries = _registry()
    rows = [{"slug": e.slug, "path": str(e.path), "board": str(e.board), "exists": e.path.is_dir()} for e in sorted(entries.values(), key=lambda e: e.slug)]
    lines = [f"{r['slug']}\t{r['path']}" + ("" if r["exists"] else "\t(missing)") for r in rows]
    _emit({"registry": str(_registry_file()), "repos": rows}, as_json, lines or [f"no repositories registered on this machine ({_registry_file()}): run asdlc register in a clone"])
    return 0


# --- reports for the orchestrator ----------------------------------------------------------


def whoami(explicit_board: str | None, cwd: Path, as_json: bool) -> int:
    engineer = _engineer(cwd)
    report: dict[str, object] = {"engineer": engineer, "board": None, "board_error": None, "preferences": None,
                                 "repos": {e.slug: str(e.path) for e in _registry().values()}}
    try:
        board = open_board(resolve_board(explicit_board, cwd))
        prefs = _prefs(board, engineer)
        report["board"] = str(board.path)
        report["preferences"] = {"file": f"devs/{engineer}.yaml", "found": (board.path / "devs" / f"{engineer}.yaml").is_file(),
                                 "prefer": list(prefs.prefer), "avoid": list(prefs.avoid), "workers": prefs.workers, "review": prefs.review}
    except AsdlcError as error:
        report["board_error"] = str(error)
    lines = [f"engineer: {engineer}", f"board: {report['board'] or report['board_error']}"]
    if isinstance(found := report["preferences"], dict):
        source = found["file"] if found["found"] else f"defaults (no {found['file']} on the board)"
        lines.append(f"preferences: {source}: prefer {', '.join(found['prefer']) or '-'}; avoid {', '.join(found['avoid']) or '-'}; workers {found['workers']}; review {'yes' if found['review'] else 'no'}")
    lines.append("repos: " + (", ".join(f"{slug} at {path}" for slug, path in report["repos"].items()) or "none registered"))
    _emit(report, as_json, lines)
    return 0


def _waiting_reviews(board: Board, ref: str, tasks: Sequence[Task], engineer: str, now: datetime) -> tuple[str, ...]:
    """The In Review tasks this engineer's reviewer could claim now, fallback included."""
    reviewing = Reviewing(engineer, f"{engineer}.r0", frozenset(_registry()), now, _settings(board).review_fallback_after, fallback=True)
    unclaimed = [t for t in tasks if is_status(t, IN_REVIEW) and not t.reviewer]
    ready, _ = review_candidates(tasks, reviewing, _entered_review(board, ref, unclaimed)) if unclaimed else ((), ())
    return tuple(t.id for t in ready)


def mine(board: Board, engineer: str, as_json: bool) -> int:
    origin = _refresh(board)
    items, prefs = _items(board, origin), _prefs(board, engineer)
    waiting = _waiting_reviews(board, origin, [t for t in items if not is_draft(t)], engineer, datetime.now(UTC)) if prefs.review else ()
    report = mine_report(items, engineer, prefs, waiting)
    lines = [f"{engineer}: {report['active']} of {report['workers_cap']} workers busy building, {report['reviewing']} reviewing (the cap counts both)"]
    lines += [f"  {r['id']}\t{r['status']}{' (changes requested)' if r['changes_requested'] else ''}"
              f"{(' (plan approved by @' + r['plan_approved_by'] + ')' if r['approval_holds'] else ' (plan changed since approval)') if r['plan_approved_by'] else ''}\t@{', @'.join(r['workers'])}\t{r['project'] or '-'}\t{r['title']}"
              for r in report["tasks"]]
    lines += [f"  review {r['id']}\t@{r['reviewer']}\t{r['kind']}\t{r['project'] or '-'}\t{r['title']}" for r in report["reviews"]]
    lines += [f"  reserved {r['id']}\t{r['project'] or '-'}\t{r['title']}" for r in report["reserved"]]
    if report["reviews_waiting"]:
        lines.append(f"  reviews waiting for you: {', '.join(report['reviews_waiting'])}"
                     + ("; asdlc next leaves a slot for one" if report["slot_left_for_review"] else ""))
    _emit(report, as_json, lines)
    return 0


def _where(cwd: Path, task_id: str) -> Where:
    """The claimed worktree the current directory is in.

    Raises:
        AsdlcError: it isn't in a task's worktree, or the worktree holds another task.
    """
    top = _git(cwd, "rev-parse", "--show-toplevel")
    root = Path(top.stdout.strip()) if top.returncode == 0 else None
    marker = root / MARKER if root else None
    if marker is None or not marker.is_file():
        raise AsdlcError(f"give asdlc record-check {task_id}'s worktree with --in <worktree>, the one whose {MARKER} names it "
                         f"(asdlc claim printed it); {root or cwd} is not a task's worktree, so the check was not run")
    try:
        recorded = str(json.loads(marker.read_text()).get("task", ""))
    except (ValueError, AttributeError):
        recorded = ""
    if recorded.upper() != task_id:
        raise AsdlcError(f"{root} is the worktree of {recorded or 'an unknown task'}, not {task_id}, so the check was not run")
    return Where(str(root), _git(root, "branch", "--show-current").stdout.strip() or "a detached HEAD",
                 _git(root, "rev-parse", "HEAD").stdout.strip(), bool(_git(root, "status", "--porcelain").stdout.strip()))


def _since_review(worktree: Path, branch: str) -> tuple[int, int] | None:
    """On a task a review sent back: of the branch's commits since what the reviewer saw (origin/<branch>, merges
    aside), how many carry the worker trailer, and how many there are; None when the branch was never pushed."""
    if _git(worktree, "rev-parse", "--verify", "--quiet", f"origin/{branch}").returncode != 0:
        return None
    log = _git(worktree, "log", "--no-merges", "--format=%B%x01", f"origin/{branch}..HEAD")
    return worker_commits(log.stdout) if log.returncode == 0 else None


def record_check(board: Board, raw_id: str, worker: str, command: Sequence[str], cwd: Path) -> int:
    """Run a check in the task's worktree, append its command, exit code, where it ran and its output
    tail to the task's notes, and return its exit code, so the evidence on the board comes from the
    toolchain. Only the worker holding the task In Progress records checks on it.

    Raises:
        AsdlcError: not in the task's worktree, the worker doesn't hold the task, or the note could not be pushed.
    """
    task_id = normalise_id(raw_id, _prefix(board))
    where = _where(cwd, task_id)
    task = _find(_tasks(board, _refresh(board)), task_id)
    if refusal := holder_refusal(task, task_id, worker, "record checks on it") or approval_refusal(task):
        raise AsdlcError(f"{refusal}. The check was not run")
    try:
        done = subprocess.run(list(command), cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        code, output = done.returncode, done.stdout
    except OSError as error:
        code, output = 127, f"could not run {command[0]}: {error}\n"
    print(output, end="", flush=True)
    note = check_note(command, code, output, datetime.now(UTC), where=where,
                      since_review=_since_review(Path(where.worktree), task.branch or where.branch) if CHANGES_REQUESTED in task.labels else None)

    def step(attempt: int) -> tuple[str | None, None]:
        if refusal := holder_refusal(_find(_tasks(board), task_id), task_id, worker, "record checks on it"):
            raise AsdlcError(f"{refusal}. The check ran but was not recorded")
        recorded = _board_backlog(board, ["task", "edit", task_id, "--append-notes", note])
        if recorded.returncode != 0:
            raise AsdlcError(f"backlog could not record the check on {task_id}: {(recorded.stderr or recorded.stdout).strip()}")
        return f"Record a check on {task_id} by @{worker}: exit {code}", None

    _transact(board, step)
    _say(f"recorded on {task_id}: {shlex.join(command)} exited {code}")
    return code


def finish(board: Board, raw_id: str, worker: str, branch: str | None, pull: str | None, notes: str) -> dict[str, object]:
    """Hand the worker's task to review: In Review with its branch and pull request recorded and the
    worker's notes appended, or, after a review asked for changes, back to review without the label.

    Raises:
        AsdlcError: no notes, the worker doesn't hold the task In Progress, the branch isn't the
            task's, backlog failed, or the change could not be pushed.
    """
    if not notes.strip():
        raise AsdlcError("say in --notes what was built, the checks recorded, and anything the reviewer should look at")
    task_id = normalise_id(raw_id, _prefix(board))

    def step(attempt: int) -> tuple[str | None, dict[str, object]]:
        task = _find(_tasks(board), task_id)
        if refusal := holder_refusal(task, task_id, worker, "finish it"):
            raise AsdlcError(refusal)
        assert task is not None
        if refusal := approval_refusal(task):
            raise AsdlcError(refusal)
        if branch and task.branch and branch != task.branch:
            raise AsdlcError(f"{task_id}'s branch is {task.branch}, recorded when it was first claimed, not {branch}: push {task.branch} and finish with it")
        chosen = task.branch or branch or branch_name(task)
        done = _board_backlog(board, finish_edit(task, chosen, pull, notes))
        if done.returncode != 0:
            raise AsdlcError(f"backlog could not hand {task_id} to review: {(done.stderr or done.stdout).strip()}")
        if not task.branch:
            _write_key(board, task, BRANCH_KEY, chosen)
        again = CHANGES_REQUESTED in task.labels
        return f"Finish {task_id}: @{worker}, In Review", {"task": task_id, "worker": worker, "branch": chosen, "pull_request": pull,
                                                           "status": IN_REVIEW, "resubmitted": again}

    return _transact(board, step)


# --- claims ------------------------------------------------------------------------------


def _claim_on_board(board: Board, task_id: str, worker: str, registry: Mapping[str, Registered]) -> Claimed | Taken:
    """Claim a task: In Progress, the worker added beside any person it was reserved for, pushed.

    Raises:
        AsdlcError: the task can't be claimed for a reason other than another agent holding it,
        its project isn't registered on this machine, or the claim could not be pushed. A claim
        that isn't pushed is always undone.
    """
    def step(attempt: int) -> tuple[str | None, Claimed | Taken]:
        tasks = _tasks(board)
        task = _find(tasks, task_id)
        if task is not None and race_result(task, worker) is Race.WON:
            raise AsdlcError(f"{task_id} is already claimed by @{worker}: another session may be using that name. Give each session's "
                             f"workers names of their own; if this session claimed it, carry on in its worktree")
        refusal = claim_refusal(task, task_id, tasks, worker)
        if task is None or refusal:
            if task is not None and task.assignees:
                return None, Taken(f"Another agent claimed {task_id} first. Run asdlc next for another task." if attempt > 1 else str(refusal), lost=attempt > 1)
            raise AsdlcError(refusal or f"{task_id} is not a task on the board")
        if task.project and task.project not in registry:
            raise AsdlcError(f"{task_id} is in {task.project}, which is not registered on this machine: run asdlc register in a clone of it, then claim it")
        assignees = (*people(task.assignees), f"@{worker}")
        done = _board_backlog(board, ["task", "edit", task_id, "-s", IN_PROGRESS, "-a", ",".join(assignees)])
        if done.returncode != 0:
            raise AsdlcError(f"backlog did not record the claim on {task_id}: {(done.stderr or done.stdout).strip()}")
        branch = task.branch or branch_name(task)
        if not task.branch:
            _write_key(board, task, BRANCH_KEY, branch)
        if task.reserved_for_author:
            _write_key(board, task, RESERVED_KEY, None)
        return f"Claim {task_id} for @{worker}", Claimed(replace(task, status=IN_PROGRESS, assignees=assignees, branch=branch))

    return _transact(board, step)


def _claim_report(board: Board, task: Task, worker: str, cwd: Path, registry: Mapping[str, Registered]) -> dict[str, object]:
    """Make the claimed task's worktree in the repository registered for its project (or, for a
    task with no project, the code repository the current directory is in), and describe the claim."""
    chosen = route(task, _tasks(board))
    report: dict[str, object] = {
        "claimed": True, "task": task.id, "title": task.title, "worker": worker, "project": task.project or None,
        "parent": task.parent or None, "model": None, "effort": None, "repo": None, "worktree": None, "branch": None, "resumed_from": None,
        "changes_requested": CHANGES_REQUESTED in task.labels, "github": None, "note": None,
    }
    if isinstance(chosen, Route):
        report |= {"model": chosen.model, "effort": chosen.effort}
    if task.project:
        entry = registry.get(task.project)
        repo: Path | str = entry.path if entry else f"{task.project} is not registered on this machine"
    else:
        repo = code_repo(cwd, board.path, board.shared)
    match repo:
        case Path():
            path, resumed = make_worktree(repo, task, worker, board.path)
            report |= {"repo": str(repo), "worktree": str(path), "branch": task.branch or branch_name(task), "resumed_from": resumed,
                       "github": _github(repo)}
        case str() as why:
            report["note"] = f"on the board only: {why}, so no worktree was made"
    return report


def _github(repo: Path) -> str | None:
    """`owner/name` when a pull request can be opened from this machine with gh: gh is installed (or
    $ASDLC_GH names it; an empty one means none) and the repository's origin is on GitHub. Agents read
    it from the claim instead of probing for gh, which fails when it is missing."""
    gh = os.environ.get("ASDLC_GH", shutil.which("gh") or "")
    return pull_request_repo(gh, origin_url(repo) if gh else None)


def pull_request_repo(gh: str, origin: str | None) -> str | None:
    """`owner/name` for `gh pr create --repo` when there is a gh to run and the origin is on GitHub, else None."""
    return github_repo(origin) if gh and origin else None


def _claim_lines(report: Mapping[str, object]) -> list[str]:
    model = f" ({report['model']}, {report['effort']})" if report["model"] else ""
    head = f"claimed {report['task']} for @{report['worker']}{model}"
    if report["resumed_from"]:
        head += f", resuming {report['branch']} from {report['resumed_from']}"
    if report["changes_requested"]:
        head += "; a review asked for changes: the findings are in its newest 'Review by' comment"
    return [head, str(report["worktree"])] if report["worktree"] else [f"{head} {report['note']}"]


def _attempt[R](command: str, worker: str, task_id: str, claiming: Callable[[], R]) -> R:
    """Run one claim of a task or a review, and record how it went in the event log.

    Raises:
        AsdlcError: the claim was refused; it is recorded first.
    """
    try:
        result = claiming()
    except AsdlcError as error:
        _record(command, worker, task_id, Attempt.REFUSED, str(error))
        raise
    match result:
        case Taken(reason=reason, lost=lost):
            _record(command, worker, task_id, Attempt.LOST if lost else Attempt.REFUSED, reason)
        case _:
            _record(command, worker, task_id, Attempt.CLAIMED, "")
    return result


def claim(board: Board, raw_id: str, worker: str, cwd: Path, as_json: bool) -> int:
    registry = _registry()
    task_id = normalise_id(raw_id, _prefix(board))
    match _attempt("claim", worker, task_id, lambda: _claim_on_board(board, task_id, worker, registry)):
        case Claimed(task=task):
            report = _claim_report(board, task, worker, cwd, registry)
            _emit(report, as_json, _claim_lines(report))
            return 0
        case Taken(reason=reason):
            _say(reason)
            if as_json:
                print(json.dumps({"claimed": False, "task": task_id, "reason": reason}))
            return 1


def next_task(board: Board, worker: str, engineer: str, cwd: Path, as_json: bool) -> int:
    """Claim the best task this worker may take, trying the next one when another agent wins."""
    origin = _refresh(board)
    prefs, registry = _prefs(board, engineer), _registry()
    picker = Picker(engineer, worker, frozenset(registry), prefs.prefer, prefs.avoid)
    tried: set[str] = set()
    reported: list[str] = []
    while True:
        tasks = _tasks(board, origin)
        ready, skipped = candidates(tasks, picker)
        if not tried:
            reported = [why for _, why in skipped]
            for why in reported:
                _say(f"skipped {why}")
        remaining = [task for task in ready if task.id not in tried]
        if not remaining:
            _emit({"claimed": False, "reason": "no work available", "skipped": reported}, as_json, ["no work available"])
            return 0
        waiting = _waiting_reviews(board, origin, tasks, engineer, datetime.now(UTC)) if prefs.review else ()
        if reason := build_refusal(prefs.workers, busy(tasks, engineer), len(review_claims(tasks, engineer)), waiting, engineer):
            _record("next", worker, None, Attempt.REFUSED, reason)
            _emit({"claimed": False, "reason": reason, "skipped": reported}, as_json, [f"no work available: {reason}"])
            return 0
        tried.add(remaining[0].id)
        match _attempt("next", worker, remaining[0].id, lambda: _claim_on_board(board, remaining[0].id, worker, registry)):
            case Claimed(task=task):
                report = _claim_report(board, task, worker, cwd, registry)
                _emit(report, as_json, _claim_lines(report))
                return 0
            case Taken(reason=reason):
                _say(reason)


def release(board: Board, raw_id: str, worker: str, cwd: Path) -> None:
    """Hand back the worker's own In Progress task (To Do, still reserved for any person it was
    reserved for), or the review claim a reviewer holds.

    Raises:
        AsdlcError: the worker holds neither, or the change can't be pushed.
    """
    asked = normalise_id(raw_id, _prefix(board))
    task_id = asked

    def step(attempt: int) -> tuple[str | None, str]:
        nonlocal task_id
        task, _ = held_item(_items(board), asked, worker)
        task_id = task.id if task is not None else asked
        if task is not None and task.reviewer == worker:
            _write_key(board, task, REVIEWER_KEY, None)
            _write_key(board, task, REVIEW_KIND_KEY, None)
            _comment(board, task, f"@{worker} released its review claim on {task_id}; another reviewer may claim it with asdlc review-next.", f"@{worker}")
            return f"Release the review of {task_id} from @{worker}", f"released the review claim on {task_id}; it is still {task.status}, and another reviewer may take it"
        if task is None or f"@{worker}" not in task.assignees or not is_status(task, IN_PROGRESS):
            held = "is not on the board" if task is None else f"is {task.status}, assigned to {', '.join(task.assignees) or 'nobody'}"
            raise AsdlcError(f"{task_id} {held}; only @{worker}'s own In Progress task can be released by @{worker}")
        kept = kept_on_release(task)
        done = _board_backlog(board, ["task", "edit", task_id, "-s", TO_DO, "-a", ",".join(kept)])
        if done.returncode != 0:
            raise AsdlcError(f"backlog could not release {task_id}: {(done.stderr or done.stdout).strip()}")
        if author := reserved_author(task):
            _write_key(board, task, RESERVED_KEY, author)
        held_by = f"reserved for {', '.join(kept)}" if kept else "with no assignee"
        return f"Release {task_id} from @{worker}", f"released {task_id}; it is {TO_DO} {held_by}"

    print(_transact(board, step))
    task = _find(_items(board), task_id)
    entry = _registry().get(task.project) if task is not None and task.project else None
    repo = entry.path if entry else code_repo(cwd, board.path, board.shared)
    if isinstance(repo, Path) and (path := worktree_path(repo, task_id)).exists():
        print(f"its worktree is left as it was: {path}")


# --- review --------------------------------------------------------------------------------


def _entered_review(board: Board, ref: str, tasks: Iterable[Task]) -> dict[str, datetime]:
    """When each task last entered In Review: the newest commit on `ref` whose diff adds or
    removes its `status: In Review` line. The task is In Review now, so that commit added it."""
    entered: dict[str, datetime] = {}
    for task in tasks:
        found = _board_git(board, "-c", "core.quotePath=false", "log", "-1", "--format=%ct", "-G", f"^status: ['\"]?{IN_REVIEW}['\"]?$",
                           ref, "--", task.path, check=False).stdout.strip()
        if found.isdigit():
            entered[task.path] = datetime.fromtimestamp(int(found), UTC)
    return entered


@dataclass(frozen=True)
class ReviewClaimed:
    task: Task
    waited: timedelta


def _claim_review(board: Board, task_id: str, reviewing: Reviewing) -> ReviewClaimed | Taken:
    """Claim one task's review: the reviewer and the kind of review written on the task, and a comment, pushed.

    Raises:
        AsdlcError: backlog failed, or the claim could not be pushed. A claim that isn't pushed is undone.
    """
    def step(attempt: int) -> tuple[str | None, ReviewClaimed | Taken]:
        task = _find(_tasks(board), task_id)
        if task is None:
            return None, Taken(f"{task_id} is no longer on the board")
        entered = _entered_review(board, "HEAD", (task,)).get(task.path)
        waited = _waited(entered, reviewing.now)
        if task.reviewer == reviewing.reviewer:
            return None, ReviewClaimed(task, waited)
        if refusal := review_refusal(task, reviewing, entered):
            lost = bool(attempt > 1 and task.reviewer)
            return None, Taken(f"Another reviewer claimed the review of {task_id} first: @{task.reviewer}" if lost else refusal, lost=lost)
        kind = review_kind(task, reviewing.engineer)
        _write_key(board, task, REVIEWER_KEY, reviewing.reviewer)
        _write_key(board, task, REVIEW_KIND_KEY, str(kind))
        why = (f"a same-machine review: it waited {human(waited)} with no other engineer's reviewer, longer than review_fallback_after "
               f"({human(reviewing.fallback_after)}), so a fresh reviewer on its author's machine takes it" if kind is ReviewKind.SAME_MACHINE
               else "a cross-machine review")
        _comment(board, task, f"@{reviewing.reviewer} is reviewing {task_id}: {why}.", f"@{reviewing.reviewer}")
        claimed = replace(task, reviewer=reviewing.reviewer, review_kind=str(kind))
        return f"Review {task_id}: @{reviewing.reviewer} ({kind})", ReviewClaimed(claimed, waited)

    return _transact(board, step)


def review_policies(board: Path, project: str) -> list[str]:
    """The review policies in the tasks repository that apply to a task: the team's, then its repository plugin's."""
    found = [board / "plugins" / "team" / "review.md", *([board / "plugins" / project / "review.md"] if project else [])]
    return [str(path) for path in found if path.is_file()]


def _review_report(board: Board, claimed: ReviewClaimed, registry: Mapping[str, Registered]) -> dict[str, object]:
    task = claimed.task
    branch, pull = review_refs(task.references)
    entry = registry.get(task.project)
    return {
        "claimed": True, "task": task.id, "title": task.title, "reviewer": task.reviewer, "kind": task.review_kind,
        "authors": sorted(authors(task)), "project": task.project, "parent": task.parent or None,
        "repo": str(entry.path) if entry else None, "default_branch": default_branch(entry.path) if entry else None,
        "branch": branch, "pull_request": pull, "github": _github(entry.path) if entry else None,
        "references": list(task.references), "waited": human(claimed.waited),
        "model": REVIEW.model, "effort": REVIEW.effort, "route": REVIEW.reason, "policies": review_policies(board.path, task.project),
    }


def review_next(board: Board, reviewer: str, engineer: str, now: datetime, fallback: bool, as_json: bool) -> int:
    """Claim the review that has waited longest among those this reviewer may take."""
    origin = _refresh(board)
    prefs, settings, registry = _prefs(board, engineer), _settings(board), _registry()
    if not (board.path / "plugins" / "team" / "review.md").is_file():
        raise AsdlcError(f"the tasks repository has no plugins/team/review.md, the team's review policy, and a review needs one to judge by: "
                         f"run asdlc init-board {board.path} (it adds only missing files), commit and push it, then claim again")
    if not prefs.review:
        reason = f"devs/{engineer}.yaml has review: false, so {engineer}'s orchestrator takes no reviews"
        _emit({"claimed": False, "reason": reason, "skipped": []}, as_json, [f"no review available: {reason}"])
        return 0
    reviewing = Reviewing(engineer, reviewer, frozenset(registry), now, settings.review_fallback_after, fallback)
    tried: set[str] = set()
    reported: list[str] = []
    while True:
        tasks = _tasks(board, origin)
        waiting = [t for t in tasks if is_status(t, IN_REVIEW) and not t.reviewer]
        ready, skipped = review_candidates(tasks, reviewing, _entered_review(board, origin, waiting))
        if not tried:
            reported = [why for _, why in skipped]
            for why in reported:
                _say(f"skipped {why}")
        remaining = [task for task in ready if task.id not in tried]
        if not remaining:
            _emit({"claimed": False, "reason": "no review available", "skipped": reported}, as_json, ["no review available"])
            return 0
        if (held := busy(tasks, engineer)) >= prefs.workers:
            reason = f"{engineer}'s workers and reviewers hold {held} task(s), the cap in devs/{engineer}.yaml ({prefs.workers})"
            _record("review-next", reviewer, None, Attempt.REFUSED, reason)
            _emit({"claimed": False, "reason": reason, "skipped": reported}, as_json, [f"no review available: {reason}"])
            return 0
        tried.add(remaining[0].id)
        match _attempt("review-next", reviewer, remaining[0].id, lambda: _claim_review(board, remaining[0].id, reviewing)):
            case ReviewClaimed() as claimed:
                report = _review_report(board, claimed, registry)
                _emit(report, as_json, [
                    f"claimed the review of {report['task']} for @{reviewer} ({report['kind']}; {REVIEW.model}, {REVIEW.effort})",
                    f"branch {report['branch'] or '-'}, pull request {report['pull_request'] or '-'}",
                    str(report["repo"]),
                ])
                return 0
            case Taken(reason=reason):
                _say(reason)


def earlier_citations(tasks: Iterable[Task], task_id: str, policies: Sequence[str]) -> dict[str, tuple[str, ...]]:
    """For each policy a verdict cites, the other tasks whose last review cited it too.

    A mistake flagged twice gets its correction written into the agents' rules (playbook
    plays 04 and 09, R10). Whether two findings are the same mistake is the reviewer's
    judgement; this only finds where to look.
    """
    found = {policy: tuple(sorted((t.id for t in tasks if t.id != task_id and policy in t.review_policies), key=id_key))
             for policy in policies}
    return {policy: ids for policy, ids in found.items() if ids}


def review_done(board: Board, raw_id: str, reviewer: str, verdict: ReviewVerdict, notes: str, record: ReviewRecord) -> dict[str, object]:
    """Record a review's findings on the task and act on the verdict: changes send it back to
    In Progress for the author's worker, clean leaves it In Review for a person to merge. The
    findings' counts, the policies they cite and whether the diff matched the plan are written
    on the task for asdlc stats.

    Raises:
        AsdlcError: no notes, counts that don't fit the verdict, the reviewer doesn't hold the review,
            backlog failed, or the change could not be pushed.
    """
    if not notes.strip():
        raise AsdlcError("say what the review found in --notes, even when it is 'No findings'")
    if refusal := review_record_refusal(verdict, record):
        raise AsdlcError(refusal)
    task_id = normalise_id(raw_id, _prefix(board))

    def step(attempt: int) -> tuple[str | None, dict[str, object]]:
        task = _find(_tasks(board), task_id)
        if refusal := review_done_refusal(task, task_id, reviewer):
            raise AsdlcError(refusal)
        assert task is not None
        edit = ["task", "edit", task_id, "--comment", review_comment(reviewer, task.review_kind, verdict, notes, record), "--comment-author", f"@{reviewer}"]
        match verdict:
            case ReviewVerdict.CHANGES:
                edit += ["-s", IN_PROGRESS, "--add-label", CHANGES_REQUESTED, *(["--remove-label", REVIEW_PASSED] if REVIEW_PASSED in task.labels else [])]
            case ReviewVerdict.CLEAN:
                edit += ["--add-label", REVIEW_PASSED, *(["--remove-label", CHANGES_REQUESTED] if CHANGES_REQUESTED in task.labels else [])]
            case _ as unreachable:
                assert_never(unreachable)
        done = _board_backlog(board, edit)
        if done.returncode != 0:
            raise AsdlcError(f"backlog could not record the review of {task_id}: {(done.stderr or done.stdout).strip()}")
        after = _find(_tasks(board), task_id) or task
        _write_key(board, after, REVIEWER_KEY, None)
        _write_key(board, after, FINDINGS_KEY, yaml_quoted(f"important={record.important},nit={record.nit}"))
        _write_key(board, after, POLICIES_KEY, json.dumps(list(record.policies)) if record.policies else None)
        _write_key(board, after, PLAN_MATCHED_KEY, "yes" if record.plan_matched else "no")
        repeats = earlier_citations(_tasks(board, folders=("tasks", "completed")), task_id, record.policies)
        result = {"task": task_id, "verdict": str(verdict), "reviewer": reviewer, "kind": task.review_kind,
                  "findings": {"important": record.important, "nit": record.nit}, "policies": list(record.policies), "plan_matched": record.plan_matched,
                  "repeats": {policy: list(ids) for policy, ids in repeats.items()},
                  "status": IN_PROGRESS if verdict is ReviewVerdict.CHANGES else IN_REVIEW,
                  "workers": [w.removeprefix("@") for w in workers(task.assignees)]}
        return f"Review {task_id} by @{reviewer}: {verdict}", result

    return _transact(board, step)

# --- the local event log: one line per claim attempt -------------------------------------


class Attempt(StrEnum):
    CLAIMED = "claimed"
    LOST = "lost"  # another agent's push landed first
    REFUSED = "refused"  # asdlc refused it: held, reserved, at the cap, not registered


def event_line(now: datetime, command: str, worker: str, task: str | None, outcome: Attempt, reason: str) -> str:
    """One attempt to claim a task or a review, as a JSON line for the machine's event log."""
    return json.dumps({"time": now.astimezone(UTC).isoformat(timespec="seconds"), "command": command, "engineer": owner_of(worker),
                       "worker": worker, "task": task, "outcome": str(outcome), "reason": reason})


def parse_events(text: str) -> tuple[dict[str, object], ...]:
    """The event log's lines; a line that isn't a JSON object with a time is skipped."""
    found = []
    for line in text.splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict) and isinstance(entry.get("time"), str):
            found.append(entry)
    return tuple(found)


def _events_file() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(base).expanduser() / "asdlc" / "events.jsonl"


def _record(command: str, worker: str, task: str | None, outcome: Attempt, reason: str) -> None:
    """Append one attempt to this machine's event log. A log that can't be written never fails the command."""
    path = _events_file()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a") as handle:
            handle.write(event_line(datetime.now(UTC), command, worker, task, outcome, reason) + "\n")
    except OSError as error:
        _say(f"could not record this attempt in {path}, so asdlc stats won't count it: {error}")


# --- doctor: is this machine ready for the pilot? -----------------------------------------


class Level(StrEnum):
    PASS = "pass"
    WARN = "warn"
    FAIL = "fail"


@dataclass(frozen=True)
class Finding:
    area: str
    level: Level
    message: str  # what was found and, unless it passed, what to do


@dataclass(frozen=True)
class Tool:
    """A program on this machine: where it is, and the first line its version flag printed."""

    path: str | None
    version: str = ""


@dataclass(frozen=True)
class RepoFacts:
    """A registered code repository as found on this machine."""

    slug: str
    path: Path
    registered_board: Path
    exists: bool
    remote_slug: str | None
    board: str  # its local `git config asdlc.board`, "" when unset


@dataclass(frozen=True)
class PluginFacts:
    """What `claude plugin marketplace list --json` and `claude plugin list --json` said."""

    error: str = ""  # why they couldn't be read; empty when they were
    marketplaces: tuple[frozendict[str, object], ...] = ()
    installed: tuple[frozendict[str, object], ...] = ()
    kit_files: frozenset[str] = frozenset()  # files of the installed authoring-kit, relative to its folder


@dataclass(frozen=True)
class PublishedCheck:
    slug: str
    code: int
    output: str


@dataclass(frozen=True)
class Facts:
    """Everything doctor looked at, gathered by the shell; `diagnose` decides what it means."""

    git: Tool
    uv: Tool
    python: tuple[int, int]
    backlog: Tool
    asdlc: Tool
    asdlc_plugin: Tool
    gh: Tool
    gh_signed_in: bool | None
    claude: Tool
    npx: Tool
    engineer: str  # `git config asdlc.engineer`, "" when unset
    board: Path | None
    board_error: str = ""
    devs: str | None = None  # devs/<engineer>.yaml's text
    dirty: str = ""
    shared: bool = True
    branch: str = ""
    origin: str = ""  # origin's URL, "" when there is none
    origin_error: str | None = None  # why origin can't be reached without a prompt; None when it can
    settings: str | None = None  # asdlc.toml's text
    registry_error: str = ""
    repos: tuple[RepoFacts, ...] = ()
    marketplace: str | None = None  # the tasks repository's marketplace name
    plugins: PluginFacts = PluginFacts()
    leftovers: tuple[Path, ...] = ()
    published: tuple[PublishedCheck, ...] = ()
    home: Path = Path("~")
    plugin_commands: tuple[tuple[str, str], ...] = ()  # (slug, commands.toml text) of each registered repository's plugin
    plugin_roots: tuple[Path, ...] = ()  # where the asdlc plugin's scripts are: this script's and the installed plugin's
    team_review_policy: bool = True  # the tasks repository has plugins/team/review.md
    claude_settings: tuple[tuple[str, str], ...] = ()  # (path, text) of each Claude Code settings file that applies in the board clone
    mcp_configs: tuple[tuple[str, str], ...] = ()  # (path, text) of each file that configures MCP servers


AUTHORING_KIT = ("skills/choosing-extension-types/SKILL.md", "skills/authoring-skills/SKILL.md", "skills/authoring-hooks/SKILL.md",
                 "agents/authoring-auditor.md")
_SIGN_IN = "for HTTPS, gh auth login and then gh auth setup-git store a credential git uses without asking; for SSH, load your key into ssh-agent"


def _tool_findings(facts: Facts) -> list[Finding]:
    found = [
        Finding("git", Level.PASS, facts.git.version) if facts.git.path else Finding("git", Level.FAIL, "git is not installed"),
        Finding("uv", Level.PASS, facts.uv.version) if facts.uv.path else
        Finding("uv", Level.FAIL, "uv is not on PATH; the plugin's hooks and scripts run through it: https://docs.astral.sh/uv/"),
        Finding("python", Level.PASS, f"Python {facts.python[0]}.{facts.python[1]} runs asdlc") if facts.python >= (3, 15) else
        Finding("python", Level.FAIL, f"Python {facts.python[0]}.{facts.python[1]} runs asdlc; it needs 3.15: run it with uv run --script"),
    ]
    version = backlog_version(facts.backlog.version)
    minimum = ".".join(map(str, MIN_BACKLOG))
    if not facts.backlog.path:
        found.append(Finding("backlog", Level.FAIL, "the backlog CLI is not installed: npm i -g backlog.md@1.55.2"))
    elif version is None or version < MIN_BACKLOG:
        found.append(Finding("backlog", Level.FAIL, f"backlog {facts.backlog.version or 'of an unknown version'} is older than {minimum}, which drops "
                                                    "asdlc's keys from tasks: npm i -g backlog.md@1.55.2"))
    else:
        found.append(Finding("backlog", Level.PASS, f"backlog {'.'.join(map(str, version))}"))
    for name, tool in (("asdlc", facts.asdlc), ("asdlc-plugin", facts.asdlc_plugin)):
        found.append(Finding(name, Level.PASS, tool.path) if tool.path else
                     Finding(name, Level.FAIL, f"{name} is not on PATH: link the plugin's scripts/{name} onto it (docs/guide.md, Install)"))
    if not facts.gh.path:
        found.append(Finding("gh", Level.WARN, "gh is not installed, so workers can't open pull requests and reviewers can't comment on them: "
                                               "install it, then gh auth login"))
    elif facts.gh_signed_in is False:
        found.append(Finding("gh", Level.WARN, "gh is not signed in: gh auth login, then gh auth setup-git"))
    else:
        found.append(Finding("gh", Level.PASS, facts.gh.version))
    if facts.claude.path:
        found.append(Finding("claude", Level.PASS, f"claude plugin validate runs through {facts.claude.path}"))
    elif facts.npx.path:
        found.append(Finding("claude", Level.PASS, "claude plugin validate runs through npx @anthropic-ai/claude-code"))
    else:
        found.append(Finding("claude", Level.WARN, "neither claude nor npx is on PATH, so asdlc-plugin can't run claude plugin validate"))
    return found


def _identity_findings(facts: Facts) -> list[Finding]:
    if not facts.engineer:
        return [Finding("engineer", Level.FAIL, "asdlc doesn't know who you are: git config --global asdlc.engineer <name>")]
    try:
        name = engineer_name(facts.engineer)
    except AsdlcError as error:
        return [Finding("engineer", Level.FAIL, f"{error}: git config --global asdlc.engineer <name>")]
    found = [Finding("engineer", Level.PASS, f"you are @{name}")]
    if facts.board is None:
        return found
    where = f"devs/{name}.yaml"
    if facts.devs is None:
        return found + [Finding("preferences", Level.FAIL, f"{where} is not in the tasks repository: copy devs/example.yaml to it, set name: {name} "
                                                           "and review, then commit and push it")]
    try:
        prefs = parse_prefs(facts.devs, name)
    except AsdlcError as error:
        return found + [Finding("preferences", Level.FAIL, str(error))]
    if not re.search(r"(?m)^review\s*:", facts.devs):
        return found + [Finding("preferences", Level.FAIL, f"{where} doesn't say whether your orchestrator reviews other engineers' work: "
                                                           "add review: true (or false), then commit and push it")]
    return found + [Finding("preferences", Level.PASS, f"{where}: review {'yes' if prefs.review else 'no'}, workers {prefs.workers}, "
                                                       f"prefer {', '.join(prefs.prefer) or '-'}, avoid {', '.join(prefs.avoid) or '-'}")]


def _board_findings(facts: Facts) -> list[Finding]:
    if facts.board is None:
        return [Finding("board", Level.FAIL, facts.board_error)]
    if not facts.shared:
        return [Finding("board", Level.PASS, f"the board is local, in the repository at {facts.board}: board changes are committed to the branch checked out there and never pushed by asdlc")]
    found = [Finding("board", Level.PASS, f"the tasks repository's clone is {facts.board}")]
    if facts.dirty:
        changed = "; ".join(line.strip() for line in facts.dirty.splitlines())
        found.append(Finding("board", Level.FAIL, f"it has uncommitted changes ({changed}), and asdlc refuses to work over them: commit or remove them"))
    if facts.branch != BOARD_BRANCH:
        found.append(Finding("board", Level.FAIL, f"it is on {facts.branch or 'a detached HEAD'}; asdlc works on {BOARD_BRANCH}: git -C {facts.board} switch {BOARD_BRANCH}"))
    if not facts.origin:
        found.append(Finding("board", Level.FAIL, f"it has no origin remote, so nothing reaches the team: git -C {facts.board} remote add origin <url>"))
    elif facts.origin_error is not None:
        found.append(Finding("board", Level.FAIL, f"origin ({facts.origin}) can't be reached without a prompt, and asdlc pushes every change there: "
                                                  f"{_SIGN_IN}. git said: {facts.origin_error}"))
    else:
        found.append(Finding("board", Level.PASS, f"origin ({facts.origin}) answers without a prompt"))
    return found


def _settings_findings(facts: Facts) -> list[Finding]:
    if facts.board is None:
        return []
    if facts.settings is None and not facts.shared:
        return []  # a local board has no asdlc.toml, which is what makes it local
    if facts.settings is None:
        return [Finding("asdlc.toml", Level.WARN, f"the tasks repository has no asdlc.toml, so the defaults apply "
                                                  f"({human(DEFAULT_REVIEW_FALLBACK_AFTER)} review fallback): asdlc init-board {facts.board} adds it")]
    try:
        settings = parse_settings(facts.settings)
    except AsdlcError as error:
        return [Finding("asdlc.toml", Level.FAIL, str(error))]
    try:
        board_mode(facts.settings)
    except AsdlcError as error:
        return [Finding("asdlc.toml", Level.FAIL, str(error))]
    return [Finding("asdlc.toml", Level.PASS, f"review_fallback_after {human(settings.review_fallback_after)}")]


def _policy_findings(facts: Facts) -> list[Finding]:
    """A board made before the team review policy shipped has none, and reviewers won't review without one."""
    if facts.board is None:
        return []
    if facts.team_review_policy:
        return [Finding("review policy", Level.PASS, "plugins/team/review.md is in the tasks repository")]
    return [Finding("review policy", Level.WARN, f"the tasks repository has no plugins/team/review.md, the team's review policy, so no review can be "
                                                 f"claimed: run asdlc init-board {facts.board} to add it (it adds only missing files), then commit "
                                                 "and push it")]


def _repo_findings(facts: Facts, registry: str) -> list[Finding]:
    if facts.registry_error:
        return [Finding("repositories", Level.FAIL, facts.registry_error)]
    if not facts.repos:
        return [Finding("repositories", Level.WARN, "no code repository is registered on this machine, so asdlc next has nothing to offer: "
                                                    "run asdlc register in a clone of each repository you work in")]
    found = []
    for repo in facts.repos:
        area = f"repository {repo.slug}"
        again = f"run asdlc register in {repo.path}"
        if not repo.exists:
            found.append(Finding(area, Level.FAIL, f"{repo.path} is gone: clone it again and run asdlc register there, or delete its entry in {registry}"))
        elif repo.remote_slug is None:
            found.append(Finding(area, Level.FAIL, f"{repo.path} has no origin remote naming an owner and repository: git remote add origin <url>, then {again}"))
        elif repo.remote_slug != repo.slug:
            found.append(Finding(area, Level.FAIL, f"{repo.path}'s origin is {repo.remote_slug} now, not {repo.slug}: {again}"))
        elif not repo.board:
            found.append(Finding(area, Level.FAIL, f"asdlc.board is not set in {repo.path}, so the guard and the rule loader skip it: {again}"))
        elif Path(repo.board).expanduser().resolve() != repo.registered_board.resolve():
            found.append(Finding(area, Level.WARN, f"{repo.path} points at {repo.board}, but is registered for {repo.registered_board}: {again} --board <the right clone>"))
        else:
            found.append(Finding(area, Level.PASS, f"{repo.path}"))
    return found


def _plugin_findings(facts: Facts) -> list[Finding]:
    plugins = facts.plugins
    if facts.board is not None and facts.marketplace is None:
        return [Finding("marketplace", Level.FAIL, f"the tasks repository has no .claude-plugin/marketplace.json: asdlc init-board {facts.board} adds it")]
    if plugins.error:
        return [Finding("plugins", Level.WARN, f"can't check the installed plugins ({plugins.error}); check them in Claude Code with /plugin: "
                                               "the tasks repository's marketplace with its team plugin, asdlc, and authoring-kit")]
    found = []
    installed = {str(p.get("id", "")): p for p in plugins.installed}

    def enabled(name: str, market: str | None = None) -> frozendict[str, object] | None:
        return next((p for key, p in installed.items() if (key == f"{name}@{market}" if market else key.startswith(f"{name}@")) and p.get("enabled", True)), None)

    if facts.marketplace is not None:
        name = facts.marketplace
        entry = next((m for m in plugins.marketplaces if m.get("name") == name), None)
        if entry is None:
            found.append(Finding("marketplace", Level.FAIL, f"the tasks repository's marketplace, {name}, is not added: claude plugin marketplace add "
                                                            f"{facts.origin or '<its url or owner/repo>'}, then claude plugin install team@{name}"))
        else:
            found.append(Finding("marketplace", Level.PASS, f"{name} is added"))
            if entry.get("autoUpdate") is True:
                found.append(Finding("auto-update", Level.PASS, f"auto-update is on for {name}"))
            else:
                found.append(Finding("auto-update", Level.WARN, f"auto-update is off for {name}, the default for a marketplace you add yourself, so new "
                                                                f"repository plugins reach you only by hand: in Claude Code, /plugin, Marketplaces, {name}, "
                                                                "Enable auto-update. It runs in the background without prompting, so a private repository "
                                                                "needs git credentials that never ask, for example gh auth login and then gh auth setup-git"))
            found.append(Finding("team plugin", Level.PASS, f"team@{name} is installed") if enabled("team", name) else
                         Finding("team plugin", Level.FAIL, f"the team plugin is not installed and enabled: claude plugin install team@{name}"))
    found.append(Finding("asdlc plugin", Level.PASS, "asdlc is installed") if enabled("asdlc") else
                 Finding("asdlc plugin", Level.WARN, "the asdlc plugin is not installed, so no guard or rule loader runs (unless you load it with "
                                                     "--plugin-dir): claude plugin marketplace add bruk-io/asdlc, then claude plugin install asdlc@asdlc"))
    if (kit := enabled("authoring-kit")) is None:
        found.append(Finding("authoring kit", Level.WARN, "authoring-kit is not installed: onboarding works without it but writes rules and skills "
                                                          "unaudited, and says so on the task"))
    elif missing := [path for path in AUTHORING_KIT if path not in plugins.kit_files]:
        found.append(Finding("authoring kit", Level.WARN, f"authoring-kit ({kit.get('version', '?')}) lacks {', '.join(missing)}: update it"))
    else:
        found.append(Finding("authoring kit", Level.PASS, f"authoring-kit {kit.get('version', '')} with choosing-extension-types, authoring-skills, "
                                                          "authoring-hooks and authoring-auditor"))
    return found


def _leftover_findings(facts: Facts) -> list[Finding]:
    found = []
    for path in facts.leftovers:
        repo = path.parent.parent / path.parent.name.removesuffix(".worktrees")
        if path.name.startswith("plugin-"):
            why = f"an onboarding of {path.name.removeprefix('plugin-')} that was never published. If nobody is onboarding it now"
        elif path.name == "asdlc-verify":
            why = "the clean checkout asdlc-plugin verify-command keeps between commands. Once no onboarding of this repository is open"
        else:
            why = "a reviewer's worktree left behind. If no review of that task is running"
        found.append(Finding("leftover", Level.WARN, f"{path}: {why}, remove it: git -C {repo} worktree remove --force {path}"))
    return found


def _published_findings(facts: Facts) -> list[Finding]:
    if facts.board is None:
        return []
    if not facts.published:
        return [Finding("repository plugins", Level.PASS, "none published yet")]
    return [Finding(f"plugin {p.slug}", Level.PASS, "asdlc-plugin check is clean") if p.code == 0 else
            Finding(f"plugin {p.slug}", Level.FAIL, f"asdlc-plugin check found problems; fix them with the onboard-repo skill "
                                                    f"(asdlc-plugin scaffold <repo> opens the plugin again):\n{p.output.strip()}")
            for p in facts.published]


# The Bash commands agents run in normal work, as narrow prefix rules. backlog is read-only
# here: every board change goes through asdlc board.
BASE_RULES = (
    "Bash(asdlc *)", "Bash(asdlc-plugin *)",
    "Bash(backlog task list *)", "Bash(backlog task view *)", "Bash(backlog draft list *)", "Bash(backlog draft view *)",
    "Bash(backlog doc list *)", "Bash(backlog doc view *)", "Bash(backlog search *)",
    "Bash(gh pr create *)", "Bash(gh pr view *)", "Bash(gh pr comment *)",
)
# The read-only git a worker or reviewer reaches for to find its way around a repository, allowed in
# task worktrees and the registered clone alike. Agents never `cd` (Claude Code prompts for `cd` with git
# in one line whatever the rules say), so each is written `git -C <path> <subcommand>`.
READ_ONLY_GIT = ("ls-files", "grep", "blame", "cat-file", "ls-tree", "merge-base", "rev-list", "describe", "show-ref", "remote get-url")
# The git subcommands the worker and reviewer agents run in a task's or a review's worktree, as
# `git -C <worktree> ...`. The board guard refuses pushes to a default branch and force pushes.
WORKTREE_GIT = ("fetch", "status", "diff", "log", "show", "add", "commit", "push", "rebase", "merge", "switch", "checkout -b",
                "rev-parse", "branch", "symbolic-ref", "mv", "rm", "restore", "stash", "reset", *READ_ONLY_GIT)
# What the reviewer runs in the registered clone itself: reads, and making and removing its review worktree.
CLONE_GIT = ("fetch", "worktree", "show", "rev-parse", "symbolic-ref", *READ_ONLY_GIT)
# Git that runs a program the command doesn't name, or with configuration the command sets. The `*` in the
# allow rules above would let these through, so they are denied, and deny beats allow. The board guard
# refuses the same forms with its reasons; these hold even if the hook isn't loaded. A `*` matches any
# text, spaces included, so a rule can also match a commit message that quotes one of these flags.
GIT_DENY = (
    "Bash(git -c*)", "Bash(git -C * -c*)", "Bash(git --config-env*)", "Bash(git -C * --config-env*)",
    "Bash(git --exec-path=*)", "Bash(git -C * --exec-path=*)",
    "Bash(git *grep* -O*)", "Bash(git *grep* --open-files-in-pager*)",
    "Bash(git * --upload-pack*)", "Bash(git * --receive-pack*)", "Bash(git * --exec*)",
    "Bash(git *clone* -u*)", "Bash(git *ls-remote* -u*)", "Bash(git *clone* -c*)", "Bash(git *clone* --config*)", "Bash(git * --template*)",
    "Bash(git * --ext-diff*)", "Bash(git * --textconv*)", "Bash(git *rebase* -x*)",
    "Bash(git difftool*)", "Bash(git -C * difftool*)", "Bash(git mergetool*)", "Bash(git -C * mergetool*)",
    "Bash(git *submodule* foreach*)", "Bash(git *bisect* run*)", "Bash(git *filter-branch*)", "Bash(git *instaweb*)",
    "Bash(git config *)", "Bash(git -C * config *)",
    # GIT_* set in front of git: an allow rule never matches past such an assignment, so it already prompts;
    # these catch the forms that put the variable after a command word.
    "Bash(env GIT_*)", "Bash(env * GIT_*)", "Bash(export GIT_*)",
)
# A verified command with any of these gets no rule of its own: a rule can't say what it would allow.
_UNSAFE_IN_RULE = (("*", "a * would be a wildcard in the rule"), ("|", "a pipe"), (";", "a ;"), ("&&", "&&"), ("||", "||"),
                   ("`", "a backtick"), ("$(", "a command substitution"), (">", "a redirect"), ("<", "a redirect"), ("\n", "a line break"))


@dataclass(frozen=True)
class Rules:
    """The Claude Code permissions the pilot needs on this machine: allow rules, folders to add, and
    the verified commands left out, each with why."""

    allow: tuple[str, ...]
    directories: tuple[str, ...]
    skipped: tuple[tuple[str, str, str, str], ...] = ()  # (slug, command name, run line, why)
    deny: tuple[str, ...] = GIT_DENY

    def as_settings(self) -> dict[str, list[str]]:
        return {"allow": list(self.allow), "deny": list(self.deny), "additionalDirectories": list(self.directories)}


def unsafe_in_rule(run: str) -> str | None:
    """Why a run line can't be an exact allow rule, or None."""
    return next((f"it has {why}" for token, why in _UNSAFE_IN_RULE if token in run), None)


def permission_rules(repos: Sequence[tuple[str, Path]], board: Path | None, commands: Mapping[str, str], roots: Sequence[Path] = ()) -> Rules:
    """The allow rules and folders for normal work: asdlc's own commands (by name, by the plugin's
    absolute path, and through `uv run --script`), backlog's reads, the git subcommands agents use in
    worktrees and registered clones, gh for pull requests, each registered repository's simple
    verified commands, and edits in the worktrees beside each registered clone and the tasks clone."""
    allow = list(BASE_RULES)
    for root in roots:
        for script in ("asdlc", "asdlc-plugin"):
            allow += [f"Bash({root}/scripts/{script} *)", f"Bash(uv run --script {root}/scripts/{script} *)"]
    skipped = []
    for slug, path in repos:
        worktrees = f"{path}.worktrees"
        # Each subcommand twice: a trailing " *" matches the bare command only when it is the rule's
        # one wildcard, and these have two, so `git -C <worktree> status` needs a rule of its own.
        allow += [rule for sub in WORKTREE_GIT for rule in (f"Bash(git -C {worktrees}/* {sub} *)", f"Bash(git -C {worktrees}/* {sub})")]
        allow += [rule for sub in CLONE_GIT for rule in (f"Bash(git -C {path} {sub} *)", f"Bash(git -C {path} {sub})")]
        try:
            tables = tomllib.loads(commands.get(slug, ""))
        except tomllib.TOMLDecodeError:
            continue
        for name, table in tables.items():
            if isinstance(table, dict) and isinstance(run := table.get("run"), str) and run.strip():
                if why := unsafe_in_rule(run.strip()):
                    skipped.append((slug, name, run.strip(), why))
                else:
                    allow.append(f"Bash({run.strip()})")
    folders = [f"{path}.worktrees" for _, path in repos] + ([f"{board}.worktrees"] if board else [])
    allow += [f"Edit(/{folder}/**)" for folder in folders]
    return Rules(tuple(dict.fromkeys(allow)), tuple(dict.fromkeys(folders)), tuple(skipped))


def merge_permissions(settings: object, rules: Rules) -> tuple[dict[str, object], list[str]]:
    """The settings with the rules' allow entries and folders added where missing, everything else
    kept as it was, and what was added. The input is not changed.

    Raises:
        AsdlcError: the settings aren't an object, or their permissions, allow or additionalDirectories have the wrong shape.
    """
    if not isinstance(settings, dict):
        raise AsdlcError("the settings file is not a JSON object of settings; nothing was changed")
    merged = json.loads(json.dumps(settings))
    permissions = merged.setdefault("permissions", {})
    if not isinstance(permissions, dict):
        raise AsdlcError(f"its permissions is {json.dumps(permissions)}, not an object: fix it (or remove it), then run asdlc permissions --write again")
    added = []
    for key, wanted in (("allow", rules.allow), ("deny", rules.deny), ("additionalDirectories", rules.directories)):
        present = permissions.setdefault(key, [])
        if not isinstance(present, list) or not all(isinstance(entry, str) for entry in present):
            raise AsdlcError(f"its permissions.{key} is {json.dumps(present)}, not a list of strings: fix it, then run asdlc permissions --write again")
        for entry in wanted:
            if entry not in present:
                present.append(entry)
                added.append(entry)
    return merged, added


def _bash_prefix(rule: str) -> str | None:
    """The command prefix a Bash allow rule approves ("" for every command), or None when it isn't a prefix rule."""
    found = re.fullmatch(r"Bash(?:\((.*)\))?", rule.strip())
    if not found:
        return None
    inner = (found[1] or "").strip()
    if inner in ("", "*"):
        return ""
    for suffix in (":*", " *"):
        if inner.endswith(suffix) and "*" not in inner[:-len(suffix)]:
            return inner[:-len(suffix)].strip()
    return None


def allows_command(rules: Iterable[str], command: str) -> bool:
    """Whether an allow rule approves the command: an exact rule for it, or a prefix rule it starts with."""
    rules = list(rules)
    return f"Bash({command})" in rules or any(
        (prefix := _bash_prefix(rule)) is not None and (prefix == "" or command == prefix or command.startswith(prefix + " ")) for rule in rules)


def _glob(pattern: str) -> re.Pattern[str]:
    out, index = "", 0
    while index < len(pattern):
        if pattern.startswith("**", index):
            out, index = out + ".*", index + 2
        elif pattern[index] == "*":
            out, index = out + "[^/]*", index + 1
        elif pattern[index] == "?":
            out, index = out + "[^/]", index + 1
        else:
            out, index = out + re.escape(pattern[index]), index + 1
    return re.compile(out)


def allows_edit(rules: Iterable[str], path: str, home: Path) -> bool:
    """Whether an Edit allow rule anchored at the root (//) or the home folder (~/) covers the path."""
    for rule in rules:
        found = re.fullmatch(r"Edit(?:\((.*)\))?", rule.strip())
        if not found:
            continue
        pattern = (found[1] or "").strip()
        if pattern in ("", "*", "**", "//**"):
            return True
        if pattern.startswith("//"):
            pattern = pattern[1:]
        elif pattern.startswith("~/"):
            pattern = f"{home}{pattern[1:]}"
        else:
            continue
        if _glob(pattern).fullmatch(path):
            return True
    return False


def _under(path: str, folders: Iterable[str], home: Path) -> bool:
    for folder in folders:
        expanded = f"{home}{folder[1:]}" if folder == "~" or folder.startswith("~/") else folder
        if path == expanded.rstrip("/") or path.startswith(expanded.rstrip("/") + "/"):
            return True
    return False


def missing_permissions(settings: Sequence[tuple[str, str]], rules: Rules, home: Path) -> tuple[list[str], list[str]]:
    """The needed rules and folders the settings files don't cover yet, and the files that aren't valid JSON."""
    allow: list[str] = []
    deny: list[str] = []
    folders: list[str] = []
    modes: set[str] = set()
    broken = []
    for where, text in settings:
        try:
            data = json.loads(text)
        except ValueError:
            broken.append(where)
            continue
        permissions = data.get("permissions", {}) if isinstance(data, dict) else {}
        if isinstance(permissions, dict):
            allow += [r for r in permissions.get("allow", []) if isinstance(r, str)]
            deny += [r for r in permissions.get("deny", []) if isinstance(r, str)]
            folders += [d for d in permissions.get("additionalDirectories", []) if isinstance(d, str)]
            modes.add(str(permissions.get("defaultMode", "")))
    missing = [rule for rule in rules.deny if rule not in deny]  # deny rules hold in every mode
    if "bypassPermissions" in modes:
        return missing, broken
    for rule in rules.allow:
        if rule in allow:
            covered = True
        elif rule.startswith("Bash("):
            covered = allows_command(allow, rule[5:-1].removesuffix(" *"))
        else:
            covered = "acceptEdits" in modes or rule in allow or allows_edit(allow, f"{rule[6:-4]}/task-1/file", home)
        if not covered:
            missing.append(rule)
    missing += [folder for folder in rules.directories if not _under(folder, folders, home)]
    return missing, broken


def _permission_findings(facts: Facts) -> list[Finding]:
    """I10: no permission prompts during normal work, so the allow rules asdlc permissions writes must be there."""
    rules = permission_rules([(r.slug, r.path) for r in facts.repos if r.exists], facts.board, dict(facts.plugin_commands), facts.plugin_roots)
    missing, broken = missing_permissions(facts.claude_settings, rules, facts.home)
    found = [Finding("permissions", Level.WARN, f"{where} is not valid JSON, so Claude Code ignores it: fix it") for where in broken]
    if missing:
        return found + [Finding("permissions", Level.WARN, f"agents will stop at permission prompts, or run git with options no rule should let through: "
                                                           f"the settings that apply in the tasks clone don't have {', '.join(missing)}. Run asdlc permissions --write in your own terminal: it adds them "
                                                           "to the tasks clone's .claude/settings.local.json, keeping what is there and backing it up first")]
    return found + [Finding("permissions", Level.PASS, f"the {len(rules.allow)} allow rules, {len(rules.deny)} deny rules and {len(rules.directories)} folders normal work needs are set")]


def _mcp_findings(facts: Facts) -> list[Finding]:
    """I8: asdlc works through the backlog CLI only; a Backlog.md MCP server bypasses the board's rules."""
    found = []
    for where, text in facts.mcp_configs:
        try:
            data = json.loads(text)
        except ValueError:
            continue
        if not isinstance(data, dict):
            continue
        servers = [data.get("mcpServers", {})] + [p.get("mcpServers", {}) for p in (data.get("projects") or {}).values() if isinstance(p, dict)]
        for group in servers:
            for name, config in (group.items() if isinstance(group, dict) else ()):
                if "backlog" in f"{name} {json.dumps(config)}".casefold():
                    found.append(Finding("backlog mcp", Level.WARN, f"the MCP server {name} in {where} is Backlog.md's. asdlc works through "
                                                                    "the backlog CLI only: the MCP server writes the board without committing or "
                                                                    "pushing and bypasses the board's rules, the guard's included. Remove it: "
                                                                    f"claude mcp remove {name}"))
    return found


def diagnose(facts: Facts, registry: str = "the registry") -> tuple[Finding, ...]:
    """Every finding about this machine, in the order a person fixes them."""
    return (*_tool_findings(facts), *_identity_findings(facts), *_board_findings(facts), *_settings_findings(facts), *_policy_findings(facts),
            *_repo_findings(facts, registry), *_plugin_findings(facts), *_permission_findings(facts), *_mcp_findings(facts),
            *_leftover_findings(facts), *_published_findings(facts))


def doctor_lines(findings: Sequence[Finding]) -> list[str]:
    counts = Counter(f.level for f in findings)
    lines = [f"{str(f.level).upper() if f.level is Level.FAIL else f.level}  {f.area}: {f.message}" for f in findings]
    return lines + [f"{counts[Level.PASS]} passed, {counts[Level.WARN]} warning(s), {counts[Level.FAIL]} failed"]


def _tool(name: str, *version: str, binary: str | None = None) -> Tool:
    path = shutil.which(binary or name)
    if path is None:
        return Tool(None)
    try:
        done = subprocess.run([path, *version], capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return Tool(path)
    return Tool(path, next((line.strip() for line in (done.stdout + done.stderr).splitlines() if line.strip()), ""))


def _claude_json(claude: str, *args: str) -> object:
    """Raises: AsdlcError: claude failed or printed something other than JSON."""
    try:
        done = subprocess.run([claude, *args], capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise AsdlcError(f"claude {' '.join(args)} did not finish: {error}") from None
    try:
        return json.loads(done.stdout)
    except ValueError:
        raise AsdlcError(f"claude {' '.join(args)} exited {done.returncode}: {(done.stderr or done.stdout).strip()[:200]}") from None


def _plugin_facts(claude: str | None) -> PluginFacts:
    if claude is None:
        return PluginFacts(error="claude is not on PATH")
    try:
        markets, installed = _claude_json(claude, "plugin", "marketplace", "list", "--json"), _claude_json(claude, "plugin", "list", "--json")
    except AsdlcError as error:
        return PluginFacts(error=str(error))
    as_rows = lambda found: tuple(frozendict(row) for row in found if isinstance(row, dict)) if isinstance(found, list) else ()  # noqa: E731
    rows = as_rows(installed)
    kit = next((row for row in rows if str(row.get("id", "")).startswith("authoring-kit@")), None)
    folder = Path(str(kit.get("installPath", ""))) if kit else None
    files = frozenset(p.relative_to(folder).as_posix() for p in folder.rglob("*") if p.is_file()) if folder and folder.is_dir() else frozenset()
    return PluginFacts(marketplaces=as_rows(markets), installed=rows, kit_files=files)


def _reachable(board: Path) -> str | None:
    """None when origin answers without a prompt, else what git said."""
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0", "GIT_ASKPASS": "", "SSH_ASKPASS": ""}
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes")
    try:
        done = subprocess.run(["git", "-C", str(board), "ls-remote", "--heads", "origin", BOARD_BRANCH], capture_output=True, text=True,
                              timeout=60, env=env, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return "no answer within 60s"
    return None if done.returncode == 0 else (done.stderr.strip().splitlines() or [f"exit {done.returncode}"])[-1]


def _repo_facts(entry: Registered) -> RepoFacts:
    exists = (entry.path / ".git").exists()
    board = _git(entry.path, "config", "--local", "--get", "asdlc.board").stdout.strip() if exists else ""
    return RepoFacts(entry.slug, entry.path, entry.board, exists, slug_of(entry.path) if exists else None, board)


def _leftovers(board: Path | None, repos: Iterable[RepoFacts]) -> tuple[Path, ...]:
    found = sorted((board.parent / f"{board.name}.worktrees").glob("plugin-*")) if board else []
    for repo in repos:
        beside = repo.path.parent / f"{repo.path.name}.worktrees"
        found += [p for p in [beside / "asdlc-verify"] if p.is_dir()] + sorted(p for p in beside.glob("review-*") if p.is_dir())
    return tuple(found)


def _published(board: Path, repos: Sequence[RepoFacts]) -> tuple[PublishedCheck, ...]:
    """`asdlc-plugin check` on every repository plugin in the clone, against the repository's files when it is cloned here."""
    script = Path(__file__).resolve().parent / "asdlc-plugin"
    where = {repo.slug: repo.path for repo in repos if repo.exists}
    checks = []
    for folder in sorted((board / "plugins").iterdir()) if (board / "plugins").is_dir() else ():
        if folder.name == "team" or not (folder / ".claude-plugin" / "plugin.json").is_file():
            continue
        command = [sys.executable, str(script), "--board", str(board), "check", folder.name]
        command += ["--repo", str(where[folder.name])] if folder.name in where else []
        done = subprocess.run(command, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        checks.append(PublishedCheck(folder.name, done.returncode, (done.stdout + done.stderr).strip()))
    return tuple(checks)


def _claude_files(board: Path | None) -> tuple[tuple[tuple[str, str], ...], tuple[tuple[str, str], ...]]:
    """The Claude Code settings files that apply in a session in the board clone, and the files that configure MCP servers."""
    config = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude").expanduser()
    user_json = config / ".claude.json" if os.environ.get("CLAUDE_CONFIG_DIR") else Path.home() / ".claude.json"
    settings = [config / "settings.json", *([board / ".claude" / "settings.json", board / ".claude" / "settings.local.json"] if board else [])]
    mcp = [user_json, *([board / ".mcp.json"] if board else [])]
    read = lambda paths: tuple((str(p), p.read_text()) for p in paths if p.is_file())  # noqa: E731
    return read(settings), read(mcp)


def gather(explicit_board: str | None, cwd: Path) -> Facts:
    """Look at this machine without changing anything."""
    engineer = _git(cwd, "config", "--get", "asdlc.engineer").stdout.strip()
    claude = (os.environ.get("ASDLC_CLAUDE") or "").strip() or shutil.which("claude")
    facts = Facts(
        git=_tool("git", "--version"), uv=_tool("uv", "--version"), python=sys.version_info[:2],
        backlog=_tool("backlog", "--version", binary=_backlog_binary()), asdlc=_tool("asdlc"), asdlc_plugin=_tool("asdlc-plugin"),
        gh=_tool("gh", "--version"), gh_signed_in=None, claude=Tool(claude), npx=_tool("npx"), engineer=engineer, board=None,
    )
    claude_settings, mcp_configs = _claude_files(None)
    facts = replace(facts, home=Path.home(), claude_settings=claude_settings, mcp_configs=mcp_configs)
    if facts.gh.path:
        try:
            signed = subprocess.run([facts.gh.path, "auth", "status"], capture_output=True, timeout=30, stdin=subprocess.DEVNULL).returncode == 0
        except subprocess.TimeoutExpired:
            signed = None
        facts = replace(facts, gh_signed_in=signed)
    try:
        registry = _registry()
        facts = replace(facts, repos=tuple(_repo_facts(entry) for entry in sorted(registry.values(), key=lambda e: e.slug)))
    except AsdlcError as error:
        facts = replace(facts, registry_error=str(error))
    try:
        board = resolve_board(explicit_board, cwd)
    except AsdlcError as error:
        return replace(facts, board_error=str(error), plugins=_plugin_facts(claude), leftovers=_leftovers(None, facts.repos))
    read = lambda path: path.read_text() if path.is_file() else None  # noqa: E731
    origin = _git(board, "remote", "get-url", "origin")
    market = read(board / ".claude-plugin" / "marketplace.json")
    try:
        name = json.loads(market).get("name") if market else None
    except (ValueError, AttributeError):
        name = None
    claude_settings, mcp_configs = _claude_files(board)
    commands = tuple((r.slug, text) for r in facts.repos if (text := read(board / "plugins" / r.slug / "commands.toml")) is not None)
    plugins = _plugin_facts(claude)
    return replace(
        facts, board=board, claude_settings=claude_settings, mcp_configs=mcp_configs, plugin_commands=commands, plugin_roots=_plugin_roots(plugins),
        devs=read(board / "devs" / f"{engineer.removeprefix('@')}.yaml") if engineer else None,
        dirty=_git(board, "status", "--porcelain", "--untracked-files=no").stdout.strip(),
        shared=open_board(board).shared,
        branch=_git(board, "branch", "--show-current").stdout.strip(),
        origin=origin.stdout.strip() if origin.returncode == 0 else "",
        origin_error=_reachable(board) if origin.returncode == 0 else None,
        settings=read(board / "asdlc.toml"), marketplace=name if isinstance(name, str) else None,
        team_review_policy=(board / "plugins" / "team" / "review.md").is_file(),
        plugins=plugins, leftovers=_leftovers(board, facts.repos), published=_published(board, facts.repos),
    )


def _plugin_roots(plugins: PluginFacts) -> tuple[Path, ...]:
    """This script's plugin folder and, when Claude Code lists it, the installed asdlc plugin's."""
    installed = [Path(str(row.get("installPath"))) for row in plugins.installed if str(row.get("id", "")).startswith("asdlc@") and row.get("installPath")]
    return tuple(dict.fromkeys([Path(__file__).resolve().parent.parent, *installed]))


LOCAL_SETTINGS = ".claude/settings.local.json"


def _write_atomically(target: Path, text: str) -> None:
    """Write through a temporary file in the same folder and a rename, so the file is never half written."""
    temporary = target.with_name(f".{target.name}.{os.getpid()}.tmp")
    try:
        temporary.write_text(text)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)


def permissions(explicit_board: str | None, cwd: Path, write: bool, as_json: bool, now: datetime) -> int:
    """Print the Claude Code allow rules normal work needs on this machine; with `write`, merge them into
    the tasks clone's own `.claude/settings.local.json`, where orchestrator sessions and the workers
    they launch run, keeping everything there, after a backup, and make the additional directories that
    don't exist yet (the first claim makes a repository's worktree folder, after a session has started).

    Raises:
        AsdlcError: no board, the registry or the settings file is unreadable, or the settings file has the wrong shape.
    """
    board = resolve_board(explicit_board, cwd)
    repos = sorted(_registry().values(), key=lambda e: e.slug)
    commands = {e.slug: path.read_text() for e in repos if (path := board / "plugins" / e.slug / "commands.toml").is_file()}
    claude = (os.environ.get("ASDLC_CLAUDE") or "").strip() or shutil.which("claude")
    rules = permission_rules([(e.slug, e.path) for e in repos], board, commands, _plugin_roots(_plugin_facts(claude)))
    target = board / LOCAL_SETTINGS
    skipped = [f"  {slug} {name}: `{run}` ({why}); run it through asdlc record-check, which Bash(asdlc *) allows" for slug, name, run, why in rules.skipped]
    report = {"settings": str(target), "allow": list(rules.allow), "deny": list(rules.deny), "directories": list(rules.directories),
              "skipped": [{"repository": slug, "command": name, "run": run, "why": why} for slug, name, run, why in rules.skipped]}
    if not write:
        _emit(report, as_json, [json.dumps({"permissions": rules.as_settings()}, indent=2), *(["verified commands with no rule of their own:", *skipped] if skipped else []),
                                f"(asdlc permissions --write merges these into {target})"])
        return 0
    text = target.read_text() if target.is_file() else "{}"
    try:
        current = json.loads(text)
    except ValueError:
        raise AsdlcError(f"{target} is not valid JSON, so asdlc won't rewrite it: fix it, then run asdlc permissions --write again") from None
    try:
        merged, added = merge_permissions(current, rules)
    except AsdlcError as error:
        raise AsdlcError(f"{target}: {error}") from None
    exclude = Path(_git(board, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()) / "info" / "exclude"
    if (updated := with_exclude(exclude.read_text() if exclude.exists() else "", f"{LOCAL_SETTINGS}*")) is not None:
        exclude.parent.mkdir(parents=True, exist_ok=True)
        exclude.write_text(updated)  # untracked, so Claude Code applies it as the person's own file
    made = [folder for folder in rules.directories if not Path(folder).is_dir()]
    for folder in made:  # a session leaves out an additional directory missing when it starts, and claims make them later
        Path(folder).mkdir(parents=True, exist_ok=True)
    if made:
        _say("made " + ", ".join(made) + " now, so sessions started before the first claim can read there")
    if not added:
        _emit(report | {"added": []}, as_json, [f"{target} already allows everything normal work needs: nothing to add", *skipped])
        return 0
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.is_file():
        backup = target.with_name(f"{target.name}.{now.strftime('%Y%m%dT%H%M%S')}.bak")
        shutil.copy2(target, backup)
        _say(f"backed up {target} to {backup}")
    _write_atomically(target, json.dumps(merged, indent=2, ensure_ascii=False) + "\n")
    lines = [f"added to {target}:", *(f"  {entry}" for entry in added)]
    _emit(report | {"added": added}, as_json, lines + (["verified commands with no rule of their own:", *skipped] if skipped else []))
    return 0


def doctor(explicit_board: str | None, cwd: Path, as_json: bool) -> int:
    findings = diagnose(gather(explicit_board, cwd), str(_registry_file()))
    failed = sum(f.level is Level.FAIL for f in findings)
    _emit({"findings": [{"area": f.area, "level": str(f.level), "message": f.message} for f in findings],
           "passed": sum(f.level is Level.PASS for f in findings), "warnings": sum(f.level is Level.WARN for f in findings), "failed": failed},
          as_json, doctor_lines(findings))
    return 1 if failed else 0


# --- stats: the playbook's numbers, by stage, from the board's history ----------------------
#
# The core replays the board's history (one Commit per board commit, oldest first) into a
# Ledger: each task's and draft's life, each document's commits, and a Story per task. One
# function per stage reads the Ledger through a Window and returns that stage's metrics, each
# beside the playbook's own name for it. The shell reads git, the event log, the hook decision
# logs and gh, and caches the parsed history by commit in the board clone's ignored .asdlc/.

STATS_CACHE_VERSION = 1  # with Task's fields, the history cache's format; any other cache is rebuilt
STAGES = frozendict({
    "plan": ("Plan", ("01", "10")),
    "design": ("Design", ("02",)),
    "build": ("Build", ("03", "06")),
    "test": ("Test", ("07", "08")),
    "deploy": ("Deploy", ("05", "09", "10")),
    "maintain": ("Maintain", ("12",)),
    "coordination": ("Coordination", ()),
})
NOT_MEASURABLE = (
    ("Change failure rate", "11", "deployment data: which deploys failed or were rolled back, joined to the changes they shipped"),
    ("CI versus production regressions", "11", "incident data: regressions found in production, joined to the changes and the CI runs that passed them"),
    ("DORA metrics", "11", "deployment and incident data: deploy times, lead time from commit to production, failures and time to restore"),
    ("Pipeline failures triaged without paging", "11", "CI pipeline and paging data: which failures an agent triaged and which paged a person"),
)


@dataclass(frozen=True)
class Check:
    """One `asdlc record-check` note, read back from a task's notes."""

    passed: bool
    code: int
    at: str  # when it ran, on the worker's machine
    commit: str = ""
    dirty: bool = False
    since_review: tuple[int, int] | None = None  # commits since the review: (carrying the worker trailer, all)


_NOTES = re.compile(r"<!-- SECTION:NOTES:BEGIN -->(.*?)<!-- SECTION:NOTES:END -->", re.S)
_CHECK_HEAD = re.compile(r"^Check (passed|FAILED): `(.*)` exited (-?\d+) at (\S+?)"
                         r"(?: in (.+) on (\S+) at ([0-9a-f]+)( with uncommitted changes)?)?(?:, last \d+ of \d+ lines)?:$")
_SINCE_REVIEW = re.compile(rf"^Commits since the review: (\d+)(?:, (?:(all) with|(\d+) without) the {WORKER_TRAILER} trailer)?\.$")
_DESCRIPTION = re.compile(r"<!-- SECTION:DESCRIPTION:BEGIN -->(.*?)<!-- SECTION:DESCRIPTION:END -->", re.S)
_CRITERIA = re.compile(r"<!-- AC:BEGIN -->(.*?)<!-- AC:END -->", re.S)
SKIP_NOTE = "size-1: plan approval skipped"


def since_review_line(carrying: int, total: int) -> str:
    """The line record-check adds to a check on a task a review sent back: how many of the branch's
    commits since the review carry the worker agent's trailer."""
    if not total:
        return "Commits since the review: 0."
    if carrying == total:
        return f"Commits since the review: {total}, all with the {WORKER_TRAILER} trailer."
    return f"Commits since the review: {total}, {total - carrying} without the {WORKER_TRAILER} trailer."


def worker_commits(log: str) -> tuple[int, int]:
    """`git log --no-merges --format=%B%x01` over the commits since the review: how many carry the
    worker trailer, and how many there are."""
    bodies = [body for body in log.split("\x01") if body.strip()]
    return sum(bool(re.search(rf"(?m)^{WORKER_TRAILER}: \S", body)) for body in bodies), len(bodies)


def _past_fence(lines: Sequence[str], index: int) -> int:
    """The line after a fenced block that starts at or after `index` (blank lines first), else `index`."""
    start = index
    while start < len(lines) and not lines[start].strip():
        start += 1
    if start >= len(lines) or not lines[start].lstrip().startswith("```"):
        return index
    fence = re.match(r"`+", lines[start].lstrip())[0]
    end = start + 1
    while end < len(lines) and lines[end].strip() != fence:
        end += 1
    return min(end + 1, len(lines))


def parse_checks(text: str) -> tuple[Check, ...]:
    """The checks `record-check` appended to a task's notes, in order. Output inside a check's fence is skipped."""
    found = _NOTES.search(text)
    lines = found[1].splitlines() if found else []
    checks: list[Check] = []
    index = 0
    while index < len(lines):
        head = _CHECK_HEAD.match(lines[index].strip())
        index += 1
        if not head:
            continue
        index = _past_fence(lines, index)
        since = None
        while index < len(lines) and not _CHECK_HEAD.match(lines[index].strip()):
            line = lines[index].strip()
            if counted := _SINCE_REVIEW.match(line):
                total = int(counted[1])
                since = (total, total) if counted[2] or not total else (total - int(counted[3]), total)
                index += 1
                break
            if line:
                break
            index += 1
        checks.append(Check(head[1] == "passed", int(head[3]), head[4], head[7] or "", bool(head[8]), since))
    return tuple(checks)


def substance(title: str, text: str) -> str:
    """A digest of what an intent asks for (title, description, acceptance criteria), ticked boxes aside:
    a commit that changes it changes the intent, one that only comments or moves it doesn't."""
    description = found[1].strip() if (found := _DESCRIPTION.search(text)) else ""
    criteria = re.sub(r"- \[[ xX]\]", "- [ ]", found[1].strip()) if (found := _CRITERIA.search(text)) else ""
    return hashlib.sha256("\x00".join((title, description, criteria)).encode()).hexdigest()[:12]


@dataclass(frozen=True)
class Item:
    """A task or draft file as one board commit left it, with what stats reads from its body."""

    task: Task
    substance: str = ""
    checks: tuple[Check, ...] = ()
    skip_noted: bool = False  # its notes say why a size-1 plan skipped approval


@dataclass(frozen=True)
class DocItem:
    id: str
    title: str
    type: str


def item_from(path: str, text: str) -> Item | None:
    if (task := task_from(path, text)) is None:
        return None
    return Item(task, substance(task.title, text), parse_checks(text), SKIP_NOTE in (found[1] if (found := _NOTES.search(text)) else ""))


def doc_from(text: str) -> DocItem | None:
    fields = frontmatter(text)
    doc_id = fields.get("id")
    if not isinstance(doc_id, str) or not doc_id:
        return None
    title, kind = fields.get("title", ""), fields.get("type", "")
    return DocItem(doc_id.lower(), title if isinstance(title, str) else " ".join(title), kind if isinstance(kind, str) else "")


@dataclass(frozen=True)
class Change:
    path: str
    item: Item | DocItem | None  # None: the file was deleted


@dataclass(frozen=True)
class Commit:
    sha: str
    when: datetime  # the committer's clock, on whichever machine made it
    changes: tuple[Change, ...]


_FOLDERS = (("backlog/archive/drafts/", "archived-drafts"), ("backlog/archive/tasks/", "archived-tasks"), ("backlog/drafts/", "drafts"),
            ("backlog/tasks/", "tasks"), ("backlog/completed/", "completed"), ("backlog/docs/", "docs"))
HISTORY_PATHS = tuple(prefix.rstrip("/") for prefix, _ in _FOLDERS)


def folder_of(path: str) -> str:
    return next((name for prefix, name in _FOLDERS if path.startswith(prefix)), "")


@dataclass(frozen=True)
class Seen:
    index: int  # the commit's place in the board's history: orders events without trusting anyone's clock
    when: datetime
    item: Item
    folder: str


@dataclass(frozen=True)
class End:
    """How a draft's life ended: accepted (into a task), archived, or deleted."""

    index: int
    when: datetime
    how: str
    into: str = ""


@dataclass(frozen=True)
class Life:
    """One task, or one draft until it was accepted, archived or deleted. Backlog reuses a draft's id
    once it is promoted, so each draft life is keyed by its id and a generation: DRAFT-2#1."""

    key: str
    seen: tuple[Seen, ...]
    end: End | None = None

    @property
    def id(self) -> str:
        return self.key.partition("#")[0]


@dataclass(frozen=True)
class DocLife:
    id: str
    title: str
    type: str
    commits: tuple[tuple[int, datetime], ...]

    def is_spec(self) -> bool:
        return self.type == "specification" or self.title.lower().startswith("spec")


@dataclass(frozen=True)
class Reviewed:
    """One review verdict, read from the commit asdlc review-done made."""

    when: datetime
    index: int
    clean: bool
    reviewer: str
    kind: str
    important: int | None  # None: the review recorded no structured findings (before --findings existed)
    nit: int | None
    policies: tuple[str, ...]
    plan_matched: bool | None
    checks: int  # how many checks the task had then


@dataclass(frozen=True)
class Story:
    """What happened to one task, read from its life in order (and its draft's, for when it began)."""

    id: str
    type: str
    project: str
    size: str
    status: str
    labels: tuple[str, ...]
    reviewer: str
    references: tuple[str, ...]
    authors: frozenset[str]  # the engineers whose workers held it
    first_index: int
    first_when: datetime
    claims: tuple[datetime, ...]  # To Do to In Progress with a worker
    held: tuple[tuple[str, datetime, datetime | None], ...]  # (engineer, from, until) while their worker held it In Progress
    entered_review: tuple[tuple[datetime, int, int], ...]  # (when, commit index, checks then)
    review_claims: tuple[tuple[datetime, str], ...]  # (when, kind)
    verdicts: tuple[Reviewed, ...]
    plan_written: datetime | None
    approvals: tuple[datetime, ...]
    done: datetime | None  # the latest move to Done, while it is Done
    first_done_index: int | None
    checks: tuple[Check, ...]
    skip_noted: bool

    @property
    def pull(self) -> str | None:
        return review_refs(self.references)[1]


@dataclass(frozen=True)
class Ledger:
    lives: frozendict[str, Life]
    docs: frozendict[str, DocLife]
    stories: frozendict[str, Story]


def _story(key: str, seen: Sequence[Seen], began: Seen) -> Story:
    claims: list[datetime] = []
    entered: list[tuple[datetime, int, int]] = []
    review_claims: list[tuple[datetime, str]] = []
    verdicts: list[Reviewed] = []
    approvals: list[datetime] = []
    held: list[tuple[str, datetime, datetime | None]] = []
    holding: dict[str, datetime] = {}
    authors: frozenset[str] = frozenset()
    plan_written = done = None
    first_done = None
    previous: Task | None = None
    for snapshot in seen:
        task, when = snapshot.item.task, snapshot.when
        if is_status(task, IN_PROGRESS) and workers(task.assignees) and (previous is None or is_status(previous, TO_DO)):
            claims.append(when)
        if is_status(task, IN_REVIEW) and (previous is None or not is_status(previous, IN_REVIEW)):
            entered.append((when, snapshot.index, len(snapshot.item.checks)))
        if task.reviewer and (previous is None or previous.reviewer != task.reviewer):
            review_claims.append((when, task.review_kind or str(ReviewKind.CROSS_MACHINE)))
        if previous is not None and previous.reviewer and not task.reviewer:
            clean = REVIEW_PASSED in task.labels and REVIEW_PASSED not in previous.labels
            if clean or (CHANGES_REQUESTED in task.labels and CHANGES_REQUESTED not in previous.labels):
                try:
                    important, nit = parse_findings(task.review_findings) if task.review_findings else (None, None)
                except AsdlcError:
                    important, nit = None, None
                matched = {"yes": True, "no": False}.get(task.plan_matched)
                verdicts.append(Reviewed(when, snapshot.index, clean, previous.reviewer, previous.review_kind or str(ReviewKind.CROSS_MACHINE),
                                         important, nit, task.review_policies, matched, len(snapshot.item.checks)))
        if task.plan_hash and plan_written is None:
            plan_written = when
        if task.plan_approved_by and (previous is None or (previous.plan_approved_by, previous.approved_hash) != (task.plan_approved_by, task.approved_hash)):
            approvals.append(when)
        if is_status(task, DONE) and (previous is None or not is_status(previous, DONE)):
            done = when
            first_done = snapshot.index if first_done is None else first_done
        elif not is_status(task, DONE):
            done = None
        now_held = {owner_of(w) for w in workers(task.assignees)} if is_status(task, IN_PROGRESS) else set()
        if workers(task.assignees):
            authors = frozenset(owner_of(w) for w in workers(task.assignees))
        for engineer in [e for e in holding if e not in now_held]:
            held.append((engineer, holding.pop(engineer), when))
        for engineer in sorted(now_held - holding.keys()):
            holding[engineer] = when
        previous = task
    last = seen[-1].item
    held += [(engineer, start, None) for engineer, start in holding.items()]
    return Story(
        id=key, type=last.task.type, project=last.task.project, size=size_of(last.task), status=last.task.status, labels=last.task.labels,
        reviewer=last.task.reviewer, references=last.task.references, authors=authors, first_index=began.index, first_when=began.when,
        claims=tuple(claims), held=tuple(held), entered_review=tuple(entered), review_claims=tuple(review_claims), verdicts=tuple(verdicts),
        plan_written=plan_written, approvals=tuple(approvals), done=done, first_done_index=first_done, checks=last.checks, skip_noted=last.skip_noted,
    )


def replay(commits: Sequence[Commit]) -> Ledger:
    """The board's history, oldest commit first, as each task's and draft's life and each document's commits."""
    seen: dict[str, list[Seen]] = {}
    ends: dict[str, End] = {}
    open_draft: dict[str, str] = {}  # a draft id -> the key of its open life
    generation: Counter[str] = Counter()
    present: dict[str, Item] = {}  # path -> what it holds now, so a deletion is known by id
    docs: dict[str, list[tuple[int, datetime]]] = {}
    doc_meta: dict[str, DocItem] = {}
    for index, commit in enumerate(commits):
        gone: set[str] = set()
        drafted: set[str] = set()
        archived: set[str] = set()
        accepted: dict[str, str] = {}
        for change in commit.changes:
            folder = folder_of(change.path)
            if folder == "docs":
                if isinstance(change.item, DocItem):
                    docs.setdefault(change.item.id, []).append((index, commit.when))
                    doc_meta[change.item.id] = change.item
                continue
            if not isinstance(change.item, Item):
                if (old := present.pop(change.path, None)) is not None and folder == "drafts":
                    gone.add(old.task.id)
                continue
            item = change.item
            present[change.path] = item
            task_id = item.task.id
            match folder:
                case "drafts":
                    drafted.add(task_id)
                    if (key := open_draft.get(task_id)) is None:
                        generation[task_id] += 1
                        key = open_draft[task_id] = f"{task_id}#{generation[task_id]}"
                    seen.setdefault(key, []).append(Seen(index, commit.when, item, folder))
                case "archived-drafts":
                    archived.add(task_id)
                case _:
                    if task_id not in seen and item.task.accepted_from:
                        accepted[item.task.accepted_from] = task_id
                    seen.setdefault(task_id, []).append(Seen(index, commit.when, item, folder))
        for draft_id in sorted(gone - drafted):
            if (key := open_draft.pop(draft_id, None)) is not None:
                how = "accepted" if draft_id in accepted else "archived" if draft_id in archived else "deleted"
                ends[key] = End(index, commit.when, how, accepted.get(draft_id, ""))
    lives = {key: Life(key, tuple(found), ends.get(key)) for key, found in seen.items()}
    origin = {life.end.into: life for life in lives.values() if life.end and life.end.how == "accepted"}
    stories = {key: _story(key, life.seen, (origin[key] if key in origin else life).seen[0])
               for key, life in lives.items() if "#" not in key}
    return Ledger(frozendict(lives), frozendict({d: DocLife(d, doc_meta[d].title, doc_meta[d].type, tuple(c)) for d, c in docs.items()}),
                  frozendict(stories))


@dataclass(frozen=True)
class Window:
    """What a report counts: events from `since` on (all of them when None), judged at `now`."""

    since: datetime | None
    now: datetime

    def has(self, when: datetime | None) -> bool:
        return when is not None and (self.since is None or when >= self.since)


def percentile(values: Sequence[float], q: float) -> float | None:
    """The nearest-rank percentile: the smallest value with at least q of them at or below it."""
    if not values:
        return None
    ordered = sorted(values)
    return ordered[max(math.ceil(q * len(ordered)) - 1, 0)]


def _spread(spans: Sequence[timedelta]) -> dict[str, object]:
    seconds = [span.total_seconds() for span in spans]
    return {"count": len(seconds), "median": percentile(seconds, 0.5), "p90": percentile(seconds, 0.9)}


def _duration(seconds: object) -> str:
    if not isinstance(seconds, (int, float)):
        return "-"
    return f"{int(seconds)}s" if seconds < 60 else human(timedelta(seconds=float(seconds)))


def _spread_text(found: Mapping[str, object]) -> str:
    return f"median {_duration(found['median'])}, p90 {_duration(found['p90'])} ({found['count']})"


def _share(count: int, of: int) -> dict[str, object]:
    return {"count": count, "of": of, "share": count / of if of else None}


def _share_text(found: Mapping[str, object]) -> str:
    share = found["share"]
    return f"{found['count']} of {found['of']}" + (f" ({share:.0%})" if isinstance(share, float) else "")


def _status_is(status: str, wanted: str) -> bool:
    return status.casefold() == wanted.casefold()


def _week(when: datetime) -> str:
    year, week, _ = when.isocalendar()
    return f"{year}-W{week:02d}"


def _iso(raw: str) -> datetime | None:
    try:
        found = datetime.fromisoformat(raw)
    except (TypeError, ValueError):
        return None
    return found if found.tzinfo else found.replace(tzinfo=UTC)


def _metric(play: str, playbook: str, label: str, source: str, text: str, **values: object) -> dict[str, object]:
    return {"label": label, "play": play, "playbook": playbook, "measured": True, "source": source, "text": text, **values}


def _unmeasured(play: str, playbook: str, label: str, needs: str) -> dict[str, object]:
    return {"label": label, "play": play, "playbook": playbook, "measured": False, "needs": needs, "text": f"not measured: {needs}"}


def _stage(name: str, metrics: Mapping[str, Mapping[str, object]]) -> dict[str, object]:
    title, plays = STAGES[name]
    return {"title": title, "plays": list(plays), "metrics": dict(metrics)}


# The intents: each draft intent with the task it was accepted as, and each intent made as a task.

@dataclass(frozen=True)
class IntentLife:
    draft: Life | None
    task: Life | None

    @property
    def id(self) -> str:
        return self.task.id if self.task else self.draft.id if self.draft else ""

    @property
    def seen(self) -> tuple[Seen, ...]:
        return (*(self.draft.seen if self.draft else ()), *(self.task.seen if self.task else ()))


def intents(ledger: Ledger) -> tuple[IntentLife, ...]:
    became = {life.key: life.end.into for life in ledger.lives.values() if life.end and life.end.how == "accepted"}
    from_drafts = set(became.values())
    found = []
    for key, life in ledger.lives.items():
        if not any(s.item.task.type == "intent" for s in life.seen):
            continue
        if "#" in key:
            found.append(IntentLife(life, ledger.lives.get(became.get(key, ""))))
        elif key not in from_drafts:
            found.append(IntentLife(None, life))
    return tuple(sorted(found, key=lambda i: i.seen[0].index))


def spec_docs(ledger: Ledger, intent: IntentLife) -> tuple[DocLife, ...]:
    """The specification documents linked from the intent at any point: type specification, or titled Spec."""
    linked = {doc for s in intent.seen for doc in s.item.task.documentation}
    return tuple(ledger.docs[d] for d in sorted(linked) if d in ledger.docs and ledger.docs[d].is_spec())


def family(ledger: Ledger, intent: IntentLife) -> tuple[Life, ...]:
    """The lives under an intent, at any depth: its accepted children and its children still drafts."""
    accepted = {life.key for life in ledger.lives.values() if life.end and life.end.how == "accepted"}
    current = [life for life in ledger.lives.values() if life.key not in accepted and (life.end is None or "#" not in life.key)]
    ids = {intent.id}
    found: dict[str, Life] = {}
    while True:
        more = [life for life in current if life.seen[-1].item.task.parent in ids and life.key not in found and life.id != intent.id]
        if not more:
            return tuple(found.values())
        found |= {life.key: life for life in more}
        ids |= {life.id for life in more}


def _first_child_plan(ledger: Ledger, intent: IntentLife) -> int | None:
    return min((s.index for life in family(ledger, intent) for s in life.seen if s.item.task.plan_hash), default=None)


def _spec_start(ledger: Ledger, intent: IntentLife) -> tuple[int, datetime] | None:
    return min(((i, w) for doc in spec_docs(ledger, intent) for i, w in doc.commits[:1]), default=None)


def _accept_waits(ledger: Ledger, window: Window) -> list[timedelta]:
    """An intent draft's first commit to the commit that accepted it, for each accepted in the window."""
    return [i.draft.end.when - i.draft.seen[0].when for i in intents(ledger)
            if i.draft and i.draft.end and i.draft.end.how == "accepted" and window.has(i.draft.end.when)]


# One function per stage.

def plan_stage(ledger: Ledger, window: Window) -> dict[str, object]:
    """Play 01, capture intent, and the accept gate of play 10."""
    starts: list[timedelta] = []
    unrecorded: list[str] = []
    ended: Counter[str] = Counter()
    churn: dict[str, int] = {}
    for intent in intents(ledger):
        if (draft := intent.draft) is not None:
            created = draft.seen[0]
            if window.has(created.when):
                started = _iso(next((s.item.task.intent_started for s in draft.seen if s.item.task.intent_started), ""))
                if started is not None:
                    starts.append(max(created.when - started, timedelta()))
                else:
                    unrecorded.append(draft.id)
            if draft.end is not None and window.has(draft.end.when):
                ended[draft.end.how] += 1
        if (spec := _spec_start(ledger, intent)) is not None:
            ordered = sorted(intent.seen, key=lambda s: s.index)
            churn[intent.id] = sum(1 for before, after in zip(ordered, ordered[1:])
                                   if after.index > spec[0] and after.item.substance != before.item.substance and window.has(after.when))
    started = _spread(starts)
    closed = ended["archived"] + ended["deleted"]
    survival = _share(ended["accepted"], ended["accepted"] + closed)
    accept = _spread(_accept_waits(ledger, window))
    missing = f"; {len(unrecorded)} intent(s) with no start recorded ({', '.join(unrecorded)})" if unrecorded else ""
    return _stage("plan", {
        "conversation_to_intent": _metric(
            "01", "Conversation to committed intent (leading)", "conversation to committed intent",
            "asdlc_intent_started on each intent draft (asdlc intent-started), to the commit that created the draft",
            _spread_text(started) + missing, **started, unrecorded=unrecorded),
        "survival_rate": _metric(
            "01", "Survival rate (lagging)", "intent survival rate", "intent drafts accepted, archived or deleted on the board",
            f"{_share_text(survival)} intents accepted; {ended['archived']} archived, {ended['deleted']} deleted without acceptance",
            **survival, archived=ended["archived"], deleted=ended["deleted"]),
        "post_spec_churn": _metric(
            "01", "Post-spec churn", "post-spec churn", "commits changing an intent's title, description or criteria after its first linked spec document",
            f"{sum(churn.values())} commit(s) changed an intent after its spec, over {len(churn)} intent(s) with a spec"
            + (f"; most {max(churn.values())} ({max(churn, key=churn.get)})" if any(churn.values()) else ""),
            commits=sum(churn.values()), intents=len(churn), by_intent=churn),
        "accept_wait": _metric(
            "10", "Gate wait: accept", "draft to accept wait", "an intent draft's first commit to the commit that accepted it",
            _spread_text(accept), **accept),
    })


def design_stage(ledger: Ledger, window: Window) -> dict[str, object]:
    """Play 02, requirements and design: how soon the spec follows the intent, and how much it moves once plans exist."""
    spans: list[timedelta] = []
    rework: dict[str, int] = {}
    for intent in intents(ledger):
        if (spec := _spec_start(ledger, intent)) is None:
            continue
        if window.has(spec[1]):
            draft = intent.draft
            accepted = draft is not None and draft.end is not None and draft.end.how == "accepted" and draft.end.index < spec[0]
            start = draft.end.when if accepted else intent.seen[0].when
            spans.append(max(spec[1] - start, timedelta()))
        if (planned := _first_child_plan(ledger, intent)) is not None:
            rework[intent.id] = sum(1 for doc in spec_docs(ledger, intent) for i, when in doc.commits if i > planned and window.has(when))
    to_spec = _spread(spans)
    return _stage("design", {
        "intent_to_spec": _metric(
            "02", "Intent to spec", "intent to first spec", "the intent's commit (or its accept, when the spec came after it) to the first commit of a spec document linked on it",
            _spread_text(to_spec), **to_spec),
        "spec_rework": _metric(
            "02", "Spec rework", "spec rework", "commits to an intent's spec documents after the first child task's plan was written",
            f"{sum(rework.values())} spec commit(s) after planning began, over {len(rework)} intent(s) with planned children",
            commits=sum(rework.values()), intents=len(rework), by_intent=rework),
    })


def _concurrency(spans: Iterable[tuple[datetime, datetime | None]], window: Window) -> tuple[int, int | None]:
    """The peak and the time-weighted median of how many spans overlap, over the time at least one is open."""
    points: list[tuple[datetime, int]] = []
    for start, until in spans:
        start = max(start, window.since) if window.since else start
        until = until or window.now
        if until > start:
            points += [(start, 1), (until, -1)]
    level = peak = 0
    last: datetime | None = None
    weights: Counter[int] = Counter()
    for when, step in sorted(points, key=lambda p: (p[0], p[1])):
        if last is not None and level > 0:
            weights[level] += (when - last).total_seconds()
        level += step
        peak = max(peak, level)
        last = when
    total, running = sum(weights.values()), 0.0
    for level, weight in sorted(weights.items()):
        running += weight
        if running >= total / 2:
            return peak, level
    return peak, None


def merge_time(story: Story, merged: Mapping[str, datetime]) -> tuple[datetime | None, str]:
    """When the task's pull request merged, from gh when it could say, else the task's Done commit."""
    if story.id in merged:
        return merged[story.id], "gh"
    return story.done, "Done commit"


def _approval_waits(stories: Iterable[Story], window: Window) -> list[timedelta]:
    return [s.approvals[0] - s.plan_written for s in stories if s.approvals and s.plan_written and window.has(s.approvals[0])]


def _merge_waits(stories: Iterable[Story], merged: Mapping[str, datetime], window: Window) -> list[timedelta]:
    waits = []
    for s in stories:
        at, _ = merge_time(s, merged)
        if window.has(s.done) and at is not None and (passed := [v.when for v in s.verdicts if v.clean and v.when <= at]):
            waits.append(at - passed[-1])
    return waits


def _throughput_text(engineer: str, found: Mapping[str, object]) -> str:
    weeks = ", ".join(f"{week} {n}" for week, n in found["weeks"].items()) or "none Done"
    rate = found["rework_rate"]
    return f"{engineer}: {weeks}; rework {rate:.1f} per reviewed task" if isinstance(rate, float) else f"{engineer}: {weeks}; rework -"


def build_stage(ledger: Ledger, merged: Mapping[str, datetime], window: Window) -> dict[str, object]:
    """Play 03, plan mode through merge, and play 06, parallel sessions."""
    stories = list(ledger.stories.values())
    to_review: list[timedelta] = []
    for s in stories:
        if (first := next((c for c in s.claims if window.has(c)), None)) and (reviewed := next((w for w, _, _ in s.entered_review if w >= first), None)):
            to_review.append(reviewed - first)
    done = [s for s in stories if window.has(s.done)]
    reviewed_done = [s for s in done if s.verdicts]
    first_pass = _share(sum(s.verdicts[0].clean for s in reviewed_done), len(reviewed_done))
    to_merge: list[timedelta] = []
    sources: Counter[str] = Counter()
    for s in done:
        at, source = merge_time(s, merged)
        if s.approvals and at is not None:
            to_merge.append(at - s.approvals[-1])
            sources[source] += 1
    verdicts = [(s, v) for s in stories for v in s.verdicts if window.has(v.when)]
    rounds = {s.id: sum(not v.clean for v in s.verdicts if window.has(v.when)) for s in stories if any(window.has(v.when) for v in s.verdicts)}
    matched = [v.plan_matched for _, v in verdicts if v.plan_matched is not None]
    plan_matched = _share(sum(matched), len(matched))
    approval = _spread(_approval_waits(stories, window))
    claimed = sorted((s for s in stories if any(window.has(c) for c in s.claims)), key=lambda s: id_key(s.id))
    skipped = [s for s in claimed if s.size == "size-1" and not s.approvals]
    skip = _share(len(skipped), len(claimed))
    engineers = sorted({e for s in stories for e, _, _ in s.held})
    parallel = {}
    for engineer in engineers:
        peak, median = _concurrency(((start, until) for s in stories for e, start, until in s.held if e == engineer), window)
        parallel[engineer] = {"peak": peak, "median": median}
    throughput: dict[str, dict[str, object]] = {}
    for engineer in sorted({e for s in stories for e in s.authors}):
        weeks: Counter[str] = Counter(_week(s.done) for s in done if engineer in s.authors and s.done)
        theirs = [s for s in stories if engineer in s.authors and any(window.has(v.when) for v in s.verdicts)]
        trips = sum(rounds.get(s.id, 0) for s in theirs)
        throughput[engineer] = {"weeks": dict(sorted(weeks.items())), "reviewed": len(theirs), "round_trips": trips,
                                "rework_rate": trips / len(theirs) if theirs else None}
    to_review_spread, merge_spread = _spread(to_review), _spread(to_merge)
    worst = max(rounds.items(), key=lambda r: r[1], default=None)
    return _stage("build", {
        "claim_to_review": _metric("03", "Claim to In Review", "claim to In Review", "a task's first claim to its first move to In Review",
                                   _spread_text(to_review_spread), **to_review_spread),
        "first_pass_merge": _metric(
            "03", "Merged from the first pass", "merged from the first pass", "tasks Done whose first review verdict was clean",
            f"{_share_text(first_pass)} reviewed tasks Done; {len(done) - len(reviewed_done)} Done without a recorded review", **first_pass,
            unreviewed=len(done) - len(reviewed_done)),
        "approval_to_merge": _metric(
            "03", "Approval to merge", "plan approval to merge", "the last plan approval to the pull request's merge (gh pr view --json mergedAt), else the Done commit",
            _spread_text(merge_spread) + (f"; merge times from {', '.join(f'{k} {n}' for k, n in sorted(sources.items()))}" if sources else ""),
            **merge_spread, sources=dict(sources)),
        "rework_cycles": _metric(
            "03", "Rework cycles", "rework cycles", "changes-requested verdicts per reviewed task",
            f"{sum(rounds.values())} round trip(s) over {len(rounds)} reviewed task(s)"
            + (f", {sum(rounds.values()) / len(rounds):.1f} per task, most {worst[1]} ({worst[0]})" if worst else ""),
            reviewed_tasks=len(rounds), round_trips=sum(rounds.values()), per_task=sum(rounds.values()) / len(rounds) if rounds else None, by_task=rounds),
        "plan_matched": _metric(
            "03", "Diff still matches the plan", "diff matches the plan", "review-done --plan-matched on each verdict",
            f"{_share_text(plan_matched)} reviews; {len(verdicts) - len(matched)} without it recorded", **plan_matched, unrecorded=len(verdicts) - len(matched)),
        "approval_wait": _metric("03", "Plan written to approved", "plan written to approved", "the first commit with a plan to the first asdlc approve",
                                 _spread_text(approval), **approval),
        "size1_skipped_approval": _metric(
            "03", "Small tasks that skipped approval", "size-1 tasks that skipped approval", "claimed size-1 tasks with no recorded approval",
            f"{_share_text(skip)} claimed tasks" + (f": {', '.join(s.id + ('' if s.skip_noted else ' (no note says why)') for s in skipped)}" if skipped else ""),
            **skip, tasks=[{"id": s.id, "noted": s.skip_noted} for s in skipped]),
        "parallel_claims": _metric(
            "06", "Parallel sessions per engineer", "concurrent claims per engineer", "the spans each engineer's workers held tasks In Progress",
            "; ".join(f"{e} peak {p['peak']}, median {p['median'] if p['median'] is not None else '-'}" for e, p in parallel.items()) or "no claims",
            by_engineer=parallel),
        "throughput": _metric(
            "06", "Tasks merged per engineer per week, with rework rate", "Done per engineer per week",
            "tasks Done by the engineer whose workers built them, and changes-requested verdicts per reviewed task of theirs",
            "; ".join(_throughput_text(e, t) for e, t in throughput.items()) or "no tasks",
            by_engineer=throughput),
    })


def test_stage(ledger: Ledger, window: Window) -> dict[str, object]:
    """Play 07, the feedback loop, and play 08, evals."""
    first_pass = baseline = 0
    first_counted = baseline_counted = 0
    per_task: list[int] = []
    failed = total = 0
    for s in ledger.stories.values():
        if not s.checks:
            continue
        start = s.checks[0]
        if window.has(_iso(start.at)):
            baseline_counted += 1
            baseline += start.passed
        after = start if start.dirty else next((c for c in s.checks[1:] if c.commit != start.commit or c.dirty), None)
        if after is not None and window.has(_iso(after.at)):
            first_counted += 1
            first_pass += after.passed
        counted = [c for c in s.checks if window.has(_iso(c.at))]
        if counted:
            per_task.append(len(counted))
            total += len(counted)
            failed += sum(not c.passed for c in counted)
    first = _share(first_pass, first_counted)
    green = _share(baseline, baseline_counted)
    failures = _share(failed, total)
    return _stage("test", {
        "first_pass_checks": _metric(
            "07", "First-pass check success", "first-pass check success",
            "each task's first record-check after a change (the worker's baseline check, before any change, is counted apart)",
            f"{_share_text(first)} tasks passed their first check after a change; baselines green {_share_text(green)}", **first, baseline=green),
        "checks_per_task": _metric(
            "07", "Checks per task", "checks per task", "record-check notes on each task",
            f"median {percentile(per_task, 0.5) or 0}, p90 {percentile(per_task, 0.9) or 0}, max {max(per_task, default=0)} over {len(per_task)} task(s)",
            tasks=len(per_task), checks=total, median=percentile(per_task, 0.5), p90=percentile(per_task, 0.9), max=max(per_task, default=None)),
        "failed_checks": _metric("07", "Failed checks", "failed checks", "record-check notes that exited non-zero",
                                 f"{_share_text(failures)} checks failed", **failures),
        "eval_pass_rate": _unmeasured("08", "Eval pass rate", "eval pass rate",
                                      "there is no eval suite yet; it needs eval results recorded per change, which play 08's eval gate will add"),
    })


_REFUSAL_RULES = (
    ("an existing test, and this is a fix branch", "test edited on a fix branch"),
    ("is on the board: change the board with asdlc board", "board file edited by hand"),
    ("is not in a claimed task's worktree", "code edited outside a claimed worktree"),
    ("merging a pull request is a person's decision", "pull request merge"),
    ("approving or requesting changes on a pull request", "pull request approval"),
    ("asdlc accept promotes", "accept"),
    ("asdlc approve records", "plan approval"),
    ("asdlc permissions --write", "permissions --write"),
    ("promoting a draft accepts it", "draft promotion"),
    ("archiving or demoting accepted work", "archive or demote"),
    ("setting a task to", "To Do or Done"),
    ("a task goes In Progress only through a claim", "In Progress by hand"),
    ("a task goes to review only through asdlc finish", "In Review by hand"),
    ("who holds a task changes only through", "assignees by hand"),
    ("the review-passed and changes-requested labels", "review labels by hand"),
    ("a task's size decides", "resizing accepted work"),
    ("created without --draft", "task created without --draft"),
    ("a force push rewrites a task branch", "force push"),
    ("changes reach it through review", "push to a default branch"),
)


def refusal_rule(hook: str, reason: str) -> str:
    """The guard rule a logged refusal came from, read from its reason, which each rule words its own way."""
    return next((rule for marker, rule in _REFUSAL_RULES if marker in reason), f"{hook or 'a hook'}: other")


def deploy_stage(ledger: Ledger, decisions: Sequence[Mapping[str, object]], merged: Mapping[str, datetime], window: Window) -> dict[str, object]:
    """Play 09, review, with play 05's policies cited by findings and play 10's gates and guards."""
    stories = list(ledger.stories.values())
    waits: list[timedelta] = []
    waiting: list[str] = []
    durations: list[timedelta] = []
    for s in stories:
        entries = s.entered_review
        for index, (entered, _, _) in enumerate(entries):
            if not window.has(entered):
                continue
            until = entries[index + 1][0] if index + 1 < len(entries) else None
            claim = next((when for when, _ in s.review_claims if when >= entered and (until is None or when < until)), None)
            if claim is not None:
                waits.append(claim - entered)
            elif until is None and _status_is(s.status, IN_REVIEW) and not s.reviewer and REVIEW_PASSED not in s.labels:
                waiting.append(s.id)
        for verdict in s.verdicts:
            if window.has(verdict.when) and (claims := [w for w, _ in s.review_claims if w <= verdict.when]):
                durations.append(verdict.when - claims[-1])
    rounds_with = rounds_alone = rounds_unrecorded = 0
    for s in stories:
        for verdict in (v for v in s.verdicts if not v.clean):
            back = next((e for e in s.entered_review if e[1] > verdict.index), None)
            if back is None or not window.has(back[0]):
                continue
            found = [c.since_review for c in s.checks[verdict.checks:back[2]] if c.since_review is not None]
            if not found:
                rounds_unrecorded += 1
            else:
                rounds_with += 1
                rounds_alone += found[-1][0] == found[-1][1]
    alone = _share(rounds_alone, rounds_with)
    recorded = [(s, v) for s in stories for v in s.verdicts if window.has(v.when) and v.important is not None]
    tasks_with_findings = {s.id for s, _ in recorded}
    important = sum(v.important or 0 for _, v in recorded)
    nits = sum(v.nit or 0 for _, v in recorded)
    unrecorded = sum(1 for s in stories for v in s.verdicts if window.has(v.when) and v.important is None)
    by_policy: dict[str, Counter[str]] = {}
    for _, v in recorded:
        for policy in v.policies:
            by_policy.setdefault(policy, Counter())[_week(v.when)] += 1
    done_at = {s.id: s.first_done_index for s in stories if s.first_done_index is not None}
    escaped: list[dict[str, object]] = []
    for s in stories:
        if s.type != "bug" or not window.has(s.first_when):
            continue
        refs = sorted({r.strip().upper() for r in s.references} & {i for i, at in done_at.items() if at <= s.first_index})
        if refs:
            escaped.append({"id": s.id, "refs": refs, "week": _week(s.first_when)})
    per_week = Counter(str(e["week"]) for e in escaped)
    reviews = [(s.id, kind) for s in stories for when, kind in s.review_claims if window.has(when)]
    same = sum(kind == ReviewKind.SAME_MACHINE for _, kind in reviews)
    to_done: list[timedelta] = []
    for s in stories:
        if window.has(s.done) and (entered := next((w for w, _, _ in s.entered_review if w <= s.done), None)):
            to_done.append(s.done - entered)
    accept = _spread(_accept_waits(ledger, window))
    approval = _spread(_approval_waits(stories, window))
    merging = _spread(_merge_waits(stories, merged, window))
    refusals: Counter[str] = Counter()
    for entry in decisions:
        when = _iso(str(entry.get("time", "")))
        if entry.get("verdict") == "deny" and window.has(when):
            refusals[refusal_rule(str(entry.get("hook", "")), str(entry.get("reason", "")))] += 1
    wait, duration, done_spread = _spread(waits), _spread(durations), _spread(to_done)
    gates = {"accept": accept, "approval": approval, "merge": merging}
    return _stage("deploy", {
        "time_to_first_review": _metric(
            "09", "Time to first review", "time to first review", "each move to In Review to the next review claim",
            _spread_text(wait) + (f"; waiting now: {', '.join(sorted(waiting))}" if waiting else ""), **wait, waiting_now=sorted(waiting)),
        "review_duration": _metric("09", "Review duration", "review duration", "a review claim to its verdict", _spread_text(duration), **duration),
        "worker_only_fixes": _metric(
            "09", "Changes fixed by the worker alone", "changes fixed by worker commits only",
            f"the record-check notes of each changes-requested round: whether every commit since the review carries {WORKER_TRAILER}",
            f"{_share_text(alone)} rounds fixed with worker commits only; {rounds_unrecorded} round(s) without it recorded",
            **alone, unrecorded=rounds_unrecorded),
        "defects_caught": _metric(
            "09", "Defects caught before merge", "Important findings per reviewed task", "review-done --findings on each verdict",
            f"{important} Important and {nits} nit finding(s) over {len(tasks_with_findings)} reviewed task(s)"
            + (f", {important / len(tasks_with_findings):.1f} Important per task" if tasks_with_findings else "")
            + (f"; {unrecorded} verdict(s) without findings recorded" if unrecorded else ""),
            important=important, nits=nits, tasks=len(tasks_with_findings),
            important_per_task=important / len(tasks_with_findings) if tasks_with_findings else None, unrecorded=unrecorded),
        "findings_by_policy": _metric(
            "05", "Findings citing a policy (lagging: should fall)", "reviews citing each policy, by week", "review-done --policy on each verdict",
            "; ".join(f"{p}: {', '.join(f'{w} {n}' for w, n in sorted(c.items()))}" for p, c in sorted(by_policy.items())) or "no policy cited",
            by_policy={p: dict(sorted(c.items())) for p, c in sorted(by_policy.items())}),
        "defects_escaped": _metric(
            "09", "Defects escaped", "bugs against Done tasks, by week", "bug tasks whose --ref names a task that was Done when the bug was filed",
            f"{len(escaped)} bug(s)" + (f": {', '.join(f'{w} {n}' for w, n in sorted(per_week.items()))}" if escaped else ""),
            count=len(escaped), by_week=dict(sorted(per_week.items())), bugs=escaped),
        "same_machine_reviews": _metric(
            "09", "Same-machine reviews", "same-machine reviews", "review claims marked same-machine (the fallback)",
            f"{_share_text(_share(same, len(reviews)))} reviews", **_share(same, len(reviews))),
        "review_to_done": _metric("09", "In Review to Done", "In Review to Done", "a task's first move to In Review to its Done commit",
                                  _spread_text(done_spread), **done_spread),
        "gate_waits": _metric(
            "10", "Gate waits", "gate waits", "accept: draft to accept; approval: plan written to approved; merge: clean review to merge (gh, else Done)",
            f"accept {_spread_text(gates['accept'])}; approval {_spread_text(approval)}; merge {_spread_text(merging)}", **gates),
        "guard_refusals": _metric(
            "10", "Guard refusals by rule", "guard refusals by rule", "the hook decision logs (.asdlc/hooks.jsonl) on this machine",
            f"{sum(refusals.values())} refusal(s)" + (f": {', '.join(f'{r} {n}' for r, n in refusals.most_common())}" if refusals else ""),
            total=sum(refusals.values()), by_rule=dict(refusals.most_common())),
    })


def maintain_stage() -> dict[str, object]:
    return _stage("maintain", {
        "closing_the_loop": _unmeasured(
            "12", "Closing the loop on metrics", "closing the loop",
            "play 12 isn't built yet: it needs detection bands over these numbers in versioned config, and a diagnosis written as an intent (spec R19)"),
    })


def published_plugins(log: Iterable[tuple[datetime, str]]) -> tuple[tuple[datetime, str], ...]:
    """The tasks repository's first publish of each repository plugin: asdlc-plugin's "Add the <slug> plugin" commits."""
    found = [(when, m[1]) for when, subject in log if (m := re.fullmatch(r"Add the (\S+) plugin", subject.strip()))]
    return tuple(sorted(found))


def coordination_stage(ledger: Ledger, subjects: Sequence[tuple[datetime, str]], events: Sequence[Mapping[str, object]], window: Window) -> dict[str, object]:
    """The shared board itself: races lost, claims released, onboardings."""
    attempts: dict[str, Counter[str]] = {}
    for event in events:
        if window.has(_iso(str(event.get("time", "")))):
            attempts.setdefault(str(event.get("command", "")), Counter())[str(event.get("outcome", ""))] += 1
    claims_made = sum(attempts.get(c, Counter())[Attempt.CLAIMED] for c in ("claim", "next"))
    lost = sum(attempts.get(c, Counter())[Attempt.LOST] for c in ("claim", "next"))
    released = 0
    for when, subject in subjects:
        if not window.has(when):
            continue
        if re.match(r"Release \S+ from @", subject):
            released += 1
    onboardings = []
    for when, plugin in published_plugins(subjects):
        if not window.has(when):
            continue
        starts = [(c, s.id) for s in ledger.stories.values() if s.project == plugin for c in s.claims if c <= when]
        start, task_id = max(starts) if starts else (None, None)
        onboardings.append({"plugin": plugin, "published": when.isoformat(timespec="seconds"), "task": task_id,
                            "seconds": (when - start).total_seconds() if start else None})
    races = {"claimed": claims_made, "lost": lost, "lost_per_claim": lost / claims_made if claims_made else None,
             "by_command": {command: dict(sorted(counts.items())) for command, counts in sorted(attempts.items())}}
    per = f"{races['lost_per_claim']:.2f}" if races["lost_per_claim"] is not None else "-"
    return _stage("coordination", {
        "lost_races": _metric("", "", "lost races per claim", "this machine's event log (claim, next, review-next)",
                              f"{per} ({lost} lost, {claims_made} claimed)", **races),
        "released": _metric("", "", "released by hand", "the board's 'Release <id> from @<worker>' commits", str(released), count=released),
        "onboardings": _metric(
            "", "", "onboardings", "the tasks repository's 'Add the <slug> plugin' commits, from the newest claim in that repository before each",
            "; ".join(f"{o['plugin']} at {o['published']}" + (f", {_duration(o['seconds'])} after {o['task']} was claimed" if o["task"] else "")
                      for o in onboardings) or "none", onboardings=onboardings),
    })


def stats_report(ledger: Ledger, subjects: Sequence[tuple[datetime, str]], events: Sequence[Mapping[str, object]],
                 decisions: Sequence[Mapping[str, object]], merged: Mapping[str, datetime], window: Window,
                 stages: Sequence[str] = tuple(STAGES)) -> dict[str, object]:
    """Every stage's numbers (or the ones asked for), the tasks summary, and what the board can't measure."""
    makers: dict[str, Callable[[], dict[str, object]]] = {
        "plan": lambda: plan_stage(ledger, window),
        "design": lambda: design_stage(ledger, window),
        "build": lambda: build_stage(ledger, merged, window),
        "test": lambda: test_stage(ledger, window),
        "deploy": lambda: deploy_stage(ledger, decisions, merged, window),
        "maintain": maintain_stage,
        "coordination": lambda: coordination_stage(ledger, subjects, events, window),
    }
    stories = ledger.stories.values()
    return {
        "since": window.since.isoformat(timespec="seconds") if window.since else None,
        "tasks": {"claimed": sum(any(window.has(c) for c in s.claims) for s in stories),
                  "in_review": sum(_status_is(s.status, IN_REVIEW) for s in stories),
                  "done": sum(window.has(s.done) for s in stories)},
        "stages": {name: makers[name]() for name in stages},
        "not_measurable": [{"metric": name, "play": play, "needs": needs} for name, play, needs in NOT_MEASURABLE],
    }


def stats_lines(report: Mapping[str, object]) -> list[str]:
    tasks = report["tasks"]
    lines = [f"since {report['since'] or 'the board began'} (times are commit times from each machine's clock)",
             f"tasks: {tasks['claimed']} claimed, {tasks['in_review']} in review now, {tasks['done']} done"]
    for stage in report["stages"].values():
        plays = f" (play {', '.join(stage['plays'])})" if stage["plays"] else ""
        lines += ["", f"{stage['title']}{plays}"]
        for found in stage["metrics"].values():
            named = f" [play {found['play']}: {found['playbook']}]" if found["playbook"] else ""
            lines.append(f"  {found['label']}: {found['text']}{named}")
    if len(report["stages"]) == len(STAGES):
        lines += ["", "Not measurable from the board"]
        lines += [f"  {m['metric']} (play {m['play']}): needs {m['needs']}" for m in report["not_measurable"]]
    return lines


# The shell: the board's history from git, cached by commit; the logs; gh.

def batch_objects(output: bytes) -> list[str | None]:
    """`git cat-file --batch` output as each object's text, None where git said it is missing."""
    found: list[str | None] = []
    position = 0
    while position < len(output):
        end = output.index(b"\n", position)
        header = output[position:end].split()
        if header[-1:] == [b"missing"] or len(header) < 3:
            found.append(None)
            position = end + 1
            continue
        start, size = end + 1, int(header[2])
        found.append(output[start:start + size].decode())
        position = start + size + 1
    return found


def cache_key() -> str:
    """The history cache's format: a version, and Task's fields, so a cache from another release is rebuilt."""
    return f"{STATS_CACHE_VERSION}:{','.join(f.name for f in dataclass_fields(Task))}"


def change_json(change: Change) -> list[object]:
    match change.item:
        case Item() as item:
            return [change.path, {"item": asdict(item)}]
        case DocItem() as doc:
            return [change.path, {"doc": asdict(doc)}]
        case _:
            return [change.path, None]


def _tuples(value: object) -> object:
    return tuple(_tuples(v) for v in value) if isinstance(value, list) else value


def change_from_json(raw: Sequence[object]) -> Change:
    path, record = str(raw[0]), raw[1]
    if isinstance(record, dict) and isinstance(found := record.get("item"), dict):
        task = Task(**{k: _tuples(v) for k, v in found["task"].items()})
        checks = tuple(Check(**{k: _tuples(v) for k, v in c.items()}) for c in found.get("checks", ()))
        return Change(path, Item(task, found.get("substance", ""), checks, bool(found.get("skip_noted"))))
    if isinstance(record, dict) and isinstance(found := record.get("doc"), dict):
        return Change(path, DocItem(**found))
    return Change(path, None)


def _stats_folder(board: Board) -> Path:
    return board.path / ".asdlc" / "stats"


def _read_json(path: Path) -> dict[str, object]:
    try:
        found = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    return found if isinstance(found, dict) else {}


def _write_cache(folder: Path, name: str, data: Mapping[str, object]) -> None:
    """A cache file in the board clone's .asdlc/stats/, which ignores itself; a cache that can't be written is only slower."""
    try:
        folder.mkdir(parents=True, exist_ok=True)
        if not (folder / ".gitignore").exists():
            (folder / ".gitignore").write_text("*\n")
        _write_atomically(folder / name, json.dumps(data))
    except OSError as error:
        _say(f"could not write the stats cache in {folder}, so the next run reads the history again: {error}")


def _board_history(board: Board, ref: str) -> list[Commit]:
    """Every commit on `ref` that touched the board's tasks, drafts, archive or documents, oldest first, each
    change parsed; parsed commits come from the cache in .asdlc/stats/history.json."""
    log = _board_git(board, "-c", "core.quotePath=false", "log", "--reverse", "--topo-order", "--no-renames", "--format=%x00%H %ct",
                     "--name-status", ref, "--", *HISTORY_PATHS).stdout
    listed: list[tuple[str, datetime, list[tuple[str, str]]]] = []
    for line in log.splitlines():
        if line.startswith("\x00"):
            sha, stamp = line[1:].split()
            listed.append((sha, datetime.fromtimestamp(int(stamp), UTC), []))
        elif "\t" in line and listed:
            status, _, path = line.partition("\t")
            if path.endswith(".md") and folder_of(path):
                listed[-1][2].append((status[:1], path))
    folder = _stats_folder(board)
    cache = _read_json(folder / "history.json")
    parsed = cache.get("commits") if cache.get("key") == cache_key() and isinstance(cache.get("commits"), dict) else {}
    wanted = [(sha, path) for sha, _, changes in listed if sha not in parsed for status, path in changes if status != "D"]
    texts: dict[tuple[str, str], str | None] = {}
    if wanted:
        batch = subprocess.run(["git", "cat-file", "--batch"], cwd=board.path, env=dict(board.env), capture_output=True,
                               input="".join(f"{sha}:{path}\n" for sha, path in wanted).encode())
        texts = dict(zip(wanted, batch_objects(batch.stdout)))
    for sha, _, changes in listed:
        if sha in parsed:
            continue
        found = []
        for status, path in changes:
            text = None if status == "D" else texts.get((sha, path))
            item = None if text is None else (doc_from(text) if folder_of(path) == "docs" else item_from(path, text))
            found.append(change_json(Change(path, item)))
        parsed[sha] = found
    if wanted:
        _write_cache(folder, "history.json", {"key": cache_key(), "commits": parsed})
    return [Commit(sha, when, tuple(change_from_json(c) for c in parsed.get(sha, ()))) for sha, when, _ in listed]


def _merged_times(board: Board, stories: Iterable[Story]) -> dict[str, datetime]:
    """When each Done task's pull request merged, from `gh pr view --json mergedAt`, cached once known."""
    folder = _stats_folder(board)
    cache = {url: when for url, when in _read_json(folder / "merged.json").items() if isinstance(when, str)}
    gh = os.environ.get("ASDLC_GH", shutil.which("gh") or "")  # an empty ASDLC_GH asks gh nothing
    found: dict[str, datetime] = {}
    asked = False
    for story in stories:
        if story.done is None or not (url := story.pull):
            continue
        if url not in cache and gh:
            asked = True
            try:
                done = subprocess.run([gh, "pr", "view", url, "--json", "mergedAt"], capture_output=True, text=True, timeout=20)
                merged = json.loads(done.stdout).get("mergedAt") if done.returncode == 0 else None
            except (OSError, ValueError, subprocess.TimeoutExpired, AttributeError):
                merged = None
            if isinstance(merged, str) and merged:
                cache[url] = merged
        if (when := _iso(cache.get(url, ""))) is not None:
            found[story.id] = when
    if asked:
        _write_cache(folder, "merged.json", cache)
    return found


def _hook_logs(board: Board) -> list[Path]:
    """The hook decision logs on this machine: the board clone's and each registered repository's."""
    folders = [board.path, *(entry.path for entry in _registry().values())]
    return [path for folder in dict.fromkeys(folders) if (path := folder / ".asdlc" / "hooks.jsonl").is_file()]


def stats(board: Board, since: datetime | None, stage: str | None, as_json: bool) -> int:
    """Read the board's history (fetched, never changed), this machine's logs and gh, and report by stage."""
    try:
        _fetch(board)
    except AsdlcError as error:
        _say(f"could not fetch the board, so this is as of the last fetch: {error}")
    ref = f"origin/{BOARD_BRANCH}" if _board_git(board, "rev-parse", "--verify", "--quiet", f"origin/{BOARD_BRANCH}", check=False).returncode == 0 else "HEAD"
    ledger = replay(_board_history(board, ref))
    lines = _board_git(board, "log", "--format=%ct%x00%s", ref).stdout.splitlines()
    subjects = [(datetime.fromtimestamp(int(stamp), UTC), subject) for line in lines for stamp, _, subject in [line.partition("\x00")] if stamp.isdigit()]
    log = _events_file()
    events = parse_events(log.read_text()) if log.is_file() else ()
    hook_logs = _hook_logs(board)
    decisions = [entry for path in hook_logs for entry in parse_events(path.read_text())]
    merged = _merged_times(board, ledger.stories.values())
    report = stats_report(ledger, subjects, events, decisions, merged, Window(since, datetime.now(UTC)), (stage,) if stage else tuple(STAGES))
    sources = {"board": str(board.path), "events": str(log), "hook_logs": [str(p) for p in hook_logs], "cache": str(_stats_folder(board))}
    _emit(report | sources, as_json, [*stats_lines(report), "", f"from the board's history, this machine's event log ({log}) and hook logs "
                                      f"({', '.join(sources['hook_logs']) or 'none yet'})"])
    return 0


def _since(raw: str | None) -> datetime | None:
    """Raises: AsdlcError: not an ISO 8601 date or time."""
    return None if raw is None else _when(raw)


SCAFFOLDING = Path(__file__).resolve().parent.parent / "templates" / "board"
MARKETPLACE_PLACEHOLDER = "{{marketplace}}"


def marketplace_name(folder: str) -> str:
    """The tasks repository's marketplace name: its folder's name, lowercase and hyphenated."""
    return re.sub(r"[^a-z0-9]+", "-", folder.lower()).strip("-") or "tasks"


def missing_scaffolding(templates: Mapping[str, str], existing: Iterable[str], marketplace: str) -> dict[str, str]:
    """The scaffolding files a board lacks, with their contents. Existing files are never in it."""
    present = frozenset(existing)
    return {path: text.replace(MARKETPLACE_PLACEHOLDER, marketplace) for path, text in sorted(templates.items()) if path not in present}


def _add_scaffolding(directory: Path) -> list[str]:
    """Copy the files of `templates/board/` that the board doesn't have yet; return their paths."""
    templates = {p.relative_to(SCAFFOLDING).as_posix(): p.read_text() for p in SCAFFOLDING.rglob("*") if p.is_file()}
    existing = [path for path in templates if (directory / path).exists()]
    added = missing_scaffolding(templates, existing, marketplace_name(directory.name))
    for path, text in added.items():
        (directory / path).parent.mkdir(parents=True, exist_ok=True)
        (directory / path).write_text(text)
    return list(added)


def _scaffold_files(directory: Path, config: Path) -> tuple[list[str], bool]:
    """Write this board's config and the scaffolding files it lacks, and `.asdlc/` into its .gitignore:
    the scaffolding files added, and whether an existing .gitignore was changed."""
    config.write_text(board_config(config.read_text(), directory.name))
    added = _add_scaffolding(directory)
    ignore = directory / ".gitignore"
    if ".gitignore" not in added and (updated := with_exclude(ignore.read_text() if ignore.exists() else "", ".asdlc/")) is not None:
        ignore.write_text(updated)  # the hooks' decision log, written wherever a session runs
        _say("added .asdlc/, the hooks' decision log, to .gitignore")
        return added, True
    return added, False


def init_local_board(directory: Path) -> None:
    """A local board in the repository at `directory`: `backlog init` and one commit of `backlog/` on the
    checked-out branch. No `asdlc.toml` (its absence is what makes the board local), no marketplace and no
    team plugin, which belong to a board other engineers share.

    Raises:
        AsdlcError: `directory` isn't the root of a git repository, or backlog init failed.
    """
    top = _git(directory, "rev-parse", "--show-toplevel")
    if top.returncode != 0 or Path(top.stdout.strip()).resolve() != directory.resolve():
        raise AsdlcError(f"{directory} is not the root of a git repository; a local board lives in the repository where the work is done")
    if (directory / "asdlc.toml").exists() and board_mode((directory / "asdlc.toml").read_text()):
        raise AsdlcError(f"{directory} has an asdlc.toml without mode = \"local\", so it is a shared board")
    board = open_board(directory)
    config = directory / "backlog" / "config.yml"
    if not config.exists():
        done = _board_backlog(board, ["init", directory.name, "--defaults", "--integration-mode", "none",
                                      "--check-branches", "false", "--include-remote", "false", "--bypass-git-hooks", "true"])
        if done.returncode != 0 or not config.exists():
            raise AsdlcError(f"backlog init failed in {directory}: {(done.stderr or done.stdout).strip()}")
    config.write_text(board_config(config.read_text(), directory.name))
    _board_git(board, "add", "--", "backlog")
    if _board_git(board, "diff", "--cached", "--quiet", "--", "backlog", check=False).returncode != 0:
        _board_git(board, "commit", "--quiet", "--no-verify", "-m", "Initialise the asdlc board", "--", "backlog")
    print(f"local board ready at {directory}; board changes are committed to the branch checked out here and never pushed by asdlc")


def init_board(directory: Path) -> None:
    """A board repository at `directory`: git, `backlog init`, this board's config, the
    marketplace and team plugin scaffolding, one commit. Run again on an existing board, it
    updates the config and adds only the scaffolding files that are missing.

    Raises:
        AsdlcError: git or backlog init failed.
    """
    directory.mkdir(parents=True, exist_ok=True)
    board = open_board(directory)
    top = _git(directory, "rev-parse", "--show-toplevel")
    if top.returncode != 0 or Path(top.stdout.strip()).resolve() != directory.resolve():
        _board_git(board, "init", "--quiet", "-b", BOARD_BRANCH)
    config = directory / "backlog" / "config.yml"
    if not config.exists():
        done = _board_backlog(board, ["init", directory.name, "--defaults", "--integration-mode", "none",
                                      "--check-branches", "false", "--include-remote", "false", "--bypass-git-hooks", "true"])
        if done.returncode != 0 or not config.exists():
            raise AsdlcError(f"backlog init failed in {directory}: {(done.stderr or done.stdout).strip()}")
    fresh = _board_git(board, "rev-parse", "--verify", "--quiet", "HEAD", check=False).returncode != 0
    shared = not fresh and _board_git(board, "remote", "get-url", "origin", check=False).returncode == 0
    if shared:
        # A board other clones share: the change goes through the board's own transaction, so it is
        # made on the current origin/main, committed with asdlc's trailer and pushed, never left local.
        paths = ["backlog", ".gitignore", *sorted(p.relative_to(SCAFFOLDING).as_posix() for p in SCAFFOLDING.rglob("*") if p.is_file())]

        def step(attempt: int) -> tuple[str | None, list[str]]:
            return "Update the asdlc board's config and add missing scaffolding", _scaffold_files(directory, config)[0]

        added = _transact(board, step, paths)
    else:
        added, appended = _scaffold_files(directory, config)
        changed = [*added, *([".gitignore"] if appended else [])]
        _board_git(board, "add", "--", "backlog", *changed)
        if _board_git(board, "diff", "--cached", "--quiet", "--", "backlog", *changed, check=False).returncode != 0:
            message = "Initialise the asdlc board" if fresh else "Update the asdlc board's config and add missing scaffolding"
            _board_git(board, "commit", "--quiet", "--no-verify", "-m", message, "--", "backlog", *changed)
    if added:
        _say(f"added {len(added)} scaffolding file(s), leaving existing ones as they were: {', '.join(added)}")
    if shared:
        print(f"board updated at {directory} and pushed to origin/{BOARD_BRANCH}")
        return
    print(f"board ready at {directory}. Add its remote and push it: git -C {directory} remote add origin <url> && git -C {directory} push -u origin {BOARD_BRANCH}")
    print("Each developer then installs the team plugin from it once, in Claude Code: /plugin install team --marketplace <owner>/<repo>")


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="asdlc", description="A Backlog.md board: claims, worktrees, routing and orchestration.")
    parser.add_argument("--board", help="the board clone (else $ASDLC_BOARD, else git config asdlc.board, else the board clone you are in)")
    parser.add_argument("--in", dest="folder", metavar="FOLDER", help=IN_HELP)
    after = argparse.ArgumentParser(add_help=False)  # --in is accepted after the subcommand too
    after.add_argument("--in", dest="folder", metavar="FOLDER", default=argparse.SUPPRESS, help=IN_HELP)
    commands = parser.add_subparsers(dest="command", required=True)
    initialising = commands.add_parser("init-board", help="create a board repository, or with --local a board in the repository where the work is done", parents=[after])
    initialising.add_argument("dir")
    initialising.add_argument("--local", action="store_true", help="a local board: committed to the branch checked out in this repository, never pushed by asdlc")

    def add(name: str, text: str, *, task: str | None = None, who: str | None = None, json_output: bool = False) -> argparse.ArgumentParser:
        sub = commands.add_parser(name, help=text, parents=[after])
        if task:
            sub.add_argument("id", help=task)
        if who:
            sub.add_argument("--as", dest="worker", required=True, help=who)
        if json_output:
            sub.add_argument("--json", action="store_true", help="print JSON instead of text")
        return sub

    worker = "the worker: your engineer name, a dot and a label, such as kyle.w1"
    add("claim", "claim a task and make its worktree", task="the task", who=worker, json_output=True)
    add("release", "put your claimed task back to To Do, or give up the review claim a reviewer holds", task="the task", who=worker)
    add("next", "claim the best task this worker may start", who=worker, json_output=True)
    add("route", "the model and effort for a task, as JSON", task="the task")
    commands.add_parser("board", help="run a backlog command on the board and push it")
    add("whoami", "who asdlc thinks you are, your board, preferences and registered repositories", json_output=True)
    add("register", "register the code repository you are in on this machine and on the board", json_output=True).add_argument(
        "--board", dest="register_board", help="the board clone to use for this repository (sets git config asdlc.board)")
    add("repos", "the code repositories registered on this machine", json_output=True)
    add("accept", "a person's command: accept an intent and its draft children", task="the intent", json_output=True)
    approving = commands.add_parser("approve", help="a person's command: approve the plans of tasks, size 2 and up, so their workers build them", parents=[after])
    approving.add_argument("ids", nargs="+", help="the tasks whose plans you approve")
    approving.add_argument("--plan-hash", action="append", default=[], help="the digest of each plan you were shown, in the order of the ids; "
                           "a plan changed since is refused")
    add("mine", "an engineer's workers' tasks and reservations", who="the engineer, such as kyle", json_output=True)
    commands.add_parser("record-check", help="run a check in the task's worktree and record it on the task: "
                        "record-check <id> --in <worktree> --as <worker> -- <command...>")
    finishing_work = add("finish", "hand your held task to review: In Review with its branch and pull request", task="the task", who=worker, json_output=True)
    finishing_work.add_argument("--branch", help="the task's branch (default: the one recorded when it was claimed)")
    finishing_work.add_argument("--pr", help="the pull request's URL, when there is one")
    finishing_work.add_argument("--notes", required=True, help="what was built, the checks recorded, and anything the reviewer should look at")
    reviewer = "the reviewer: your engineer name, a dot, r and a number, such as kyle.r1"
    reviewing = add("review-next", "claim the review that has waited longest among those this reviewer may take", who=reviewer, json_output=True)
    reviewing.add_argument("--fallback", action="store_true",
                           help="also take this engineer's own work once it has waited longer than review_fallback_after (a same-machine review)")
    reviewing.add_argument("--now", help="the time to judge the wait at, as ISO 8601 (for tests and demonstrations)")
    add("permissions", "the Claude Code allow rules normal work needs on this machine; --write adds them to the tasks clone's local settings (a person's command)",
        json_output=True).add_argument("--write", action="store_true", help="merge them into the tasks clone's .claude/settings.local.json, keeping what is there, after a backup")
    add("doctor", "check that this machine is ready: tools, identity, the board, settings, repositories, plugins and leftovers", json_output=True)
    measuring = add("stats", "the playbook's numbers by stage, from the board's history and this machine's logs", json_output=True)
    measuring.add_argument("--since", help="count from this date or time, as ISO 8601 (else from the board's start)")
    measuring.add_argument("--stage", choices=list(STAGES), help="only this stage's numbers")
    starting = add("intent-started", "record on an intent draft when the conversation that wrote it began", task="the intent's draft, such as DRAFT-3")
    starting.add_argument("--at", help="when the conversation began, as ISO 8601 (else now)")
    finishing = add("review-done", "record a review's findings and verdict on the task", task="the task", who=reviewer, json_output=True)
    finishing.add_argument("--verdict", required=True, choices=[str(v) for v in ReviewVerdict], help="clean, or changes to send it back to its author")
    finishing.add_argument("--findings", required=True, help="how many findings of each severity, important=<n>,nit=<n> (0 for none)")
    finishing.add_argument("--policy", action="append", default=[], help="a policy or rule a finding cites, once per policy (repeat it)")
    finishing.add_argument("--plan-matched", required=True, choices=["yes", "no"], help="whether the diff still matches the task's plan")
    finishing.add_argument("--notes", required=True, help="the findings, as they go on the task")
    return parser


@dataclass(frozen=True)
class CheckRequest:
    """What `record-check` was asked: the task, the worker, the check, and the worktree named with --in (or None)."""

    task: str
    worker: str
    command: tuple[str, ...]
    folder: str | None = None


def record_check_arguments(words: Sequence[str]) -> CheckRequest | None:
    """`<id> --as <worker> [--in <worktree>] -- <command...>`, in any order before the `--`; None when malformed."""
    if "--" not in words:
        return None
    split = list(words).index("--")
    head, command = list(words[:split]), tuple(words[split + 1:])
    options: dict[str, str] = {}
    rest: list[str] = []
    index = 0
    while index < len(head):
        word = head[index]
        if word in ("--as", "--in"):
            if index + 1 >= len(head):
                return None
            options[word], index = head[index + 1], index + 2
            continue
        if word.startswith(("--as=", "--in=")):
            options[word[:4]] = word.partition("=")[2]
        else:
            rest.append(word)
        index += 1
    if "--as" not in options or len(rest) != 1 or not command:
        return None
    return CheckRequest(rest[0], options["--as"], command, options.get("--in"))


def command_index(argv: Sequence[str]) -> int | None:
    """Where the subcommand is, skipping `--board <path>` and `--in <folder>`."""
    index = 0
    while index < len(argv):
        if argv[index] in ("--board", "--in"):
            index += 2
        elif argv[index].startswith("-"):
            index += 1
        else:
            return index
    return None


IN_HELP = ("run as if from this folder (a task's worktree, a code repository or the tasks clone), "
           "so no agent has to cd; record-check takes it after the task id too")


def working_folder(folder: str | None, cwd: Path) -> Path:
    """The folder a command runs as if from: --in when given, else the current directory.

    Raises:
        AsdlcError: --in names something that isn't a folder.
    """
    if folder is None:
        return cwd
    path = Path(folder).expanduser()
    path = path if path.is_absolute() else cwd / path
    if not path.is_dir():
        raise AsdlcError(f"--in {folder}: {path} is not a folder; give the task's worktree (asdlc claim printed it) or a repository")
    return path.resolve()


def _route_command(board: Board, raw_id: str) -> None:
    """Raises: AsdlcError: no such task, or it can't start."""
    tasks = _tasks(board)
    task_id = normalise_id(raw_id, _prefix(board))
    task = _find(tasks, task_id)
    if task is None:
        raise AsdlcError(f"{task_id} is not a task on the board")
    match route(task, tasks):
        case Route() as chosen:
            print(route_json(task_id, chosen))
        case Refusal(reason=reason):
            raise AsdlcError(reason)


def _when(raw: str | None) -> datetime:
    """Raises: AsdlcError: not an ISO 8601 time."""
    if raw is None:
        return datetime.now(UTC)
    try:
        found = datetime.fromisoformat(raw)
    except ValueError:
        raise AsdlcError(f"'{raw}' is not an ISO 8601 time, such as 2026-10-22T15:00:00+00:00") from None
    return found if found.tzinfo else found.replace(tzinfo=UTC)


def _stopped(signum: int, frame: object) -> None:
    """SIGTERM or SIGHUP: unwind like Ctrl-C, so a change in progress drops its unpushed commit."""
    raise SystemExit(128 + signum)


def main(argv: Sequence[str]) -> int:
    for stopping in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(stopping, _stopped)
    parser = _parser()
    split = command_index(argv)
    if split is not None and argv[split] == "board":  # the rest belongs to backlog, flags included
        arguments, passthrough = parser.parse_args([*argv[:split], "board"]), list(argv[split + 1:])
    elif split is not None and argv[split] == "record-check":  # record-check <id> -- <command...>
        arguments, passthrough = parser.parse_args([*argv[:split], "record-check"]), list(argv[split + 1:])
    else:
        arguments, passthrough = parser.parse_args(argv), []
    as_json = getattr(arguments, "json", False)
    request = record_check_arguments(passthrough) if arguments.command == "record-check" else None
    try:
        cwd = working_folder(request.folder if request and request.folder else arguments.folder, Path.cwd())
        match arguments.command:
            case "init-board":
                _check_backlog()
                (init_local_board if arguments.local else init_board)(Path(arguments.dir).expanduser().resolve())
                return 0
            case "repos":
                return repos(as_json)
            case "whoami":
                return whoami(arguments.board, cwd, as_json)
            case "register":
                _check_backlog()
                return register(arguments.register_board or arguments.board, cwd, as_json)
            case "doctor":
                return doctor(arguments.board, cwd, as_json)
            case "permissions":
                return permissions(arguments.board, cwd, arguments.write, as_json, datetime.now())
        board = open_board(resolve_board(arguments.board, cwd))
        match arguments.command:
            case "route":
                _route_command(board, arguments.id)
            case "board":
                _check_backlog()
                if not passthrough:
                    raise AsdlcError("say which backlog command to run, such as: asdlc board task list --plain")
                done = board_command(board, passthrough)
                print(done.stdout, end="")
                print(done.stderr, end="", file=sys.stderr)
                return done.returncode
            case "claim" | "next" | "release":
                _check_backlog()
                worker = worker_for(arguments.worker, _engineer(cwd))
                match arguments.command:
                    case "claim":
                        return claim(board, arguments.id, worker, cwd, as_json)
                    case "next":
                        return next_task(board, worker, owner_of(worker), cwd, as_json)
                    case "release":
                        release(board, arguments.id, worker, cwd)
            case "stats":
                return stats(board, _since(arguments.since), arguments.stage, as_json)
            case "intent-started":
                _check_backlog()
                print(intent_started(board, arguments.id, _when(arguments.at), datetime.now(UTC)))
            case "accept":
                _check_backlog()
                result = accept(board, arguments.id, _engineer(cwd))
                lines = [str(result["note"]), *(f"  {old} -> {new}" for old, new in result["accepted"].items())]
                _emit(result, as_json, lines)
            case "mine":
                return mine(board, engineer_name(arguments.worker), as_json)
            case "approve":
                _check_backlog()
                engineer, failed = _engineer(cwd), 0
                if arguments.plan_hash and len(arguments.plan_hash) != len(arguments.ids):
                    raise AsdlcError(f"give one --plan-hash per task, in the same order: {len(arguments.ids)} task(s), {len(arguments.plan_hash)} hash(es)")
                for raw_id, shown in zip(arguments.ids, arguments.plan_hash or [None] * len(arguments.ids)):
                    try:
                        print(approve(board, raw_id, engineer, shown))
                    except AsdlcError as error:
                        failed += 1
                        _say(str(error))
                return 1 if failed else 0
            case "review-next":
                _check_backlog()
                reviewer = reviewer_for(arguments.worker, _engineer(cwd))
                return review_next(board, reviewer, owner_of(reviewer), _when(arguments.now), arguments.fallback, as_json)
            case "review-done":
                _check_backlog()
                reviewer = reviewer_for(arguments.worker, _engineer(cwd))
                important, nit = parse_findings(arguments.findings)
                policies = tuple(dict.fromkeys(p.strip() for p in arguments.policy if p.strip()))
                record = ReviewRecord(important, nit, policies, arguments.plan_matched == "yes")
                result = review_done(board, arguments.id, reviewer, ReviewVerdict(arguments.verdict), arguments.notes, record)
                line = (f"{result['task']}: changes requested by @{reviewer}; it is In Progress for @{', @'.join(result['workers']) or 'its author'} again"
                        if result["verdict"] == ReviewVerdict.CHANGES else
                        f"{result['task']} passed review by @{reviewer} ({result['kind']}); it stays In Review for a person to merge")
                lines = [line]
                if repeats := result["repeats"]:
                    cited = "; ".join(f"{policy} ({', '.join(ids)})" for policy, ids in repeats.items())
                    lines.append(f"Earlier reviews cited the same policy: {cited}. Read them: where a finding repeats the same mistake, "
                                 "file a rule-change draft so the correction reaches the rules (the reviewer agent says how).")
                _emit(result, as_json, lines)
            case "record-check":
                if request is None:
                    raise AsdlcError("say which task, which worktree, which worker and which check: "
                                     "asdlc record-check TASK-1 --in <worktree> --as kyle.w1 -- ./scripts/check")
                _check_backlog()
                return record_check(board, request.task, worker_for(request.worker, _engineer(cwd)), request.command, cwd)
            case "finish":
                _check_backlog()
                worker = worker_for(arguments.worker, _engineer(cwd))
                result = finish(board, arguments.id, worker, arguments.branch, arguments.pr, arguments.notes)
                again = " again, without changes-requested" if result["resubmitted"] else ""
                _emit(result, as_json, [f"{result['task']} is In Review{again}: branch {result['branch']}, pull request {result['pull_request'] or '-'}"])
        return 0
    except AsdlcError as error:
        print(f"asdlc: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
